---
interface Props {id:string; label:string;}
const {id,label}=Astro.props;
---
<div class="yaml-editor" data-yaml-editor>
  <pre class="yaml-gutter" data-yaml-gutter aria-hidden="true">1</pre>
  <textarea id={id} data-share-key={id} aria-label={label} class="yaml-input" autocomplete="off" autocapitalize="off" spellcheck="false" wrap="off" placeholder="Paste YAML here…"></textarea>
</div>
<style>
  .yaml-editor {display:grid; grid-template-columns:3rem minmax(0,1fr); height:clamp(9rem,25vh,14rem); overflow:hidden; border:1px solid #cbd5e1; border-radius:.5rem; background:white; font:.82rem/1.6 ui-monospace,monospace;}
  .yaml-editor:focus-within {border-color:#6366f1; outline:2px solid #6366f133;}
  .yaml-gutter {min-height:0; margin:0; overflow:hidden; padding:.75rem .5rem; background:#f8fafc; color:#94a3b8; text-align:right; border-right:1px solid #e2e8f0; user-select:none;}
  .yaml-input {display:block; width:100%; min-width:0; height:100%; resize:none; border:0; outline:0; padding:.75rem; font:inherit; line-height:inherit; background:transparent; color:#0f172a; tab-size:2; overflow:auto; overscroll-behavior:contain;}
  .yaml-input::placeholder {color:#94a3b8;}
  @media(max-width:767px) {.yaml-editor{height:9rem;}}
  :global(.dark) .yaml-editor {border-color:#475569; background:#0f172a;}
  :global(.dark) .yaml-gutter {background:#1e293b; color:#64748b; border-color:#334155;}
  :global(.dark) .yaml-input {color:#e2e8f0;}
</style>

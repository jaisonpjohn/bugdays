---
// Dismissible notice banner for expired/error share links
---

<div id="share-expired-notice" class="hidden bg-amber-50 dark:bg-amber-900/30 border-l-4 border-amber-500 p-4 mb-4">
  <div class="flex items-start justify-between">
    <p class="text-amber-800 dark:text-amber-200 text-sm">
      <span class="font-medium">Shared link expired:</span> The data you're looking for has expired or no longer exists. Shared links are available for 30 days.
    </p>
    <button id="dismiss-share-notice" class="ml-4 text-amber-600 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-200 flex-shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  function initShareNotice() {
    const notice = document.getElementById('share-expired-notice');
    const dismissBtn = document.getElementById('dismiss-share-notice');

    dismissBtn?.addEventListener('click', () => {
      notice?.classList.add('hidden');
    });
  }

  // Run on load
  initShareNotice();

  // Re-run after Astro page transitions
  document.addEventListener('astro:after-swap', initShareNotice);
</script>

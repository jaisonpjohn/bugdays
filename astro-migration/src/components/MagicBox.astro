---
// "Paste Anything" — the magic box. Detects what was pasted and deep-links
// into the right tool with the data preloaded. 100% client-side.
---

<div class="max-w-2xl mx-auto text-left">
  <div class="relative">
    <textarea
      id="magic-input"
      rows="3"
      spellcheck="false"
      autocomplete="off"
      placeholder="Paste anything — a JWT, base64, JSON, epoch timestamp, URL-encoded blob, CREATE TABLE dump… I'll figure out what it is."
      class="w-full p-4 pr-20 font-mono text-sm bg-white dark:bg-slate-800 text-gray-900 dark:text-slate-100
             border-2 border-indigo-300 dark:border-indigo-700 rounded-xl shadow-md
             focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent
             placeholder:text-slate-400 dark:placeholder:text-slate-500 placeholder:font-sans resize-y"
    ></textarea>
    <button
      id="magic-clear"
      class="hidden absolute top-3 right-3 px-2 py-1 text-xs rounded-md bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors"
    >Clear</button>
  </div>
  <p class="mt-1.5 text-[11px] text-slate-400 dark:text-slate-500 text-center">
    Detection runs in your browser — nothing you paste is uploaded.
  </p>

  <div id="magic-results" class="hidden mt-3 space-y-2"></div>
</div>

<script>
  import { detect, type Detection, type ToolAction } from '../lib/detect';
  import LZString from 'lz-string';

  const input = document.getElementById('magic-input') as HTMLTextAreaElement;
  const results = document.getElementById('magic-results')!;
  const clearBtn = document.getElementById('magic-clear')!;

  function toolUrl(a: ToolAction): string {
    const state = { v: 1, t: a.toolId, d: a.data, ...(a.action ? { a: a.action } : {}) };
    return `${a.href}#lz:${LZString.compressToEncodedURIComponent(JSON.stringify(state))}`;
  }

  function confidenceBadge(c: number): { label: string; cls: string } {
    if (c >= 85) return { label: 'confident', cls: 'bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300' };
    if (c >= 55) return { label: 'likely', cls: 'bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300' };
    return { label: 'maybe', cls: 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-300' };
  }

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

  function renderResults(list: Detection[]) {
    results.innerHTML = '';
    results.classList.toggle('hidden', !list.length);
    for (const d of list.slice(0, 4)) {
      const badge = confidenceBadge(d.confidence);
      const card = document.createElement('div');
      card.className = 'bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm p-3 text-left';
      card.innerHTML = `
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-semibold text-sm text-slate-800 dark:text-slate-100">${esc(d.title)}</span>
          <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full ${badge.cls}">${badge.label}</span>
          ${d.chain ? `<span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono">${esc(d.chain.join(' → '))}</span>` : ''}
        </div>
        ${d.note ? `<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">${esc(d.note)}</p>` : ''}
        ${d.preview ? `<pre class="mt-2 p-2 text-[11px] font-mono bg-slate-50 dark:bg-slate-900 rounded max-h-32 overflow-auto text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-all">${esc(d.preview)}</pre>` : ''}
      `;
      if (d.primary || d.secondary) {
        const row = document.createElement('div');
        row.className = 'mt-2 flex flex-wrap gap-2';
        for (const [action, style] of [
          [d.primary, 'bg-indigo-600 hover:bg-indigo-700 text-white'],
          [d.secondary, 'border border-indigo-300 dark:border-indigo-600 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-slate-700'],
        ] as const) {
          if (!action) continue;
          const a = document.createElement('a');
          a.href = toolUrl(action);
          a.className = `px-3 py-1.5 rounded-lg text-xs font-medium transition-colors ${style}`;
          a.textContent = action.label + ' →';
          row.appendChild(a);
        }
        card.appendChild(row);
      }
      results.appendChild(card);
    }
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  let runId = 0;

  async function run() {
    const value = input.value;
    clearBtn.classList.toggle('hidden', !value);
    if (!value.trim()) { renderResults([]); return; }
    const id = ++runId;
    const list = await detect(value);
    if (id !== runId) return; // superseded by newer input
    renderResults(list);
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(run, 250);
  });
  input.addEventListener('paste', () => {
    clearTimeout(timer);
    timer = setTimeout(run, 50); // near-instant on paste
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    renderResults([]);
    clearBtn.classList.add('hidden');
    input.focus();
  });
</script>

---
import Layout from './Layout.astro';
import type { Guide } from '../lib/guides';

interface Props {
  guide: Guide;
  keywords: string;
}

const { guide, keywords } = Astro.props;
const guideUrl = `https://bugdays.com/guides/${guide.slug}/`;
const imageUrl = `https://bugdays.com${guide.image}`;
const publishedDateTime = `${guide.published}T09:00:00-07:00`;
const modifiedDateTime = `${guide.updated}T09:00:00-07:00`;
const formatDate = (value: string) => new Intl.DateTimeFormat('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  image: [imageUrl],
  datePublished: publishedDateTime,
  dateModified: modifiedDateTime,
  mainEntityOfPage: guideUrl,
  author: {
    '@type': 'Organization',
    '@id': 'https://bugdays.com/#organization',
    name: 'Bug Days',
    url: 'https://bugdays.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://bugdays.com/#organization',
    name: 'Bug Days',
    url: 'https://bugdays.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://bugdays.com/og-image.png',
    },
  },
  about: guide.topic,
  genre: 'Technical guide',
  isAccessibleForFree: true,
}];
---

<Layout
  title={guide.title}
  description={guide.description}
  keywords={keywords}
  breadcrumb={[{ name: 'Developer Guides', href: '/guides' }, { name: guide.shortTitle }]}
  jsonLd={jsonLd}
  image={guide.image}
  imageAlt={guide.imageAlt}
  imageWidth={1280}
  imageHeight={720}
  ogType="article"
  articlePublished={publishedDateTime}
  articleModified={modifiedDateTime}
>
  <article class="guide-article max-w-4xl mx-auto">
    <header class="mb-7">
      <a href="/guides" class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Developer guide</a>
      <h1 class="mt-3 text-3xl md:text-5xl leading-tight font-bold tracking-tight text-slate-950 dark:text-white">{guide.title}</h1>
      <p class="mt-4 text-lg md:text-xl leading-8 text-slate-600 dark:text-slate-300">{guide.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
        <a href="/about" rel="author" class="font-semibold text-slate-700 dark:text-slate-200 hover:text-indigo-600 dark:hover:text-indigo-400">Bug Days</a>
        <span aria-hidden="true">·</span>
        <time datetime={guide.published}>{formatDate(guide.published)}</time>
        <span aria-hidden="true">·</span>
        <span>{guide.readingMinutes} minute read</span>
        <span aria-hidden="true">·</span>
        <span>{guide.topic}</span>
      </div>
    </header>

    <figure class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
      <img src={guide.image} alt={guide.imageAlt} width="1280" height="720" fetchpriority="high" class="w-full aspect-video object-cover" />
    </figure>

    <div class="guide-body mt-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 md:p-9">
      <slot />
    </div>

    <aside class="mt-7 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:flex md:items-center md:justify-between md:gap-6">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Try the workflow</p>
        <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">Use the {guide.toolName}</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Open the tool with sample data, or bring your own input. No account required.</p>
      </div>
      <a href={guide.toolHref} class="mt-4 md:mt-0 inline-flex shrink-0 items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-700 transition-colors">Open the tool →</a>
    </aside>

    {Astro.slots.has('related') && (
      <section class="mt-8">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Continue reading</h2>
        <div class="mt-3 grid md:grid-cols-2 gap-4"><slot name="related" /></div>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  .guide-body > :first-child { margin-top: 0; }
  .guide-body h2 { margin-top: 2.25rem; color: #0f172a; font-size: 1.55rem; line-height: 1.3; font-weight: 750; }
  .guide-body h3 { margin-top: 1.6rem; color: #1e293b; font-size: 1.12rem; line-height: 1.4; font-weight: 700; }
  .guide-body p { margin-top: 1rem; color: #475569; line-height: 1.8; }
  .guide-body ul, .guide-body ol { margin-top: 1rem; padding-left: 1.5rem; color: #475569; line-height: 1.75; }
  .guide-body ul { list-style: disc; }
  .guide-body ol { list-style: decimal; }
  .guide-body li + li { margin-top: .45rem; }
  .guide-body a { color: #4f46e5; text-decoration: underline; text-underline-offset: 2px; }
  .guide-body strong { color: #1e293b; font-weight: 700; }
  .guide-body code { border-radius: .3rem; background: #f1f5f9; padding: .12rem .3rem; color: #334155; font-size: .88em; }
  .guide-body pre { margin-top: 1rem; overflow-x: auto; border-radius: .65rem; background: #020617; padding: 1rem; color: #e2e8f0; font-size: .82rem; line-height: 1.65; }
  .guide-body pre code { background: transparent; padding: 0; color: inherit; font-size: inherit; }
  .guide-body blockquote { margin-top: 1.25rem; border-left: 4px solid #6366f1; border-radius: 0 .5rem .5rem 0; background: #eef2ff; padding: 1rem 1.25rem; color: #334155; }
  .guide-body table { margin-top: 1rem; width: 100%; border-collapse: collapse; font-size: .9rem; }
  .guide-body th, .guide-body td { border: 1px solid #cbd5e1; padding: .65rem .75rem; text-align: left; vertical-align: top; }
  .guide-body th { background: #f1f5f9; color: #1e293b; font-weight: 700; }
  .guide-body .guide-note { margin-top: 1.4rem; border-radius: .65rem; border: 1px solid #bfdbfe; background: #eff6ff; padding: 1rem 1.2rem; }
  .guide-body .guide-note p { margin-top: 0; color: #1e3a8a; }
  .dark .guide-body h2, .dark .guide-body h3, .dark .guide-body strong { color: #f1f5f9; }
  .dark .guide-body p, .dark .guide-body ul, .dark .guide-body ol { color: #cbd5e1; }
  .dark .guide-body a { color: #a5b4fc; }
  .dark .guide-body code { background: #0f172a; color: #e2e8f0; }
  .dark .guide-body blockquote { background: rgba(49, 46, 129, .28); color: #e2e8f0; }
  .dark .guide-body th, .dark .guide-body td { border-color: #475569; }
  .dark .guide-body th { background: #0f172a; color: #f1f5f9; }
  .dark .guide-body .guide-note { border-color: #1e40af; background: rgba(30, 58, 138, .22); }
  .dark .guide-body .guide-note p { color: #bfdbfe; }
  @media (max-width: 640px) {
    .guide-body { overflow-wrap: anywhere; }
    .guide-body table { min-width: 34rem; }
    .guide-body .table-scroll { overflow-x: auto; }
  }
</style>

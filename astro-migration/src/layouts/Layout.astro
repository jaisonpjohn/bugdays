---
import '../styles/global.css'
import Sidebar from '../components/Sidebar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ShareButton from '../components/ShareButton.astro';
import ShareNotice from '../components/ShareNotice.astro';
import CommandPalette from '../components/CommandPalette.astro';
import CookieNotice from '../components/CookieNotice.astro';
import Feedback from '../components/Feedback.astro';

interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  breadcrumb?: BreadcrumbItem[];
  toolId?: string;
  jsonLd?: object[];
}

const {
  title,
  description = "Free online developer tools - JSON formatter, Base64 encoder, URL encoder, and more. All tools run in your browser, no data sent to servers.",
  keywords = "developer tools, online tools, JSON formatter, Base64 encoder, URL encoder",
  breadcrumb = [],
  toolId,
  jsonLd = []
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site || 'https://bugdays.com');
const siteName = "Bug Days";
const fullTitle = `${title} | ${siteName} - Free Online Developer Tools`;

// Generate BreadcrumbList schema
const breadcrumbSchema = breadcrumb.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bugdays.com"
    },
    ...breadcrumb.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 2,
      "name": item.name,
      ...(item.href ? { "item": `https://bugdays.com${item.href}` } : {})
    }))
  ]
} : null;

// Combine all JSON-LD schemas
const allJsonLd = breadcrumbSchema ? [breadcrumbSchema, ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Bug Days" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content="https://bugdays.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bug Days - Safe Developer Tools" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://bugdays.com/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />

    <!-- Preconnect for performance -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TTSCZHJZD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5TTSCZHJZD');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6990853945034806" crossorigin="anonymous"></script>

    <!-- Prevent FOUC (Flash of Unstyled Content) for dark mode -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) document.documentElement.classList.add('dark');
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    {allJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 overflow-x-hidden transition-colors" data-tool-id={toolId || ''}>
    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-slate-900/60 dark:bg-black/60 z-30 hidden md:hidden transition-opacity duration-200 backdrop-blur-sm"></div>

    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed top-0 left-0 z-40 h-screen w-56 shrink-0
             -translate-x-full md:translate-x-0 transition-transform duration-200
             bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800
             overflow-y-auto overflow-x-hidden flex flex-col"
    >
      <!-- Logo area -->
      <div class="p-3 border-b border-slate-200 dark:border-slate-800">
        <a href="/" class="flex items-center gap-2.5 group">
          <!-- Bug Logo SVG with hover animation -->
          <div class="w-9 h-9 relative flex-shrink-0 bug-logo">
            <svg viewBox="0 0 40 40" class="w-full h-full overflow-visible" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Bug body/abdomen (visible when shells open) -->
              <ellipse cx="20" cy="23" rx="7" ry="11" class="fill-slate-700 dark:fill-slate-600"/>
              <!-- Body segments -->
              <ellipse cx="20" cy="28" rx="5" ry="6" class="fill-slate-600 dark:fill-slate-500"/>
              <ellipse cx="20" cy="32" rx="3" ry="3" class="fill-slate-600 dark:fill-slate-500"/>

              <!-- Left shell half - more curved bottom -->
              <g class="bug-shell-left">
                <path d="M20 12 C8 13, 6 20, 6 24 C6 30, 10 35, 20 35 Z" class="fill-indigo-500"/>
                <circle cx="14" cy="19" r="2.5" class="fill-slate-800 dark:fill-slate-900"/>
                <circle cx="12" cy="27" r="2" class="fill-slate-800 dark:fill-slate-900"/>
              </g>

              <!-- Right shell half - more curved bottom -->
              <g class="bug-shell-right">
                <path d="M20 12 C32 13, 34 20, 34 24 C34 30, 30 35, 20 35 Z" class="fill-indigo-500"/>
                <circle cx="26" cy="19" r="2.5" class="fill-slate-800 dark:fill-slate-900"/>
                <circle cx="28" cy="27" r="2" class="fill-slate-800 dark:fill-slate-900"/>
              </g>

              <!-- Center line on shell -->
              <line x1="20" y1="12" x2="20" y2="35" stroke="#1e293b" stroke-width="1.5" class="bug-center-line"/>

              <!-- Tiny legs -->
              <path d="M8 20 Q5 21, 4 24" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <path d="M8 26 Q5 27, 3 29" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <path d="M32 20 Q35 21, 36 24" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <path d="M32 26 Q35 27, 37 29" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>

              <!-- Bug head -->
              <circle cx="20" cy="10" r="6" class="fill-slate-800 dark:fill-slate-900"/>
              <!-- Antennae -->
              <path class="bug-antenna-left" d="M16 6 Q14 2, 11 3" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <path class="bug-antenna-right" d="M24 6 Q26 2, 29 3" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <circle class="bug-antenna-left" cx="11" cy="3" r="1.5" class="fill-slate-700"/>
              <circle class="bug-antenna-right" cx="29" cy="3" r="1.5" class="fill-slate-700"/>
              <!-- Cool sunglasses -->
              <rect x="13" y="8" width="5" height="3.5" rx="0.8" class="fill-violet-400"/>
              <rect x="22" y="8" width="5" height="3.5" rx="0.8" class="fill-violet-400"/>
              <rect x="18" y="9" width="4" height="1" class="fill-violet-400"/>
              <!-- Lens shine -->
              <rect x="14" y="8.5" width="1.5" height="1" rx="0.3" class="fill-violet-200"/>
              <rect x="23" y="8.5" width="1.5" height="1" rx="0.3" class="fill-violet-200"/>
              <!-- Little smile -->
              <path d="M18 13 Q20 14.5, 22 13" stroke="#475569" stroke-width="1" stroke-linecap="round" fill="none"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold text-slate-800 dark:text-white tracking-wide group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              Bug Days
            </span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 tracking-wider uppercase">Dev Tools</span>
          </div>
        </a>
      </div>

      <!-- Navigation -->
      <div class="flex-1 overflow-y-auto">
        <Sidebar currentPath={currentPath} />
      </div>

    </aside>

    <!-- Main area -->
    <div class="md:ml-56 min-h-screen flex flex-col">
      <!-- Top header bar -->
      <header class="sticky top-0 z-30 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex h-12 items-center px-3 md:px-4 justify-between">
          <!-- Left side: hamburger (mobile) + logo (mobile only) -->
          <div class="flex items-center">
            <button
              id="menu-toggle"
              class="p-1.5 -ml-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors md:hidden"
              aria-label="Toggle navigation menu"
            >
              <svg class="w-5 h-5 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <a href="/" class="flex items-center gap-2 ml-2 md:hidden">
              <!-- Small logo for mobile -->
              <svg viewBox="0 0 40 40" class="w-7 h-7" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="20" cy="23" rx="14" ry="12" class="fill-indigo-500"/>
                <line x1="20" y1="12" x2="20" y2="35" stroke="#1e293b" stroke-width="1.5"/>
                <circle cx="14" cy="19" r="2.5" class="fill-slate-800"/>
                <circle cx="26" cy="19" r="2.5" class="fill-slate-800"/>
                <circle cx="13" cy="27" r="2" class="fill-slate-800"/>
                <circle cx="27" cy="27" r="2" class="fill-slate-800"/>
                <circle cx="20" cy="25" r="2" class="fill-slate-800"/>
                <circle cx="20" cy="10" r="6" class="fill-slate-800"/>
                <path d="M16 6 Q14 2, 11 3" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                <path d="M24 6 Q26 2, 29 3" stroke="#1e293b" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                <circle cx="11" cy="3" r="1.5" class="fill-slate-700"/>
                <circle cx="29" cy="3" r="1.5" class="fill-slate-700"/>
                <rect x="13" y="8" width="5" height="3.5" rx="0.8" class="fill-violet-400"/>
                <rect x="22" y="8" width="5" height="3.5" rx="0.8" class="fill-violet-400"/>
                <rect x="18" y="9" width="4" height="1" class="fill-violet-400"/>
              </svg>
              <span class="font-bold tracking-wide text-slate-800 dark:text-white">Bug Days</span>
            </a>
            <!-- Search / command palette (Cmd+K) -->
            <div class="ml-2 md:ml-0">
              <CommandPalette />
            </div>
          </div>

          <!-- Right side: share + GitHub + theme toggle -->
          <div class="flex items-center gap-2">
            {toolId && <ShareButton />}
            <a
              href="https://github.com/jaisonpjohn/bugdays"
              target="_blank"
              rel="noopener"
              class="p-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Bug Days on GitHub — the source code is open"
              title="Open source on GitHub"
            >
              <svg class="w-5 h-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
            </a>
            <ThemeToggle />
          </div>
        </div>
      </header>

      <!-- Main content -->
      <main class="flex-1 p-3 md:p-4 lg:p-6 overflow-x-hidden">
        <div class="max-w-7xl mx-auto">
          <Breadcrumb items={breadcrumb} />
          {toolId && <ShareNotice />}
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <footer class="py-6 px-6 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400 mb-3">
            <a href="/privacy" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Privacy</a>
            <a href="/terms" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Terms</a>
            <a href="/disclaimer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Disclaimer</a>
            <a href="/contact" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Contact</a>
            <a href="https://github.com/jaisonpjohn/bugdays" target="_blank" rel="noopener" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">GitHub</a>
          </div>
          <p class="text-center text-xs text-slate-400 dark:text-slate-500">
            © 2024-2026 Bug Days. All tools run in your browser —
            <a href="https://github.com/jaisonpjohn/bugdays" target="_blank" rel="noopener" class="underline decoration-dotted hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">and the code is open source</a>.
          </p>
        </div>
      </footer>
    </div>

    <script>
      function initSidebar() {
        const menuToggle = document.getElementById('menu-toggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (!menuToggle || !sidebar || !overlay) return;

        let isOpen = false;

        function openSidebar() {
          isOpen = true;
          sidebar.classList.remove('-translate-x-full');
          overlay.classList.remove('hidden');
        }

        function closeSidebar() {
          isOpen = false;
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
        }

        function toggleSidebar() {
          isOpen ? closeSidebar() : openSidebar();
        }

        menuToggle.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', closeSidebar);

        function handleResize() {
          if (window.innerWidth >= 768) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.add('hidden');
            isOpen = false;
          } else if (!isOpen) {
            sidebar.classList.add('-translate-x-full');
          }
        }

        window.addEventListener('resize', handleResize);
        handleResize();

        sidebar.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.tagName === 'A' && window.innerWidth < 768) {
            closeSidebar();
          }
        });
      }

      initSidebar();
      document.addEventListener('astro:after-swap', initSidebar);
    </script>

    <!-- Share functionality initialization -->
    <script>
      import { ShareManager } from '../lib/share';

      function initShare() {
        const toolId = document.body.dataset.toolId;
        if (toolId) {
          ShareManager.init(toolId);
          // Load from URL after a short delay to ensure tool scripts have registered
          setTimeout(() => {
            ShareManager.loadFromUrl();
          }, 100);
        }
      }

      initShare();
      document.addEventListener('astro:after-swap', initShare);
    </script>

    <!-- Feedback Button & Modal -->
    <Feedback toolId={toolId} />

    <!-- Cookie Notice -->
    <CookieNotice />
  </body>
</html>

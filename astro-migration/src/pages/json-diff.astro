---
import Layout from '../layouts/Layout.astro';
import JsonEditor from '../components/JsonEditor.astro';
import JsonToolContent from '../components/JsonToolContent.astro';
import { diffFaqs } from '../lib/json-examples.ts';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "JSON Diff - Compare JSON Online",
    "description": "Compare JSON files with exact numbers, match arrays by ID, ignore fields, inspect changed paths, export JSON Patch or a report, and share a reproducible comparison.",
    "url": "https://bugdays.com/json-diff/",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": ["Exact numeric comparison", "Match JSON arrays by ID", "Ignore fields and JSON Pointers", "Ignore key or array order", "Color-coded diff", "Change navigation", "RFC 6902 JSON Patch export", "Shareable comparison", "Cancellable local processing"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": diffFaqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } }))
  }
];
---

<Layout
  title="JSON Diff — Compare Files, Match Arrays by ID & Share"
  description="Compare JSON files online with exact numbers. Match arrays by ID, ignore fields or array order, inspect changed paths, export JSON Patch, and share the comparison."
  keywords="JSON diff, JSON compare, compare JSON files online, JSON diff ignore fields, compare JSON arrays by id, ignore array order, JSON Patch generator, semantic JSON diff, API response compare"
  image="/og/json-diff.png" imageAlt="JSON records matched by ID with a status change and exact large-number difference" imageWidth={1280} imageHeight={720}
  breadcrumb={[{ name: "JSON Tools", href: "/json-tools/" }, { name: "JSON Diff" }]}
  toolId="json-diff"
  jsonLd={jsonLd}
>
  <div id="diff-workspace" class="max-w-6xl mx-auto min-w-0">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-1">JSON Diff — Compare JSON Online</h1>
    <p class="mb-3 text-sm text-slate-600 dark:text-slate-300">Compare API responses and config files. Match records by ID, keep numeric digits exact, and share a comparison your teammate can reopen.</p>

    <div class="mb-3 flex flex-wrap items-center gap-2 text-sm">
      <button id="compare-btn" data-share-action="compare" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">Compare JSON</button>
      <button id="format-btn" class="diff-button">Format Both</button>
      <button id="swap-btn" class="diff-button">Swap</button>
      <button id="sample-btn" class="diff-button">Load Sample</button>
      <button id="diff-find-btn" class="diff-button">Find</button>
      <button id="clear-btn" class="diff-button">Clear</button>
      <button id="cancel-diff-btn" class="diff-button hidden">Cancel</button>
      <button id="share-diff-btn" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700 disabled:opacity-50 sm:ml-auto">Share comparison ↗</button>
    </div>
    <p id="diff-status" role="status" class="mb-3 text-xs text-slate-500 dark:text-slate-400">Local processing · up to 10 MiB per file · try the sample to start</p>

    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="json1" class="text-sm font-medium text-gray-700 dark:text-slate-200">Original JSON</label><button id="json1-file-btn" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Open file</button></div>
        <input id="json1-file" type="file" accept="application/json,.json,text/plain" class="hidden" />
        <JsonEditor id="json1" label="Original JSON" shareKey="json1" height="h-56" />
        <p id="json1-file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Drop a local JSON file here.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="json2" class="text-sm font-medium text-gray-700 dark:text-slate-200">Modified JSON</label><button id="json2-file-btn" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Open file</button></div>
        <input id="json2-file" type="file" accept="application/json,.json,text/plain" class="hidden" />
        <JsonEditor id="json2" label="Modified JSON" shareKey="json2" height="h-56" />
        <p id="json2-file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Drop a local JSON file here.</p>
      </div>
    </div>

    <!-- Options -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <div class="flex flex-wrap items-center gap-6">
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="ignore-key-order" data-share-key="ignoreKeyOrder" checked class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
          <span class="text-sm text-gray-700 dark:text-slate-200">Ignore key order</span>
        </label>
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="ignore-array-order" data-share-key="ignoreArrayOrder" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
          <span class="text-sm text-gray-700 dark:text-slate-200">Ignore array order</span>
        </label>
      </div>
      <details id="diff-advanced" class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-700">
        <summary class="cursor-pointer text-sm font-semibold text-indigo-700 dark:text-indigo-300">Match records by ID &amp; ignore fields</summary>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <div><label for="array-key" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Array identity field <span class="font-normal text-slate-500 dark:text-slate-400">(optional)</span></label><input id="array-key" data-share-key="arrayKey" maxlength="200" placeholder="id, sku, or another unique field" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" /><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Pairs records by this field, even when reordered. Applies to every object array; primitive arrays keep the ordering option above.</p></div>
          <div><label for="ignored-paths" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Ignore fields or JSON Pointers <span class="font-normal text-slate-500 dark:text-slate-400">(optional)</span></label><textarea id="ignored-paths" data-share-key="ignoredPaths" rows="2" maxlength="100100" placeholder="updatedAt&#10;/meta/requestId" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"></textarea><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">One pointer per line; field names can be comma-separated. Names apply at every depth; /pointers target exact source paths. No wildcards. Ignoring does not redact shared inputs.</p></div>
        </div>
      </details>
    </div>

    <div id="diff-find-bar" class="hidden mb-4 flex flex-wrap items-center gap-2 rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
      <label for="diff-find-input" class="text-sm font-medium text-slate-700 dark:text-slate-200">Find keys or values</label>
      <input id="diff-find-input" type="search" class="min-w-0 flex-1 rounded border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Search both JSON documents" />
      <select id="diff-find-scope" class="rounded border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200" aria-label="Find scope"><option value="both">Both</option><option value="original">Original</option><option value="modified">Modified</option></select>
      <span id="diff-find-count" class="min-w-20 text-right text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></span>
      <button id="diff-find-prev" class="rounded border border-slate-300 px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" title="Previous match">↑</button>
      <button id="diff-find-next" class="rounded border border-slate-300 px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" title="Next match">↓</button>
      <button id="diff-find-close" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700" aria-label="Close find">×</button>
    </div>

    <div id="error-box" role="alert" class="hidden mb-4 flex flex-wrap items-center gap-3 p-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-800 dark:text-red-300"><span id="diff-error-text"></span><button id="diff-error-jump" class="hidden rounded border border-red-300 px-2 py-1 text-xs font-semibold text-red-800 hover:bg-red-100 dark:border-red-800 dark:text-red-200 dark:hover:bg-red-950/50">Jump to error</button></div>

    <div id="stats" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800"></div>

    <!-- Diff Results -->
    <div id="results" class="hidden">
      <div id="change-nav" class="hidden mb-4 flex flex-wrap items-center gap-2 rounded-lg border border-indigo-200 bg-indigo-50 p-3 dark:border-indigo-900 dark:bg-indigo-950/30">
        <span id="change-position" class="mr-auto min-w-0 break-all text-sm font-semibold text-indigo-900 dark:text-indigo-100">Change 1 / 1</span>
        <button id="change-prev" class="rounded border border-indigo-300 px-3 py-1.5 text-sm font-semibold text-indigo-800 hover:bg-indigo-100 dark:border-indigo-700 dark:text-indigo-200 dark:hover:bg-indigo-900/60">Previous</button>
        <button id="change-next" class="rounded bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-700">Next</button>
        <button id="export-report-btn" class="rounded border border-indigo-300 px-3 py-1.5 text-sm font-semibold text-indigo-800 hover:bg-indigo-100 dark:border-indigo-700 dark:text-indigo-200 dark:hover:bg-indigo-900/60">Download report</button>
        <button id="export-patch-btn" class="diff-button disabled:opacity-50">Download JSON Patch</button>
        <button id="share-result-btn" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-700">Share result ↗</button>
      </div>
      <div class="mb-3 flex flex-wrap items-start gap-3"><p id="patch-note" class="min-w-0 flex-1 text-xs text-slate-500 dark:text-slate-400"></p><label class="inline-flex shrink-0 items-center gap-2 text-xs text-slate-600 dark:text-slate-300"><input id="sync-previews" type="checkbox" checked class="rounded text-indigo-600" />Sync previews</label></div>
      <!-- Side-by-side JSON view with highlighting -->
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Original</label>
            <div class="flex gap-2 text-xs">
              <span class="px-2 py-0.5 bg-red-200 text-red-800 rounded border border-red-400">removed</span>
              <span class="px-2 py-0.5 bg-purple-200 text-purple-800 rounded border border-purple-400">changed</span>
            </div>
          </div>
          <div id="diff-left" class="font-mono text-sm overflow-auto max-h-[500px] border border-gray-200 dark:border-slate-700 rounded bg-gray-50 dark:bg-slate-900 p-2"></div>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Modified</label>
            <div class="flex gap-2 text-xs">
              <span class="px-2 py-0.5 bg-green-200 text-green-800 rounded border border-green-400">added</span>
              <span class="px-2 py-0.5 bg-purple-200 text-purple-800 rounded border border-purple-400">changed</span>
            </div>
          </div>
          <div id="diff-right" class="font-mono text-sm overflow-auto max-h-[500px] border border-gray-200 dark:border-slate-700 rounded bg-gray-50 dark:bg-slate-900 p-2"></div>
        </div>
      </div>

      <!-- Textual Changes Report -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="mb-3 flex flex-wrap items-center gap-2"><h2 class="mr-auto text-sm font-semibold text-slate-800 dark:text-slate-100">Changes Report</h2><label class="sr-only" for="change-filter">Filter changes</label><input id="change-filter" type="search" placeholder="Filter changed paths" class="min-w-0 w-44 rounded border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-600 dark:bg-slate-900" /></div>
        <div id="changes-list" class="space-y-2 max-h-80 overflow-auto break-words"></div>
        <button id="changes-more" class="diff-button mt-2 hidden">Load more changes</button>
        <div id="selected-change" class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-900">
          <p id="selected-path" class="mb-2 break-all font-mono text-xs text-slate-700 dark:text-slate-200"></p>
          <div class="flex flex-wrap gap-2"><button id="copy-old-btn" class="diff-button disabled:opacity-50">Copy old value</button><button id="copy-new-btn" class="diff-button disabled:opacity-50">Copy new value</button><button id="copy-pointer-btn" class="diff-button">Copy JSON Pointer</button><button id="jump-old-btn" class="diff-button disabled:opacity-50">Jump to original</button><button id="jump-new-btn" class="diff-button disabled:opacity-50">Jump to modified</button></div>
          <p id="selected-value" class="mt-2 max-h-40 overflow-auto break-all whitespace-pre-wrap font-mono text-xs text-slate-600 dark:text-slate-300"></p>
        </div>
      </div>
    </div>

    <JsonToolContent tool="diff" />
  </div>
</Layout>



<script>
  import '../lib/json-diff-ui.ts';
</script>
<style>
  .diff-button { border: 1px solid #cbd5e1; border-radius: .5rem; padding: .4rem .7rem; background: #fff; color: #334155; font-size: .8rem; font-weight: 600; }
  .diff-button:hover { background: #f1f5f9; }
  :global(.dark) .diff-button { border-color: #475569; background: #1e293b; color: #e2e8f0; }
  :global(.dark) .diff-button:hover { background: #334155; }
  :global(#diff-workspace mark.diff-focus) { outline: 2px solid #4f46e5; outline-offset: 2px; }
  :global(#diff-workspace button:focus-visible), :global(#diff-workspace summary:focus-visible) { outline: 2px solid #6366f1; outline-offset: 3px; }
  :global(#diff-left), :global(#diff-right) { overflow-wrap: anywhere; }
</style>

---
import Layout from '../layouts/Layout.astro';

const tools = [
  { name: 'JSON Formatter', href: '/json-formatter/', description: 'Pretty-print, validate, and minify JSON; explore a tree, copy jq paths, and share the example' },
  { name: 'JSON Diff', href: '/json-diff/', description: 'Compare API responses and nested JSON, control key and array order, and share highlighted changes' },
  { name: 'JSON to Code', href: '/json-to-code/', description: 'Generate TypeScript interfaces, Zod schemas, and Pydantic models from a JSON example' },
  { name: 'JSONL Viewer', href: '/jsonl-viewer/', description: 'Validate, filter, inspect, and export newline-delimited JSON or NDJSON records' },
  { name: 'YAML ↔ JSON', href: '/yaml-json-converter/', description: 'Bidirectional conversion between YAML and JSON formats' },
  { name: 'CSV ↔ JSON', href: '/csv-json-converter/', description: 'Convert between CSV spreadsheets and JSON arrays' },
];
---

<Layout
  title="JSON Tools"
  description="Free online JSON tools for developers. Format, validate, compare, convert, and generate TypeScript, Zod, or Pydantic code from JSON locally in your browser."
  keywords="JSON tools, JSON formatter, JSON diff, JSON to TypeScript, JSON to Zod, JSON to Pydantic, YAML to JSON, CSV to JSON, JSON converter, JSON validator"
  breadcrumb={[{ name: "JSON Tools" }]}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-2">JSON Tools</h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6">Format, validate, compare, and convert JSON data</p>

    <div class="grid md:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="block p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-md transition-all"
        >
          <h2 class="text-lg font-semibold text-indigo-600 dark:text-indigo-400 mb-1">{tool.name}</h2>
          <p class="text-sm text-gray-600 dark:text-slate-300">{tool.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-8 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-2">About JSON Tools</h2>
      <p class="text-gray-600 dark:text-slate-300 text-sm">
        JSON (JavaScript Object Notation) is the most widely used data interchange format. Our JSON tools help you
        format messy JSON, compare documents to find differences, and convert between JSON and other popular formats
        like YAML and CSV. Processing happens in your browser. Sharing is optional: embedded links carry the example
        in the URL fragment, while choosing a short link stores the shared data.
      </p>
    </div>

    <section class="mt-6">
      <h2 class="mb-3 text-lg font-semibold text-slate-800 dark:text-slate-100">Practical JSON guides</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <a href="/guides/format-validate-json-api-response/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <h3 class="font-semibold text-indigo-600 dark:text-indigo-400">Format a JSON API response and copy a jq path</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Runnable example, syntax troubleshooting, and local command-line recipes.</p>
        </a>
        <a href="/guides/compare-json-api-responses-ignore-array-order/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <h3 class="font-semibold text-indigo-600 dark:text-indigo-400">Compare JSON responses with reordered arrays</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Understand key order, duplicate items, and meaningful value changes.</p>
        </a>
        <a href="/guides/json-to-typescript-zod-pydantic/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <h3 class="font-semibold text-indigo-600 dark:text-indigo-400">Generate TypeScript, Zod, and Pydantic code from JSON</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Use a representative response, understand optional fields and nulls, then review the generated model.</p>
        </a>
        <a href="/guides/jsonl-ndjson-viewer-validator/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <h3 class="font-semibold text-indigo-600 dark:text-indigo-400">Validate JSONL and NDJSON one line at a time</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Isolate bad lines, inspect valid records, and export a JSON array.</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

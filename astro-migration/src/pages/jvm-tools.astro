---
import Layout from '../layouts/Layout.astro';

const tools = [
  { name: 'Java Thread Dump Analyzer', href: '/thread-dump-analyzer', description: 'Analyze HotSpot, OpenJDK, jstack, jcmd, and virtual-thread JSON dumps for deadlocks, contention, states, and repeated stacks' },
];
---

<Layout
  title="JVM Diagnostic Tools for Java Thread Dumps"
  description="Browser-based JVM diagnostics for jstack, jcmd, HotSpot, OpenJDK, and virtual-thread JSON dumps. Find deadlocks, blocked threads, lock owners, and repeated stacks locally."
  keywords="JVM tools, Java diagnostics, thread dump analyzer, jstack analyzer, jcmd analyzer, Java deadlock, virtual threads, JVM troubleshooting"
  breadcrumb={[{ name: 'JVM Diagnostic Tools' }]}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-2">JVM Diagnostic Tools</h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6">Understand JVM behavior from diagnostic captures without uploading production data.</p>
    <div class="grid md:grid-cols-2 gap-4">
      {tools.map(tool => (
        <a href={tool.href} class="block p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-md transition-all">
          <h2 class="text-lg font-semibold text-indigo-600 dark:text-indigo-400 mb-1">{tool.name}</h2>
          <p class="text-sm text-gray-600 dark:text-slate-300">{tool.description}</p>
        </a>
      ))}
    </div>
    <div class="mt-8 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-2">Private JVM troubleshooting</h2>
      <p class="text-gray-600 dark:text-slate-300 text-sm">Thread names and stack traces can reveal packages, endpoints, database drivers, and application internals. Diagnostic parsing runs locally in your browser. Start with <code class="text-xs">jcmd &lt;pid&gt; Thread.print -l</code> or <code class="text-xs">jstack -l &lt;pid&gt;</code>; for virtual threads, open the JSON produced by <code class="text-xs">Thread.dump_to_file -format=json</code>.</p>
    </div>
  </div>
</Layout>

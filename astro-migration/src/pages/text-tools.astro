---
import Layout from '../layouts/Layout.astro';

const tools = [
  { name: 'Text Diff', href: '/text-diff', description: 'Compare two texts with GitHub-style diff view and line highlighting' },
  { name: 'ASCII Table Converter', href: '/ascii-table-converter', description: 'Turn terminal tables into editable HTML, CSV, Excel, or PDF' },
  { name: 'ASCII Table Generator', href: '/ascii-table-generator', description: 'Turn CSV, TSV, JSON, or HTML into a clean terminal table' },
  { name: 'Case Converter', href: '/case-converter', description: 'Convert between camelCase, snake_case, kebab-case, and more' },
  { name: 'Join Lines', href: '/join-lines', description: 'Convert lines to SQL IN clauses, JSON arrays, CSV, and more' },
  { name: 'Split Text', href: '/split-text', description: 'Split delimited strings into separate lines' },
  { name: 'Sort Lines', href: '/sort-lines', description: 'Sort lines alphabetically, numerically, by length, or shuffle' },
  { name: 'Remove Duplicates', href: '/remove-duplicate-lines', description: 'Remove duplicate lines with detailed report' },
  { name: 'Compare Lists', href: '/list-compare', description: 'Find common items, differences, and unique entries between lists' },
  { name: 'Text Extractor', href: '/text-extractor', description: 'Extract patterns like emails, URLs, and numbers from text' },
  { name: 'Regex Tester', href: '/regex-tester', description: 'Test regular expressions with live highlighting and match info' },
];
---

<Layout
  title="Text Tools"
  description="Convert terminal tables to Excel or CSV, generate ASCII tables from JSON, compare text, deduplicate and join lines, extract patterns, change case, and test regex locally."
  keywords="terminal table to Excel, ASCII table converter, ASCII table generator, text diff, case converter, line dedupe, regex tester, text extractor"
  breadcrumb={[{ name: "Text Tools" }]}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-2">Text Tools</h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6">Compare, transform, and analyze text data</p>

    <div class="grid md:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="block p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-md transition-all"
        >
          <h2 class="text-lg font-semibold text-indigo-600 dark:text-indigo-400 mb-1">{tool.name}</h2>
          <p class="text-sm text-gray-600 dark:text-slate-300">{tool.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-8 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-2">About Text Tools</h2>
      <p class="text-gray-600 dark:text-slate-300 text-sm">
        Working with text is a daily task for developers. Our text tools help you compare files to find changes,
        convert between naming conventions, clean up duplicate data, and test regular expressions before using them
        in code. All processing happens in your browser - your data stays private.
      </p>
    </div>
  </div>
</Layout>

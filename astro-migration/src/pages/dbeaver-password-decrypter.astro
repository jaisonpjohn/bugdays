---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="DBeaver Password Decrypter"
  description="Decrypt DBeaver saved database passwords from credentials-config.json. Recover forgotten database passwords stored in DBeaver. Free online decryption tool."
  keywords="DBeaver password decrypt, DBeaver credentials, decrypt DBeaver password, recover DBeaver password, DBeaver password recovery, database password decrypt"
  breadcrumb={[{ name: "Security Tools", href: "/security-tools" }, { name: "DBeaver Password Decrypt" }]}
  toolId="dbeaver-password"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">DBeaver Password Decrypter</h1>

    <!-- New DBeaver (6.1.3+) - File based -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-4">DBeaver 6.1.3+ (credentials-config.json)</h2>

      <div class="text-sm text-gray-600 dark:text-slate-300 mb-4 space-y-2">
        <p><strong>1. Locate credentials-config.json:</strong></p>
        <ul class="list-disc ml-6 text-gray-500 dark:text-slate-400">
          <li>Mac: ~/Library/DBeaverData/workspace6/General/.dbeaver/credentials-config.json</li>
          <li>Windows: %APPDATA%\DBeaverData\workspace6\General\.dbeaver\credentials-config.json</li>
          <li>Linux: ~/.local/share/DBeaverData/workspace6/General/.dbeaver/credentials-config.json</li>
        </ul>
        <p><strong>2. Upload the file below to decrypt:</strong></p>
      </div>

      <div class="flex items-center gap-4 mb-4">
        <label class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 cursor-pointer font-medium">
          Select credentials-config.json
          <input type="file" id="file-input" accept=".json" class="hidden">
        </label>
        <span id="file-name" class="text-sm text-gray-500 dark:text-slate-400"></span>
      </div>

      <div id="file-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>
      <div id="file-success" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700"></div>

      <!-- Results Table -->
      <div id="results-table" class="hidden overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-slate-900">
            <tr>
              <th class="px-4 py-3 text-left font-medium text-gray-700 dark:text-slate-200 border-b">#</th>
              <th class="px-4 py-3 text-left font-medium text-gray-700 dark:text-slate-200 border-b">Connection ID</th>
              <th class="px-4 py-3 text-left font-medium text-gray-700 dark:text-slate-200 border-b">Username</th>
              <th class="px-4 py-3 text-left font-medium text-gray-700 dark:text-slate-200 border-b">Password</th>
            </tr>
          </thead>
          <tbody id="results-body" class="divide-y divide-gray-200"></tbody>
        </table>
      </div>

      <p class="text-xs text-gray-500 dark:text-slate-400 mt-4"><strong>3. Correlate with data-sources.json</strong> in the same folder to find connection details.</p>
    </div>

    <!-- Alternative: OpenSSL Method -->
    <details class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 mb-6">
      <summary class="px-6 py-4 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700 font-semibold text-gray-800 dark:text-slate-100">
        Alternative: OpenSSL Command Line Method
      </summary>
      <div class="px-6 pb-6">
        <p class="text-sm text-gray-600 dark:text-slate-300 mb-4">
          You can also decrypt the credentials file using OpenSSL directly from the command line:
        </p>

        <div class="space-y-4">
          <div>
            <h4 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">macOS</h4>
            <pre class="bg-gray-900 dark:bg-slate-950 text-green-400 p-4 rounded-lg text-xs overflow-x-auto"><code>openssl aes-128-cbc -d \
  -K babb4a9f774ab853c96c2d653dfe544a \
  -iv 00000000000000000000000000000000 \
  -in "$HOME/Library/DBeaverData/workspace6/General/.dbeaver/credentials-config.json" | \
  dd bs=1 skip=16 2>/dev/null</code></pre>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Linux</h4>
            <pre class="bg-gray-900 dark:bg-slate-950 text-green-400 p-4 rounded-lg text-xs overflow-x-auto"><code>openssl aes-128-cbc -d \
  -K babb4a9f774ab853c96c2d653dfe544a \
  -iv 00000000000000000000000000000000 \
  -in ~/.local/share/DBeaverData/workspace6/General/.dbeaver/credentials-config.json | \
  dd bs=1 skip=16 2>/dev/null</code></pre>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Generic (any file path)</h4>
            <pre class="bg-gray-900 dark:bg-slate-950 text-green-400 p-4 rounded-lg text-xs overflow-x-auto"><code>openssl aes-128-cbc -d \
  -K babb4a9f774ab853c96c2d653dfe544a \
  -iv 00000000000000000000000000000000 \
  -in credentials-config.json | \
  dd bs=1 skip=16 2>/dev/null</code></pre>
          </div>

          <div class="bg-slate-50 dark:bg-slate-900 rounded-lg p-4 text-sm">
            <h4 class="font-medium text-gray-700 dark:text-slate-200 mb-2">How was the key derived?</h4>
            <p class="text-gray-600 dark:text-slate-400 mb-2">
              The key <code class="bg-gray-200 dark:bg-slate-700 px-1 rounded">babb4a9f774ab853c96c2d653dfe544a</code> comes from
              <a href="https://github.com/dbeaver/dbeaver/blob/d69a75e63bf0a00e37f6b4ab9c9aa4fcaa0ded23/plugins/org.jkiss.dbeaver.model/src/org/jkiss/dbeaver/model/impl/app/DefaultSecureStorage.java#L32" class="text-indigo-600 dark:text-indigo-400 hover:underline" target="_blank" rel="noopener">DBeaver's source code</a>,
              converted to hexadecimal:
            </p>
            <pre class="bg-gray-900 dark:bg-slate-950 text-green-400 p-3 rounded-lg text-xs overflow-x-auto"><code># Python
import struct
struct.pack('&lt;16b', -70, -69, 74, -97, 119, 74, -72, 83, -55, 108, 45, 101, 61, -2, 84, 74).hex()
# Output: 'babb4a9f774ab853c96c2d653dfe544a'</code></pre>
          </div>
        </div>
      </div>
    </details>

    <!-- Old DBeaver (Pre 6.1.3) - Text based -->
    <details class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 mb-6">
      <summary class="px-6 py-4 cursor-pointer hover:bg-gray-50 dark:bg-slate-900 font-semibold text-gray-800 dark:text-slate-100">
        Old DBeaver (Pre 6.1.3) - Text Decryption ▾
      </summary>
      <div class="px-6 pb-6">
        <div class="text-sm text-gray-600 dark:text-slate-300 mb-4 space-y-2">
          <p><strong>1. Locate .dbeaver-data-sources.xml:</strong></p>
          <ul class="list-disc ml-6 text-gray-500 dark:text-slate-400">
            <li>DBeaver 6.0.3: ~/.dbeaver4/General/.dbeaver-data-sources.xml</li>
            <li>Older: ~/.dbeaver/General/.dbeaver-data-sources.xml</li>
          </ul>
          <p><strong>2. Find encrypted password and paste below:</strong></p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Encrypted Password</label>
            <input type="text" id="encrypted" data-share-key="encrypted" class="w-full p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm" placeholder="Paste encrypted password (e.g., OwEKLE4jpQ==)">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Decrypted Password</label>
            <div class="flex gap-2">
              <input type="text" id="decrypted" readonly class="flex-1 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-gray-50 dark:bg-slate-900" placeholder="Decrypted password...">
              <button id="copy-btn" class="px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300">Copy</button>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button id="decrypt-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">Decrypt</button>
            <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 font-medium">Clear</button>
          </div>

          <div id="text-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>
        </div>
      </div>
    </details>

    <!-- Shameless plug -->
    <div class="bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-200 dark:border-slate-700 p-4">
      <p class="text-sm text-gray-600 dark:text-slate-300">
        If this helped you, I'd appreciate a 👍 on my <a href="https://stackoverflow.com/questions/39928401/recover-db-password-stored-in-my-dbeaver-connection/39928445#39928445" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">Stack Overflow answer</a>
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">DBeaver Password Decryption Tool</h2>
      <p class="text-gray-600 dark:text-slate-300">Decrypt passwords saved in DBeaver. All decryption happens locally in your browser - no data is sent to any server.</p>
    </div>
  </div>
</Layout>

<script>
  import { ShareManager } from '../lib/share';

  const LOCAL_KEY = new Uint8Array([186, 187, 74, 159, 119, 74, 184, 83, 201, 108, 45, 101, 61, 254, 84, 74]);

  // ===== New DBeaver (6.1.3+) - File Decryption =====
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileName = document.getElementById('file-name');
  const fileError = document.getElementById('file-error');
  const fileSuccess = document.getElementById('file-success');
  const resultsTable = document.getElementById('results-table');
  const resultsBody = document.getElementById('results-body');

  fileInput.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    fileName.textContent = file.name;
    fileError.classList.add('hidden');
    fileSuccess.classList.add('hidden');
    resultsTable.classList.add('hidden');

    try {
      const contents = await file.arrayBuffer();
      const decryptedData = await decryptFile(contents);
      const decryptedObject = JSON.parse(decryptedData);

      const connections: Array<{id: string, user: string, password: string}> = [];
      for (const [key, value] of Object.entries(decryptedObject)) {
        const conn = (value as any)['#connection'];
        if (conn) {
          connections.push({
            id: key,
            user: conn.user || '',
            password: conn.password || ''
          });
        }
      }

      if (connections.length === 0) {
        fileError.textContent = 'No connections found in file';
        fileError.classList.remove('hidden');
        return;
      }

      resultsBody.innerHTML = connections.map((c, i) => `
        <tr class="hover:bg-gray-50 dark:bg-slate-900">
          <td class="px-4 py-3 text-gray-600 dark:text-slate-300">${i + 1}</td>
          <td class="px-4 py-3 font-mono text-xs">${escapeHtml(c.id)}</td>
          <td class="px-4 py-3">${escapeHtml(c.user)}</td>
          <td class="px-4 py-3 font-mono">${escapeHtml(c.password)}</td>
        </tr>
      `).join('');

      fileSuccess.textContent = `Successfully decrypted ${connections.length} connection(s)`;
      fileSuccess.classList.remove('hidden');
      resultsTable.classList.remove('hidden');

    } catch (err) {
      fileError.textContent = 'Failed to decrypt file: ' + (err as Error).message;
      fileError.classList.remove('hidden');
    }
  });

  async function decryptFile(contents: ArrayBuffer): Promise<string> {
    const byteStream = new Uint8Array(contents);
    const fileIv = byteStream.slice(0, 16);
    const encryptedData = byteStream.slice(16);

    const key = await window.crypto.subtle.importKey(
      'raw',
      LOCAL_KEY.slice(0, 16),
      { name: 'AES-CBC' },
      false,
      ['decrypt']
    );

    const decryptedData = await window.crypto.subtle.decrypt(
      { name: 'AES-CBC', iv: fileIv },
      key,
      encryptedData
    );

    return new TextDecoder().decode(decryptedData);
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ===== Old DBeaver (Pre 6.1.3) - XOR Decryption =====
  // Ported from Java SimpleStringEncrypter
  const PASSWORD_ENCRYPTION_KEY = "sdf@!#$verf^wv%6Fwe%$#FFGwfsdefwfe135s$^H)dg";

  const S_BASE64CHAR = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  const S_BASE64PAD = '=';

  // Build decode table
  const S_DECODETABLE = new Array(128).fill(127);
  for (let i = 0; i < S_BASE64CHAR.length; i++) {
    S_DECODETABLE[S_BASE64CHAR.charCodeAt(i)] = i;
  }

  function decode0(ibuf: string[], obuf: number[], wp: number): number {
    let outlen = 3;
    if (ibuf[3] === S_BASE64PAD) outlen = 2;
    if (ibuf[2] === S_BASE64PAD) outlen = 1;

    const b0 = S_DECODETABLE[ibuf[0].charCodeAt(0)];
    const b1 = S_DECODETABLE[ibuf[1].charCodeAt(0)];
    const b2 = S_DECODETABLE[ibuf[2].charCodeAt(0)];
    const b3 = S_DECODETABLE[ibuf[3].charCodeAt(0)];

    switch (outlen) {
      case 1:
        obuf[wp] = ((b0 << 2) & 0xfc) | ((b1 >> 4) & 0x3);
        return 1;
      case 2:
        obuf[wp] = ((b0 << 2) & 0xfc) | ((b1 >> 4) & 0x3);
        obuf[wp + 1] = ((b1 << 4) & 0xf0) | ((b2 >> 2) & 0xf);
        return 2;
      case 3:
        obuf[wp] = ((b0 << 2) & 0xfc) | ((b1 >> 4) & 0x3);
        obuf[wp + 1] = ((b1 << 4) & 0xf0) | ((b2 >> 2) & 0xf);
        obuf[wp + 2] = ((b2 << 6) & 0xc0) | (b3 & 0x3f);
        return 3;
      default:
        throw new Error('Internal Error');
    }
  }

  function decodeBase64(data: string): number[] {
    const ibuf: string[] = ['', '', '', ''];
    let ibufcount = 0;
    const obuf: number[] = new Array(Math.floor(data.length / 4) * 3 + 3).fill(0);
    let obufcount = 0;

    for (let i = 0; i < data.length; i++) {
      const ch = data.charAt(i);
      const code = ch.charCodeAt(0);
      if (ch === S_BASE64PAD || (code < S_DECODETABLE.length && S_DECODETABLE[code] !== 127)) {
        ibuf[ibufcount++] = ch;
        if (ibufcount === 4) {
          ibufcount = 0;
          obufcount += decode0(ibuf, obuf, obufcount);
        }
      }
    }

    return obuf.slice(0, obufcount);
  }

  function xorStringByKey(plainBytes: number[]): void {
    let keyOffset = 0;
    for (let i = 0; i < plainBytes.length; i++) {
      const keyChar = PASSWORD_ENCRYPTION_KEY.charCodeAt(keyOffset);
      keyOffset++;
      if (keyOffset >= PASSWORD_ENCRYPTION_KEY.length) {
        keyOffset = 0;
      }
      plainBytes[i] ^= keyChar;
      // Convert to signed byte (-128 to 127) for validation
      if (plainBytes[i] > 127) {
        plainBytes[i] -= 256;
      }
    }
  }

  function decryptPassword(encryptedString: string): string {
    if (!encryptedString || encryptedString.trim() === '') {
      throw new Error('Empty encrypted string');
    }

    const decoded = decodeBase64(encryptedString);
    xorStringByKey(decoded);

    // Validate: last 2 bytes should be 0 and -127
    if (decoded[decoded.length - 2] === 0 && decoded[decoded.length - 1] === -127) {
      // Convert bytes to string (excluding the 2 validation bytes)
      const resultBytes = decoded.slice(0, decoded.length - 2);
      // Handle negative bytes for UTF-8 conversion
      const uint8 = new Uint8Array(resultBytes.map(b => b < 0 ? b + 256 : b));
      return new TextDecoder('utf-8').decode(uint8);
    } else {
      throw new Error('Invalid encrypted string');
    }
  }

  const encrypted = document.getElementById('encrypted') as HTMLInputElement;
  const decrypted = document.getElementById('decrypted') as HTMLInputElement;
  const textError = document.getElementById('text-error');

  document.getElementById('decrypt-btn').addEventListener('click', () => {
    textError.classList.add('hidden');
    if (!encrypted.value) {
      textError.textContent = 'Please enter an encrypted password';
      textError.classList.remove('hidden');
      return;
    }
    try {
      decrypted.value = decryptPassword(encrypted.value.trim());
    } catch (e) {
      textError.textContent = 'Failed to decrypt: ' + (e as Error).message;
      textError.classList.remove('hidden');
    }
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    encrypted.value = '';
    decrypted.value = '';
    textError.classList.add('hidden');
  });

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(decrypted.value);
  });

  ShareManager.register({
    tool: 'dbeaver-password',
    afterLoad: () => {
      if (encrypted.value.trim()) {
        document.getElementById('decrypt-btn')!.click();
      }
    }
  });
</script>

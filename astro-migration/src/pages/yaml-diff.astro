---
import Layout from '../layouts/Layout.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "YAML Diff - Compare YAML Online",
    "description": "Free online YAML diff tool. Compare two YAML files and find differences instantly with color-coded highlighting.",
    "url": "https://bugdays.com/yaml-diff",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": ["YAML comparison", "Semantic diff", "Deep object comparison", "Color-coded diff"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I compare two YAML files?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Paste your original YAML in the left panel and modified YAML in the right panel, then click Compare. The tool highlights added, removed, and modified values."
        }
      },
      {
        "@type": "Question",
        "name": "Does YAML key order matter when comparing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "By default, key order is ignored for comparison. YAML is typically order-independent for mappings."
        }
      }
    ]
  }
];
---

<Layout
  title="YAML Diff Online - Compare YAML Files, Find Differences"
  description="Free YAML diff tool to compare two YAML files online. Find differences instantly with semantic comparison. Color-coded highlighting shows added, removed, and changed values. Compare Kubernetes configs, Docker Compose files."
  keywords="YAML diff, YAML compare, YAML comparison, compare YAML online, diff YAML, YAML diff checker, Kubernetes config diff, Docker Compose compare"
  breadcrumb={[{ name: "YAML Tools", href: "/yaml-tools" }, { name: "YAML Diff" }]}
  toolId="yaml-diff"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">YAML Diff - Compare YAML Online</h1>

    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Original YAML</label>
        <textarea
          id="yaml1"
          data-share-key="yaml1"
          class="w-full h-48 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
          placeholder="server:
  host: localhost
  port: 8080"
        ></textarea>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Modified YAML</label>
        <textarea
          id="yaml2"
          data-share-key="yaml2"
          class="w-full h-48 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
          placeholder="server:
  host: production.example.com
  port: 443"
        ></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
      <button id="compare-btn" data-share-action="compare" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Compare YAML
      </button>
      <button id="format-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Format Both
      </button>
      <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Clear
      </button>
      <button id="swap-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Swap
      </button>
      <button id="sample-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Load Sample
      </button>
    </div>

    <div id="error-box" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>

    <div id="stats" class="hidden mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800"></div>

    <!-- Diff Results -->
    <div id="results" class="hidden">
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Original</label>
            <div class="flex gap-2 text-xs">
              <span class="px-2 py-0.5 bg-red-200 text-red-800 rounded border border-red-400">removed</span>
              <span class="px-2 py-0.5 bg-purple-200 text-purple-800 rounded border border-purple-400">changed</span>
            </div>
          </div>
          <div id="diff-left" class="font-mono text-sm overflow-auto max-h-[500px] border border-gray-200 dark:border-slate-700 rounded bg-gray-50 dark:bg-slate-900 p-2"></div>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Modified</label>
            <div class="flex gap-2 text-xs">
              <span class="px-2 py-0.5 bg-green-200 text-green-800 rounded border border-green-400">added</span>
              <span class="px-2 py-0.5 bg-purple-200 text-purple-800 rounded border border-purple-400">changed</span>
            </div>
          </div>
          <div id="diff-right" class="font-mono text-sm overflow-auto max-h-[500px] border border-gray-200 dark:border-slate-700 rounded bg-gray-50 dark:bg-slate-900 p-2"></div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-3">Changes Report</label>
        <div id="changes-list" class="space-y-2 max-h-80 overflow-auto"></div>
      </div>
    </div>

    <div class="mt-8 space-y-6">
      <div>
        <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online YAML Diff & Comparison Tool</h2>
        <p class="text-gray-600 dark:text-slate-300 mb-4">
          Compare two YAML files and instantly find all differences. This YAML diff checker parses YAML to objects
          and performs semantic comparison to identify added, removed, and modified values. Perfect for
          comparing Kubernetes manifests, Docker Compose files, Ansible playbooks, or any YAML configuration.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 text-sm">
        <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg">
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">Semantic Comparison</h3>
          <p class="text-gray-600 dark:text-slate-300">Compares parsed YAML structure, not just text. Finds real differences even with formatting changes.</p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg">
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">Color-Coded Diff</h3>
          <p class="text-gray-600 dark:text-slate-300">Green for added, red for removed, purple for changed. See exactly what's different.</p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg">
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">DevOps Ready</h3>
          <p class="text-gray-600 dark:text-slate-300">Compare Kubernetes configs, Helm values, Docker Compose, and CI/CD pipelines.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>

<script>
  import { ShareManager } from '../lib/share';

  const yaml1Input = document.getElementById('yaml1') as HTMLTextAreaElement;
  const yaml2Input = document.getElementById('yaml2') as HTMLTextAreaElement;
  const diffLeft = document.getElementById('diff-left');
  const diffRight = document.getElementById('diff-right');
  const changesList = document.getElementById('changes-list');
  const results = document.getElementById('results');
  const stats = document.getElementById('stats');
  const errorBox = document.getElementById('error-box');

  ShareManager.register({
    tool: 'yaml-diff',
    actions: {
      compare: () => document.getElementById('compare-btn')?.click(),
    }
  });

  const sample1 = `# Kubernetes Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-app
  labels:
    app: web
spec:
  replicas: 2
  selector:
    matchLabels:
      app: web
  template:
    spec:
      containers:
        - name: web
          image: nginx:1.19
          ports:
            - containerPort: 80
          resources:
            limits:
              memory: "128Mi"
              cpu: "500m"`;

  const sample2 = `# Kubernetes Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-app
  labels:
    app: web
    environment: production
spec:
  replicas: 3
  selector:
    matchLabels:
      app: web
  template:
    spec:
      containers:
        - name: web
          image: nginx:1.21
          ports:
            - containerPort: 80
          resources:
            limits:
              memory: "256Mi"
              cpu: "1000m"`;

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    results.classList.add('hidden');
    stats.classList.add('hidden');
  }

  function hideError() {
    errorBox.classList.add('hidden');
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  interface Change {
    type: 'added' | 'removed' | 'modified';
    path: string;
    oldValue?: any;
    newValue?: any;
  }

  function findChanges(obj1: any, obj2: any, path: string = ''): Change[] {
    const changes: Change[] = [];

    if (obj1 === obj2) return changes;
    if (obj1 === null && obj2 !== null) {
      return [{ type: 'modified', path: path || '(root)', oldValue: null, newValue: obj2 }];
    }
    if (obj1 !== null && obj2 === null) {
      return [{ type: 'modified', path: path || '(root)', oldValue: obj1, newValue: null }];
    }

    if (typeof obj1 !== 'object' || typeof obj2 !== 'object') {
      if (obj1 !== obj2) {
        changes.push({ type: 'modified', path: path || '(root)', oldValue: obj1, newValue: obj2 });
      }
      return changes;
    }

    if (Array.isArray(obj1) && Array.isArray(obj2)) {
      const maxLen = Math.max(obj1.length, obj2.length);
      for (let i = 0; i < maxLen; i++) {
        const itemPath = path ? `${path}[${i}]` : `[${i}]`;
        if (i >= obj1.length) {
          changes.push({ type: 'added', path: itemPath, newValue: obj2[i] });
        } else if (i >= obj2.length) {
          changes.push({ type: 'removed', path: itemPath, oldValue: obj1[i] });
        } else {
          changes.push(...findChanges(obj1[i], obj2[i], itemPath));
        }
      }
      return changes;
    }

    if (Array.isArray(obj1) !== Array.isArray(obj2)) {
      changes.push({ type: 'modified', path: path || '(root)', oldValue: obj1, newValue: obj2 });
      return changes;
    }

    const keys1 = new Set(Object.keys(obj1));
    const keys2 = new Set(Object.keys(obj2));

    for (const key of keys1) {
      if (!keys2.has(key)) {
        const keyPath = path ? `${path}.${key}` : key;
        changes.push({ type: 'removed', path: keyPath, oldValue: obj1[key] });
      }
    }

    for (const key of keys2) {
      if (!keys1.has(key)) {
        const keyPath = path ? `${path}.${key}` : key;
        changes.push({ type: 'added', path: keyPath, newValue: obj2[key] });
      }
    }

    for (const key of keys1) {
      if (keys2.has(key)) {
        const keyPath = path ? `${path}.${key}` : key;
        changes.push(...findChanges(obj1[key], obj2[key], keyPath));
      }
    }

    return changes;
  }

  function renderYamlWithHighlights(yamlStr: string, obj: any, changes: Change[], isOriginal: boolean): string {
    const changedPaths = new Map<string, Change>();
    changes.forEach(c => changedPaths.set(c.path, c));

    // Convert back to YAML for display
    const jsYaml = (window as any).jsyaml;
    const prettyYaml = jsYaml.dump(obj, { indent: 2, lineWidth: -1 });

    // Simple line-by-line highlighting based on changes
    const lines = prettyYaml.split('\n');
    const highlightedLines = lines.map(line => {
      const escapedLine = escapeHtml(line);

      // Check if any change path matches this line
      for (const [path, change] of changedPaths) {
        const keyMatch = path.split('.').pop() || path;
        if (line.includes(keyMatch + ':') || line.includes('- ' + keyMatch)) {
          if (change.type === 'added' && !isOriginal) {
            return `<span style="background-color: #bbf7d0; color: #14532d; display: block;">${escapedLine}</span>`;
          } else if (change.type === 'removed' && isOriginal) {
            return `<span style="background-color: #fecaca; color: #7f1d1d; display: block;">${escapedLine}</span>`;
          } else if (change.type === 'modified') {
            return `<span style="background-color: #e9d5ff; color: #581c87; display: block;">${escapedLine}</span>`;
          }
        }
      }
      return escapedLine;
    });

    return '<pre class="whitespace-pre-wrap text-sm">' + highlightedLines.join('\n') + '</pre>';
  }

  function compare() {
    hideError();

    const str1 = yaml1Input.value.trim();
    const str2 = yaml2Input.value.trim();

    if (!str1 || !str2) {
      showError('Please enter YAML in both fields');
      return;
    }

    const jsYaml = (window as any).jsyaml;
    let obj1: any, obj2: any;

    try {
      obj1 = jsYaml.load(str1);
    } catch (e) {
      showError('Invalid YAML in left panel: ' + (e as Error).message);
      return;
    }
    try {
      obj2 = jsYaml.load(str2);
    } catch (e) {
      showError('Invalid YAML in right panel: ' + (e as Error).message);
      return;
    }

    const changes = findChanges(obj1, obj2);

    const added = changes.filter(c => c.type === 'added').length;
    const removed = changes.filter(c => c.type === 'removed').length;
    const modified = changes.filter(c => c.type === 'modified').length;

    if (changes.length === 0) {
      stats.innerHTML = '✓ <strong>No differences</strong> - YAML documents are equal';
      stats.className = 'mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-800';
    } else {
      const parts = [];
      if (added > 0) parts.push(`<span class="text-green-700 font-medium">+${added} added</span>`);
      if (removed > 0) parts.push(`<span class="text-red-700 font-medium">-${removed} removed</span>`);
      if (modified > 0) parts.push(`<span class="text-purple-700 font-medium">~${modified} changed</span>`);
      stats.innerHTML = `Found <strong>${changes.length} difference${changes.length !== 1 ? 's' : ''}</strong>: ${parts.join(', ')}`;
      stats.className = 'mb-4 p-3 bg-purple-50 border border-purple-200 rounded-lg text-sm text-gray-800';
    }
    stats.classList.remove('hidden');

    diffLeft.innerHTML = renderYamlWithHighlights(str1, obj1, changes, true);
    diffRight.innerHTML = renderYamlWithHighlights(str2, obj2, changes, false);

    if (changes.length === 0) {
      changesList.innerHTML = '<div class="text-gray-500 dark:text-slate-400 text-sm">No differences</div>';
    } else {
      const formatVal = (v: any) => {
        const s = JSON.stringify(v);
        return s && s.length > 80 ? s.slice(0, 80) + '...' : s;
      };

      changesList.innerHTML = changes.map(c => {
        const bgStyle = c.type === 'added' ? 'background-color: #f0fdf4; border-left: 4px solid #22c55e;' :
                        c.type === 'removed' ? 'background-color: #fef2f2; border-left: 4px solid #ef4444;' :
                        'background-color: #faf5ff; border-left: 4px solid #a855f7;';
        const icon = c.type === 'added' ? '+' : c.type === 'removed' ? '-' : '~';
        const iconColor = c.type === 'added' ? 'color: #16a34a;' : c.type === 'removed' ? 'color: #dc2626;' : 'color: #9333ea;';

        let content = `<span style="${iconColor} font-weight: bold; margin-right: 0.5rem;">${icon}</span>`;
        content += `<code class="text-indigo-700">${escapeHtml(c.path)}</code>`;

        if (c.type === 'added') {
          content += `<span class="text-gray-500 mx-2">=</span><span class="text-green-700">${escapeHtml(formatVal(c.newValue))}</span>`;
        } else if (c.type === 'removed') {
          content += `<span class="text-gray-500 mx-2">was</span><span class="text-red-700">${escapeHtml(formatVal(c.oldValue))}</span>`;
        } else {
          content += `<span class="text-gray-500 mx-2">changed from</span><span class="text-red-700">${escapeHtml(formatVal(c.oldValue))}</span>`;
          content += `<span class="text-gray-500 mx-2">→</span><span class="text-green-700">${escapeHtml(formatVal(c.newValue))}</span>`;
        }
        return `<div class="p-3 rounded-lg font-mono text-sm leading-relaxed mb-2" style="${bgStyle}">${content}</div>`;
      }).join('');
    }

    results.classList.remove('hidden');

    diffLeft.onscroll = () => { diffRight.scrollTop = diffLeft.scrollTop; };
    diffRight.onscroll = () => { diffLeft.scrollTop = diffRight.scrollTop; };
  }

  document.getElementById('compare-btn').addEventListener('click', compare);

  document.getElementById('format-btn').addEventListener('click', () => {
    const jsYaml = (window as any).jsyaml;
    try {
      if (yaml1Input.value.trim()) {
        const obj = jsYaml.load(yaml1Input.value);
        yaml1Input.value = jsYaml.dump(obj, { indent: 2 });
      }
    } catch {}
    try {
      if (yaml2Input.value.trim()) {
        const obj = jsYaml.load(yaml2Input.value);
        yaml2Input.value = jsYaml.dump(obj, { indent: 2 });
      }
    } catch {}
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    yaml1Input.value = '';
    yaml2Input.value = '';
    results.classList.add('hidden');
    stats.classList.add('hidden');
    hideError();
  });

  document.getElementById('swap-btn').addEventListener('click', () => {
    const temp = yaml1Input.value;
    yaml1Input.value = yaml2Input.value;
    yaml2Input.value = temp;
    if (!results.classList.contains('hidden')) compare();
  });

  document.getElementById('sample-btn').addEventListener('click', () => {
    yaml1Input.value = sample1;
    yaml2Input.value = sample2;
    hideError();
  });
</script>

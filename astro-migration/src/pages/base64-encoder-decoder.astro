---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Base64 Encoder & Decoder"
  description="Encode text to Base64 or decode Base64 strings instantly. Free online Base64 converter for encoding binary data, images, and files. Supports UTF-8 and ASCII text."
  keywords="Base64 encoder, Base64 decoder, encode Base64, decode Base64, Base64 converter, Base64 online, text to Base64, Base64 to text"
  breadcrumb={[{ name: "Encoding Tools", href: "/encoding-tools" }, { name: "Base64 Encoder/Decoder" }]}
  toolId="base64"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">Base64 Encoder / Decoder</h1>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Input</label>
        <textarea
          id="input"
          data-share-key="input"
          class="w-full h-64 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
          placeholder="Enter text to encode or Base64 to decode..."
        ></textarea>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Output</label>
        <textarea
          id="output"
          readonly
          class="w-full h-64 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-gray-50 dark:bg-slate-900 resize-none"
          placeholder="Result will appear here..."
        ></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mt-4">
      <button id="encode-btn" data-share-action="encode" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Encode to Base64
      </button>
      <button id="decode-btn" data-share-action="decode" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Decode from Base64
      </button>
      <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Clear
      </button>
      <button id="copy-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Copy Output
      </button>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online Base64 Encoder/Decoder</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Instantly encode text to Base64 or decode Base64 strings back to plain text.
        Base64 encoding is commonly used for encoding binary data in text-based formats like JSON, XML, or email attachments.
      </p>
      <p class="mt-3 text-gray-600 dark:text-slate-300">Decoding a string that starts with <code>H4sI</code>? It may contain compressed bytes. Use the <a href="/gzip-base64/" class="text-indigo-600 dark:text-indigo-400 underline">GZip Base64 decoder</a> to decompress it, or follow the <a href="/guides/decode-base64-gzip-to-json/" class="text-indigo-600 dark:text-indigo-400 underline">worked Base64 GZip example</a>.</p>
    </div>
  </div>
</Layout>

<script>
  import { ShareManager } from '../lib/share';

  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;

  // Register share actions
  ShareManager.register({
    tool: 'base64',
    actions: {
      encode: () => document.getElementById('encode-btn')?.click(),
      decode: () => document.getElementById('decode-btn')?.click(),
    }
  });

  document.getElementById('encode-btn').addEventListener('click', () => {
    try {
      output.value = btoa(input.value);
    } catch (e) {
      output.value = 'Error: ' + e.message;
    }
  });

  document.getElementById('decode-btn').addEventListener('click', () => {
    try {
      output.value = atob(input.value);
    } catch (e) {
      output.value = 'Error: Invalid Base64 string';
    }
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    input.value = '';
    output.value = '';
  });

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });
</script>

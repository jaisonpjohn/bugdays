---
import Layout from '../layouts/Layout.astro';

const faqs = [
  ['What is Base64?', 'Base64 is a text representation of bytes. It is useful when a system accepts text but needs to carry binary data; it is not encryption or compression.'],
  ['Does Base64 support Unicode and emoji?', 'Yes. This tool encodes text as UTF-8 before Base64 conversion, so accented characters and emoji round-trip correctly.'],
  ['What is Base64URL?', 'Base64URL uses - and _ instead of + and / and may omit padding. JWT sections commonly use this URL-safe form.'],
  ['Can I encode a file without uploading it?', 'Yes. Choose a local file and its bytes are read and converted in the browser. Nothing is uploaded unless you explicitly create a share link.'],
  ['Why does decoded Base64 look unreadable?', 'It may be binary data or compressed bytes. A value beginning H4sI often needs the GZip Base64 decoder rather than ordinary text decoding.'],
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: 'Base64 Encoder and Decoder', url: 'https://bugdays.com/base64-encoder-decoder/',
    description: 'Encode UTF-8 text or local files to Base64, decode Base64 or Base64URL, inspect byte counts, download results, and share a reproducible example.',
    applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: ['UTF-8 Base64 encode and decode', 'Base64URL conversion', 'Local file to Base64', 'Data URI input', 'Copy and download output', 'Shareable examples'],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---

<Layout
  title="Base64 Encoder & Decoder — UTF-8, Base64URL & Files"
  description="Encode UTF-8 text or local files to Base64, decode Base64 and Base64URL, inspect byte counts, copy or download results, and share a reproducible example. Runs in your browser."
  keywords="Base64 encoder, Base64 decoder, Base64URL decoder, encode Base64 UTF-8, decode Base64 online, file to Base64, data URI to Base64, Base64 converter"
  breadcrumb={[{ name: 'Encoding Tools', href: '/encoding-tools/' }, { name: 'Base64 Encoder/Decoder' }]}
  toolId="base64"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-1">Base64 Encoder &amp; Decoder</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Convert UTF-8 text, Base64URL values, data URIs, or a local file—then copy, download, or share a safe example.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="input" class="text-sm font-semibold text-slate-700 dark:text-slate-200">Input</label><button id="open-file" type="button" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Encode local file</button></div>
        <input id="file-input" type="file" class="hidden" />
        <textarea id="input" data-share-key="input" class="h-64 w-full resize-none rounded-lg border border-slate-300 p-3 font-mono text-sm text-slate-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Paste UTF-8 text, Base64, Base64URL, or a data URI…" spellcheck="false"></textarea>
        <p id="input-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Text stays in this browser.</p>
      </section>
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <label for="output" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Output</label>
        <textarea id="output" readonly class="h-64 w-full resize-none rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Result appears here…" spellcheck="false"></textarea>
        <p id="output-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p>
      </section>
    </div>

    <div id="error-box" role="alert" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>

    <div class="mt-4 flex flex-wrap gap-2">
      <button id="encode-btn" data-share-action="encode" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Encode UTF-8 → Base64</button>
      <button id="decode-btn" data-share-action="decode" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Decode Base64 → Text</button>
      <button id="base64url-btn" data-share-action="base64url" class="rounded-lg border border-indigo-300 px-4 py-2 font-semibold text-indigo-700 hover:bg-indigo-50 dark:border-indigo-800 dark:text-indigo-300 dark:hover:bg-indigo-950/40">Base64URL ↔ Base64</button>
      <button id="copy-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Copy output</button>
      <button id="download-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Download</button>
      <button id="share-base64-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Share example ↗</button>
      <button id="clear-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Clear</button>
    </div>

    <div class="mt-7 grid gap-4 md:grid-cols-3 text-sm">
      <a href="/gzip-base64/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Payload begins H4sI?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Decode its Base64 GZip bytes into readable text.</span></a>
      <a href="/jwt-decoder/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Inspect a JWT</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">JWT segments use unpadded Base64URL—not ordinary Base64.</span></a>
      <a href="/json-formatter/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Decoded JSON?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Format, validate, search, and share the response.</span></a>
    </div>

    <section class="mt-8 max-w-4xl space-y-5 text-sm leading-7 text-slate-600 dark:text-slate-300">
      <div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Base64 encoding is not encryption</h2><p class="mt-2">Base64 converts bytes into printable characters. Anyone who has the value can decode it, so do not treat a Base64 token as secret protection. It also adds size; use it only where a text-only format such as JSON, XML, an email attachment, or a data URI requires it.</p></div>
      <div><h2 class="text-xl font-bold text-slate-900 dark:text-white">UTF-8, Base64URL, and binary files</h2><p class="mt-2">Older browser snippets using <code>btoa</code> break on emoji and other non-ASCII text. This page converts text to UTF-8 bytes first. Base64URL is the URL-safe variant used by JWTs: it replaces <code>+</code> and <code>/</code>, and often removes trailing <code>=</code> padding. Local file encoding preserves the raw bytes instead of guessing a character encoding. Follow the <a href="/guides/base64-utf8-base64url-file-decoder/" class="text-indigo-600 underline dark:text-indigo-400">Base64, UTF-8, and Base64URL guide</a> for worked examples.</p></div>
      <div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Share a reproducible example, not production data</h2><p class="mt-2">Use the visible Share example action to preserve an input and operation for a colleague. Links are useful for synthetic samples and bug reports; anyone with a shared link can read its included input. Keep credentials, customer data, and private files out of shared examples.</p></div>
      <div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Common Base64 questions</h2><div class="mt-3 space-y-2">{faqs.map(([question, answer]) => <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-100">{question}</summary><p class="mt-2">{answer}</p></details>)}</div></div>
    </section>
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import { ShareManager } from '../lib/share.ts';

  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;
  const errorBox = document.getElementById('error-box')!;
  const outputStatus = document.getElementById('output-status')!;
  const inputStatus = document.getElementById('input-status')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const encoder = new TextEncoder();
  const decoder = new TextDecoder('utf-8', { fatal: true });

  ShareManager.register({ tool: 'base64', actions: {
    encode: () => document.getElementById('encode-btn')?.click(),
    decode: () => document.getElementById('decode-btn')?.click(),
    base64url: () => document.getElementById('base64url-btn')?.click(),
  } });
  document.getElementById('share-base64-btn')!.addEventListener('click', () => document.getElementById('share-btn')?.click());

  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function hideError() { errorBox.classList.add('hidden'); }
  function bytesToBase64(bytes: Uint8Array) {
    const chunks: string[] = [];
    for (let start = 0; start < bytes.length; start += 0x8000) chunks.push(String.fromCharCode(...bytes.subarray(start, start + 0x8000)));
    return btoa(chunks.join(''));
  }
  function base64ToBytes(value: string) {
    const stripped = value.trim().replace(/^data:[^,]*,/, '').replace(/\s/g, '').replace(/-/g, '+').replace(/_/g, '/');
    const padded = stripped + '='.repeat((4 - stripped.length % 4) % 4);
    const binary = atob(padded);
    return Uint8Array.from(binary, character => character.charCodeAt(0));
  }
  function setOutput(value: string, detail: string) { output.value = value; outputStatus.textContent = detail; }
  function encodeText() {
    hideError();
    const bytes = encoder.encode(input.value);
    setOutput(bytesToBase64(bytes), `${bytes.length.toLocaleString()} UTF-8 bytes → ${output.value.length.toLocaleString()} Base64 characters`);
  }
  function decodeText() {
    hideError();
    try { const bytes = base64ToBytes(input.value); setOutput(decoder.decode(bytes), `${bytes.length.toLocaleString()} decoded bytes → UTF-8 text`); }
    catch { showError('That is not valid UTF-8 Base64 text. It may be binary data, a truncated value, or Base64 GZip.'); }
  }
  function toggleBase64Url() {
    hideError();
    const text = input.value.trim();
    if (!text) return showError('Paste Base64 or Base64URL first.');
    const hasUrlCharacters = /[-_]/.test(text) || !/[+/=]/.test(text);
    try {
      if (hasUrlCharacters) setOutput(bytesToBase64(base64ToBytes(text)), 'Base64URL → standard Base64');
      else setOutput(text.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''), 'Standard Base64 → unpadded Base64URL');
    } catch { showError('That is not valid Base64 or Base64URL.'); }
  }
  document.getElementById('encode-btn')!.addEventListener('click', encodeText);
  document.getElementById('decode-btn')!.addEventListener('click', decodeText);
  document.getElementById('base64url-btn')!.addEventListener('click', toggleBase64Url);
  document.getElementById('copy-btn')!.addEventListener('click', () => { if (output.value) navigator.clipboard.writeText(output.value); });
  document.getElementById('download-btn')!.addEventListener('click', () => {
    if (!output.value) return;
    track('export_used', { tool: 'base64', format: 'txt' });
    const href = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' }));
    const link = document.createElement('a'); link.href = href; link.download = 'base64-output.txt'; link.click(); URL.revokeObjectURL(href);
  });
  document.getElementById('clear-btn')!.addEventListener('click', () => { input.value = ''; output.value = ''; outputStatus.textContent = ''; inputStatus.textContent = 'Text stays in this browser.'; hideError(); });
  document.getElementById('open-file')!.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0]; fileInput.value = '';
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) return showError('Choose a file smaller than 10 MB.');
    const reader = new FileReader();
    reader.onload = () => { const bytes = new Uint8Array(reader.result as ArrayBuffer); input.value = bytesToBase64(bytes); setOutput(input.value, `${bytes.length.toLocaleString()} local bytes → Base64`); inputStatus.textContent = `Loaded ${Math.max(1, Math.round(file.size / 1024))} KB locally. Nothing was uploaded.`; hideError(); };
    reader.onerror = () => showError('The local file could not be read.');
    reader.readAsArrayBuffer(file);
  });
</script>

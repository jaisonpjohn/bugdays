---
import Layout from '../layouts/Layout.astro';

// Code samples stored as strings to avoid Astro template parsing issues
const envoyConfig = `static_resources:
  listeners:
  - name: listener_0
    address:
      socket_address: { address: 0.0.0.0, port_value: 8080 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          codec_type: auto
          stat_prefix: ingress_http
          route_config:
            name: local_route
            virtual_hosts:
            - name: local_service
              domains: ["*"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: grpc_service }
              cors:
                allow_origin_string_match:
                - prefix: "*"
                allow_methods: GET, PUT, DELETE, POST, OPTIONS
                allow_headers: "*"
                expose_headers: grpc-status, grpc-message
          http_filters:
          - name: envoy.filters.http.grpc_web
          - name: envoy.filters.http.cors
          - name: envoy.filters.http.router
  clusters:
  - name: grpc_service
    connect_timeout: 0.25s
    type: logical_dns
    http2_protocol_options: {}
    lb_policy: round_robin
    load_assignment:
      cluster_name: grpc_service
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: localhost, port_value: 9090 }`;

const grpcwebproxyConfig = `# Install
go install github.com/nicksrandall/grpcwebproxy@latest

# Run (proxies localhost:9090 to localhost:8080)
grpcwebproxy \\
  --backend_addr=localhost:9090 \\
  --run_tls_server=false \\
  --allow_all_origins`;

const sampleProtoCode = `syntax = "proto3";

package helloworld;

service Greeter {
  // Unary RPC
  rpc SayHello (HelloRequest) returns (HelloReply);

  // Server streaming RPC
  rpc SayHelloServerStream (HelloRequest) returns (stream HelloReply);

  // Client streaming RPC
  rpc SayHelloClientStream (stream HelloRequest) returns (HelloReply);

  // Bidirectional streaming RPC
  rpc SayHelloBidiStream (stream HelloRequest) returns (stream HelloReply);
}

message HelloRequest {
  string name = 1;
  int32 count = 2;
  repeated string tags = 3;
}

message HelloReply {
  string message = 1;
  int64 timestamp = 2;
}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "gRPC Client - Online Protobuf Tester",
    "description": "Free online gRPC client and Protobuf tester. Parse .proto files, build request messages, test gRPC services via grpc-web.",
    "url": "https://bugdays.com/grpc-client",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": ["Proto file parsing", "gRPC service testing", "Protobuf message builder", "grpc-web support", "Streaming RPC support"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is gRPC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "gRPC is a high-performance RPC (Remote Procedure Call) framework developed by Google. It uses Protocol Buffers (protobuf) for serialization and HTTP/2 for transport, enabling efficient bi-directional streaming."
        }
      },
      {
        "@type": "Question",
        "name": "Can I test gRPC from a browser?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Direct gRPC requires HTTP/2, which browsers don't fully support for client requests. You need grpc-web, a proxy that translates between gRPC-Web (browser-compatible) and native gRPC."
        }
      },
      {
        "@type": "Question",
        "name": "What is a .proto file?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A .proto file defines the structure of your gRPC services and messages using Protocol Buffers language. It specifies service methods, request/response message types, and field definitions."
        }
      }
    ]
  }
];
---

<Layout
  title="gRPC Client - Online Protobuf & gRPC-Web Tester"
  description="Free online gRPC client and Protocol Buffers tester. Parse .proto files, build request messages, test gRPC services via grpc-web. Support for unary and streaming RPCs."
  keywords="gRPC client, protobuf tester, grpc-web client, online gRPC tester, protocol buffers, proto file parser, gRPC testing tool, test gRPC API, gRPC request builder, protobuf message builder"
  breadcrumb={[{ name: "Network Tools", href: "/network-tools" }, { name: "gRPC Client" }]}
  toolId="grpc-client"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto">

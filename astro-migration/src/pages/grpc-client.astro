<script>
  import { ShareManager } from '../lib/share';

  // DOM Elements
  const protoFileInput = document.getElementById('proto-file') as HTMLInputElement;
  const protoInput = document.getElementById('proto-input') as HTMLTextAreaElement;
  const parseProtoBtn = document.getElementById('parse-proto-btn');
  const fileNameEl = document.getElementById('file-name');
  const servicesSection = document.getElementById('services-section');
  const servicesList = document.getElementById('services-list');
  const requestSection = document.getElementById('request-section');
  const selectedMethodEl = document.getElementById('selected-method');
  const methodTypeEl = document.getElementById('method-type');
  const endpointUrlInput = document.getElementById('endpoint-url') as HTMLInputElement;
  const requestJsonInput = document.getElementById('request-json') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('send-btn');
  const responseSection = document.getElementById('response-section');
  const responseBody = document.getElementById('response-body');
  const statusBadge = document.getElementById('status-badge');
  const responseTime = document.getElementById('response-time');
  const errorBox = document.getElementById('error-box');
  const loadingEl = document.getElementById('loading');
  const loadingText = document.getElementById('loading-text');
  const loadSampleBtn = document.getElementById('load-sample-btn');
  const sampleProto = document.getElementById('sample-proto');

  interface ParsedProto {
    package: string;
    services: Service[];
    messages: { [name: string]: Message };
  }

  interface Service {
    name: string;
    methods: Method[];
  }

  interface Method {
    name: string;
    inputType: string;
    outputType: string;
    clientStreaming: boolean;
    serverStreaming: boolean;
  }

  interface Message {
    name: string;
    fields: Field[];
  }

  interface Field {
    name: string;
    type: string;
    repeated: boolean;
    number: number;
  }

  let parsedProto: ParsedProto | null = null;
  let selectedMethod: { service: string; method: Method } | null = null;

  // File upload
  protoFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    fileNameEl!.textContent = file.name;

    const reader = new FileReader();
    reader.onload = (e) => {
      protoInput.value = e.target?.result as string;
    };
    reader.readAsText(file);
  });

  // Load sample
  loadSampleBtn?.addEventListener('click', () => {
    protoInput.value = sampleProto?.textContent || '';
  });

  // Parse proto
  parseProtoBtn?.addEventListener('click', () => {
    const proto = protoInput.value.trim();
    if (!proto) {
      showError('Please enter a proto definition');
      return;
    }

    try {
      parsedProto = parseProto(proto);
      displayServices();
      hideError();
    } catch (err) {
      showError(`Failed to parse proto: ${(err as Error).message}`);
    }
  });

  function parseProto(proto: string): ParsedProto {
    const result: ParsedProto = {
      package: '',
      services: [],
      messages: {}
    };

    // Extract package
    const packageMatch = proto.match(/package\s+([\w.]+)\s*;/);
    if (packageMatch) {
      result.package = packageMatch[1];
    }

    // Extract messages
    const messageRegex = /message\s+(\w+)\s*\{([^}]*)\}/g;
    let messageMatch;
    while ((messageMatch = messageRegex.exec(proto)) !== null) {
      const messageName = messageMatch[1];
      const messageBody = messageMatch[2];
      const fields: Field[] = [];

      const fieldRegex = /(repeated\s+)?(\w+)\s+(\w+)\s*=\s*(\d+)/g;
      let fieldMatch;
      while ((fieldMatch = fieldRegex.exec(messageBody)) !== null) {
        fields.push({
          repeated: !!fieldMatch[1],
          type: fieldMatch[2],
          name: fieldMatch[3],
          number: parseInt(fieldMatch[4])
        });
      }

      result.messages[messageName] = { name: messageName, fields };
    }

    // Extract services
    const serviceRegex = /service\s+(\w+)\s*\{([^}]*)\}/g;
    let serviceMatch;
    while ((serviceMatch = serviceRegex.exec(proto)) !== null) {
      const serviceName = serviceMatch[1];
      const serviceBody = serviceMatch[2];
      const methods: Method[] = [];

      const methodRegex = /rpc\s+(\w+)\s*\(\s*(stream\s+)?(\w+)\s*\)\s*returns\s*\(\s*(stream\s+)?(\w+)\s*\)/g;
      let methodMatch;
      while ((methodMatch = methodRegex.exec(serviceBody)) !== null) {
        methods.push({
          name: methodMatch[1],
          clientStreaming: !!methodMatch[2],
          inputType: methodMatch[3],
          serverStreaming: !!methodMatch[4],
          outputType: methodMatch[5]
        });
      }

      result.services.push({ name: serviceName, methods });
    }

    if (result.services.length === 0) {
      throw new Error('No services found in proto definition');
    }

    return result;
  }

  function displayServices() {
    if (!parsedProto || !servicesList) return;

    let html = '';
    parsedProto.services.forEach(service => {
      html += `<div class="mb-4">
        <h4 class="text-sm font-medium text-gray-800 dark:text-slate-100 mb-2">${service.name}</h4>
        <div class="space-y-1">`;

      service.methods.forEach(method => {
        const methodType = getMethodType(method);
        html += `
          <button class="method-btn w-full text-left p-2 hover:bg-gray-50 dark:hover:bg-slate-700 rounded border border-gray-200 dark:border-slate-600 transition-colors"
                  data-service="${service.name}" data-method="${method.name}">
            <span class="font-mono text-sm text-gray-800 dark:text-slate-100">${method.name}</span>
            <span class="ml-2 px-1.5 py-0.5 text-xs rounded ${getMethodTypeClass(methodType)}">${methodType}</span>
            <span class="text-xs text-gray-500 dark:text-slate-400 ml-2">(${method.inputType}) → ${method.outputType}</span>
          </button>`;
      });

      html += '</div></div>';
    });

    servicesList.innerHTML = html;

    // Add click handlers
    document.querySelectorAll('.method-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const serviceName = (btn as HTMLElement).dataset.service || '';
        const methodName = (btn as HTMLElement).dataset.method || '';
        selectMethod(serviceName, methodName);
      });
    });

    servicesSection?.classList.remove('hidden');

    // Auto-select first method
    if (parsedProto.services.length > 0 && parsedProto.services[0].methods.length > 0) {
      selectMethod(parsedProto.services[0].name, parsedProto.services[0].methods[0].name);
    }
  }

  function getMethodType(method: Method): string {
    if (method.clientStreaming && method.serverStreaming) return 'bidi';
    if (method.clientStreaming) return 'client-stream';
    if (method.serverStreaming) return 'server-stream';
    return 'unary';
  }

  function getMethodTypeClass(type: string): string {
    switch (type) {
      case 'unary': return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400';
      case 'server-stream': return 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400';
      case 'client-stream': return 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400';
      case 'bidi': return 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400';
      default: return 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400';
    }
  }

  function selectMethod(serviceName: string, methodName: string) {
    const service = parsedProto?.services.find(s => s.name === serviceName);
    const method = service?.methods.find(m => m.name === methodName);
    if (!service || !method) return;

    selectedMethod = { service: serviceName, method };

    const fullMethodName = `/${parsedProto!.package}.${serviceName}/${methodName}`;
    selectedMethodEl!.textContent = fullMethodName;

    const methodType = getMethodType(method);
    methodTypeEl!.textContent = methodType;
    methodTypeEl!.className = `px-2 py-0.5 rounded text-xs font-medium ${getMethodTypeClass(methodType)}`;

    // Generate sample request
    const message = parsedProto!.messages[method.inputType];
    const sampleRequest = generateSampleRequest(message);
    requestJsonInput.value = JSON.stringify(sampleRequest, null, 2);

    requestSection?.classList.remove('hidden');
  }

  function generateSampleRequest(message: Message | undefined): any {
    if (!message) return {};

    const obj: any = {};
    message.fields.forEach(field => {
      let value: any;
      switch (field.type) {
        case 'string': value = ''; break;
        case 'int32': case 'int64': case 'uint32': case 'uint64': value = 0; break;
        case 'float': case 'double': value = 0.0; break;
        case 'bool': value = false; break;
        case 'bytes': value = ''; break;
        default:
          // Nested message
          const nestedMessage = parsedProto?.messages[field.type];
          value = nestedMessage ? generateSampleRequest(nestedMessage) : {};
      }

      obj[field.name] = field.repeated ? [value] : value;
    });

    return obj;
  }

  // Format JSON
  document.getElementById('format-request-btn')?.addEventListener('click', () => {
    try {
      const json = JSON.parse(requestJsonInput.value);
      requestJsonInput.value = JSON.stringify(json, null, 2);
    } catch (err) {
      showError('Invalid JSON');
    }
  });

  // Send request
  sendBtn?.addEventListener('click', async () => {
    const endpoint = endpointUrlInput.value.trim();
    if (!endpoint) {
      showError('Please enter a gRPC-Web endpoint URL');
      return;
    }

    if (!selectedMethod) {
      showError('Please select a method');
      return;
    }

    let requestData: any;
    try {
      requestData = JSON.parse(requestJsonInput.value);
    } catch (err) {
      showError('Invalid JSON in request body');
      return;
    }

    showLoading('Sending gRPC request...');
    hideError();
    responseSection?.classList.add('hidden');

    const methodPath = `/${parsedProto!.package}.${selectedMethod.service}/${selectedMethod.method.name}`;
    const url = endpoint.replace(/\/$/, '') + methodPath;

    // Collect metadata
    const metadata: { [key: string]: string } = {};
    document.querySelectorAll('.metadata-row').forEach(row => {
      const key = (row.querySelector('.metadata-key') as HTMLInputElement)?.value.trim();
      const value = (row.querySelector('.metadata-value') as HTMLInputElement)?.value.trim();
      if (key && value) {
        metadata[key] = value;
      }
    });

    const startTime = performance.now();

    try {
      // gRPC-Web uses application/grpc-web+proto or application/grpc-web+json
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/grpc-web+json',
          'X-Grpc-Web': '1',
          ...metadata
        },
        body: JSON.stringify(requestData)
      });

      const elapsed = Math.round(performance.now() - startTime);
      const responseText = await response.text();

      // Try to parse as JSON
      let displayText = responseText;
      try {
        const json = JSON.parse(responseText);
        displayText = JSON.stringify(json, null, 2);
      } catch {
        // Keep as-is if not JSON
      }

      responseBody!.textContent = displayText;
      responseTime!.textContent = `${elapsed}ms`;

      // Check grpc-status header
      const grpcStatus = response.headers.get('grpc-status');
      const grpcMessage = response.headers.get('grpc-message');

      if (grpcStatus === '0' || response.ok) {
        statusBadge!.textContent = grpcStatus === '0' ? 'OK (0)' : `${response.status}`;
        statusBadge!.className = 'px-2 py-1 rounded font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400';
      } else {
        statusBadge!.textContent = grpcStatus ? `Error (${grpcStatus})` : `${response.status}`;
        statusBadge!.className = 'px-2 py-1 rounded font-medium bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400';
        if (grpcMessage) {
          responseBody!.textContent = `gRPC Error: ${decodeURIComponent(grpcMessage)}\n\n${displayText}`;
        }
      }

      responseSection?.classList.remove('hidden');

    } catch (err) {
      const errorMsg = (err as Error).message;
      const isCorsLikely = errorMsg.includes('Failed to fetch') || errorMsg.includes('NetworkError') || errorMsg.includes('Load failed');

      if (isCorsLikely) {
        showError(
          `CORS Error: The gRPC-Web server blocked this cross-origin request.\n\n` +
          `Ensure your gRPC server has gRPC-Web + CORS enabled, or use a proxy like Envoy.\n` +
          `Alternatively, use Holy CORS: brew install bugdays-com/tap/holy-cors`
        );
      } else {
        showError(`Request failed: ${errorMsg}`);
      }
    } finally {
      hideLoading();
    }
  });

  // Copy response
  document.getElementById('copy-response-btn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(responseBody!.textContent || '');
  });

  // Add metadata row
  document.getElementById('add-metadata-btn')?.addEventListener('click', () => {
    const metadataList = document.getElementById('metadata-list');
    const row = document.createElement('div');
    row.className = 'metadata-row flex gap-2';
    row.innerHTML = `
      <input type="text" class="metadata-key flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100" placeholder="Key" />
      <input type="text" class="metadata-value flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100" placeholder="Value" />
      <button class="remove-metadata-btn p-2 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded">×</button>
    `;
    metadataList?.appendChild(row);

    row.querySelector('.remove-metadata-btn')?.addEventListener('click', () => row.remove());
  });

  // Initial remove button handler
  document.querySelector('.remove-metadata-btn')?.addEventListener('click', (e) => {
    (e.target as HTMLElement).closest('.metadata-row')?.remove();
  });

  function showError(msg: string) {
    errorBox!.textContent = msg;
    errorBox?.classList.remove('hidden');
  }

  function hideError() {
    errorBox?.classList.add('hidden');
  }

  function showLoading(msg: string) {
    loadingText!.textContent = msg;
    loadingEl?.classList.remove('hidden');
  }

  function hideLoading() {
    loadingEl?.classList.add('hidden');
  }

  // Share functionality
  ShareManager.register({
    tool: 'grpc-client',
    afterLoad: () => {
      // Auto-parse if proto is loaded from share
      if (protoInput.value.trim()) {
        parseProtoBtn?.click();
      }
    }
  });
</script>

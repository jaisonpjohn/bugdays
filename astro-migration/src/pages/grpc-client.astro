      </div>

      <div class="text-xs text-gray-500 dark:text-slate-400 mb-2">Or paste proto definition:</div>

      <textarea
        id="proto-input"
        data-share-key="proto"
        class="w-full h-48 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 resize-y"
        placeholder="Paste your .proto definition here or use 'Load Sample' below..."

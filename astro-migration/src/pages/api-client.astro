---
import Layout from '../layouts/Layout.astro';
import LocalBridgeAccessDialog from '../components/LocalBridgeAccessDialog.astro';
---

<Layout
  title="API Client - REST API Tester"
  description="Test REST APIs with custom HTTP methods, headers, and body. Free online API client supporting GET, POST, PUT, DELETE with response formatting and history."
  keywords="API client, REST API tester, HTTP client online, test API, Postman alternative, API testing tool, REST client, HTTP request tester"
  breadcrumb={[{ name: "Network Tools", href: "/network-tools" }, { name: "API Client" }]}
  toolId="api-client"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">API Client</h1>

    <!-- Request Builder -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <div class="flex flex-wrap gap-3 mb-4">
        <select id="method" data-share-key="method" class="p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-medium">
          <option value="GET" class="text-green-600">GET</option>
          <option value="POST" class="text-yellow-600">POST</option>
          <option value="PUT" class="text-blue-600">PUT</option>
          <option value="PATCH" class="text-purple-600">PATCH</option>
          <option value="DELETE" class="text-red-600">DELETE</option>
          <option value="HEAD">HEAD</option>
          <option value="OPTIONS">OPTIONS</option>
        </select>
        <input
          type="text"
          id="url-input"
          data-share-key="url"
          class="flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm"
          placeholder="https://api.example.com/endpoint"
        />
        <button id="send-btn" data-share-action="send" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
          Send
        </button>
      </div>

      <!-- Proxy Settings -->
      <div class="flex flex-wrap items-center gap-3 p-3 bg-gray-50 dark:bg-slate-900 rounded-lg mb-4">
        <input type="checkbox" id="use-proxy" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
        <label for="use-proxy" class="text-sm text-gray-700 dark:text-slate-200">Use local Holy CORS</label>
        <input
          type="url"
          id="proxy-url"
          class="min-w-48 flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm"
          placeholder="http://127.0.0.1:2345/"
          value="http://127.0.0.1:2345/"
          disabled
          aria-label="Local Holy CORS bridge URL"
        />
        <button id="proxy-info-btn" type="button" class="text-indigo-600 hover:text-indigo-800 text-sm">
          Setup instructions
        </button>
      </div>

      <!-- Tabs -->
      <div class="border-b border-gray-200 dark:border-slate-700 mb-4">
        <nav class="flex gap-4">
          <button class="tab-btn active pb-2 border-b-2 border-indigo-600 text-indigo-600 font-medium text-sm" data-tab="headers">Headers</button>
          <button class="tab-btn pb-2 border-b-2 border-transparent text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:text-slate-200 font-medium text-sm" data-tab="body">Body</button>
          <button class="tab-btn pb-2 border-b-2 border-transparent text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:text-slate-200 font-medium text-sm" data-tab="params">Query Params</button>
        </nav>
      </div>

      <!-- Headers Tab -->
      <div id="headers-tab" class="tab-content">
        <div id="headers-list" class="space-y-2">
          <div class="header-row flex gap-2">
            <input type="text" class="header-key flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Header name" value="Content-Type" />
            <input type="text" class="header-value flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Header value" value="application/json" />
            <button class="remove-header-btn p-2 text-red-500 hover:bg-red-50 rounded">×</button>
          </div>
        </div>
        <button id="add-header-btn" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">+ Add Header</button>
      </div>

      <!-- Body Tab -->
      <div id="body-tab" class="tab-content hidden">
        <div class="flex gap-4 mb-2">
          <label class="inline-flex items-center text-sm">
            <input type="radio" name="body-type" value="json" checked class="text-indigo-600 focus:ring-indigo-500" />
            <span class="ml-1">JSON</span>
          </label>
          <label class="inline-flex items-center text-sm">
            <input type="radio" name="body-type" value="form" class="text-indigo-600 focus:ring-indigo-500" />
            <span class="ml-1">Form Data</span>
          </label>
          <label class="inline-flex items-center text-sm">
            <input type="radio" name="body-type" value="raw" class="text-indigo-600 focus:ring-indigo-500" />
            <span class="ml-1">Raw</span>
          </label>
        </div>
        <textarea
          id="body-input"
          data-share-key="body"
          class="w-full h-32 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm resize-none"
          placeholder='{"key": "value"}'
        ></textarea>
      </div>

      <!-- Params Tab -->
      <div id="params-tab" class="tab-content hidden">
        <div id="params-list" class="space-y-2">
          <div class="param-row flex gap-2">
            <input type="text" class="param-key flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Parameter name" />
            <input type="text" class="param-value flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Parameter value" />
            <button class="remove-param-btn p-2 text-red-500 hover:bg-red-50 rounded">×</button>
          </div>
        </div>
        <button id="add-param-btn" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">+ Add Parameter</button>
      </div>
    </div>

    <!-- Response -->
    <div id="response-section" class="hidden">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200">Response</h3>
          <div class="flex items-center gap-4 text-sm">
            <span id="status-badge" class="px-2 py-1 rounded font-medium"></span>
            <span id="response-time" class="text-gray-500 dark:text-slate-400"></span>
            <span id="response-size" class="text-gray-500 dark:text-slate-400"></span>
          </div>
        </div>

        <!-- Response Tabs -->
        <div class="border-b border-gray-200 dark:border-slate-700 mb-4">
          <nav class="flex gap-4">
            <button class="resp-tab-btn active pb-2 border-b-2 border-indigo-600 text-indigo-600 font-medium text-sm" data-tab="resp-body">Body</button>
            <button class="resp-tab-btn pb-2 border-b-2 border-transparent text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:text-slate-200 font-medium text-sm" data-tab="resp-headers">Headers</button>
          </nav>
        </div>

        <div id="resp-body-tab" class="resp-tab-content">
          <div class="flex justify-end gap-2 mb-2">
            <button id="prettify-btn" class="text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded">Prettify</button>
            <button id="copy-response-btn" class="text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded">Copy</button>
          </div>
          <pre id="response-body" class="p-3 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-200 dark:border-slate-700 font-mono text-sm overflow-auto max-h-96"></pre>
        </div>

        <div id="resp-headers-tab" class="resp-tab-content hidden">
          <div id="response-headers" class="space-y-1 font-mono text-sm"></div>
        </div>
      </div>
    </div>

    <!-- Error -->
    <div id="error-box" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>

    <LocalBridgeAccessDialog directOption="If the API allows browser requests, turn off Holy CORS and send directly." />

    <!-- Proxy Setup Modal -->
    <div id="proxy-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4 p-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-4">Connect through Holy CORS</h3>
        <div class="space-y-4 text-sm text-gray-600 dark:text-slate-300">
          <p>If an API does not allow browser requests, run <a href="https://github.com/bugdays-com/holy-cors" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline">Holy CORS</a> on your computer:</p>
          <div class="bg-gray-800 text-green-400 p-3 rounded-lg font-mono text-xs overflow-auto">
            <p class="text-gray-400"># macOS (Homebrew)</p>
            <p>brew trust bugdays-com/tap</p>
            <p>brew install bugdays-com/tap/holy-cors</p>
            <p>holy-cors</p>
          </div>
          <p>On Windows or Linux, <a href="https://github.com/bugdays-com/holy-cors/releases/latest" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline">download the Holy CORS binary</a> and run it locally.</p>
          <p>Or use Docker:</p>
          <code class="block break-all rounded-lg bg-gray-800 p-3 text-xs text-green-400">docker run --rm -p 127.0.0.1:2345:2345 ghcr.io/bugdays-com/holy-cors:latest</code>
          <p>Leave the bridge URL at <code class="bg-gray-100 dark:bg-slate-700 px-1 rounded">http://127.0.0.1:2345/</code>. If your target API runs on your computer and Holy CORS runs in Docker, use <code>host.docker.internal</code> in the target URL instead of <code>localhost</code>. On Linux, add <code>--add-host=host.docker.internal:host-gateway</code> to the Docker command if needed.</p>
          <p>Holy CORS runs on your computer. Requests are not sent to or stored by Bug Days.</p>
          <p>When the target API already permits browser requests, you can leave Holy CORS off.</p>
        </div>
        <button id="close-modal-btn" class="mt-4 px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300">Close</button>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online API Client</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Test REST APIs directly from your browser. Supports GET, POST, PUT, PATCH, DELETE requests with
        custom headers and body. If an API blocks browser requests, the optional Holy CORS bridge runs on your computer.
      </p>
    </div>
  </div>
</Layout>

<style>
  .tab-btn.active {
    border-color: #4f46e5;
    color: #4f46e5;
  }
  .resp-tab-btn.active {
    border-color: #4f46e5;
    color: #4f46e5;
  }
</style>

<script>
  import { createLocalBridgeAccessGuard } from '../lib/local-bridge-access';

  const methodSelect = document.getElementById('method') as HTMLSelectElement;
  const urlInput = document.getElementById('url-input') as HTMLInputElement;
  const useProxy = document.getElementById('use-proxy') as HTMLInputElement;
  const proxyUrl = document.getElementById('proxy-url') as HTMLInputElement;
  const bodyInput = document.getElementById('body-input') as HTMLTextAreaElement;
  const responseSection = document.getElementById('response-section');
  const responseBody = document.getElementById('response-body');
  const responseHeaders = document.getElementById('response-headers');
  const statusBadge = document.getElementById('status-badge');
  const responseTime = document.getElementById('response-time');
  const responseSize = document.getElementById('response-size');
  const errorBox = document.getElementById('error-box');
  const proxyModal = document.getElementById('proxy-modal');
  const confirmLocalBridgeAccess = createLocalBridgeAccessGuard();

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      btn.classList.add('active');
      const tabId = (btn as HTMLElement).dataset.tab + '-tab';
      document.getElementById(tabId)?.classList.remove('hidden');
    });
  });

  document.querySelectorAll('.resp-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.resp-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.resp-tab-content').forEach(c => c.classList.add('hidden'));
      btn.classList.add('active');
      const tabId = (btn as HTMLElement).dataset.tab + '-tab';
      document.getElementById(tabId)?.classList.remove('hidden');
    });
  });

  // Proxy toggle
  useProxy.addEventListener('change', () => {
    proxyUrl.disabled = !useProxy.checked;
  });

  // Add header row
  document.getElementById('add-header-btn')?.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'header-row flex gap-2';
    row.innerHTML = `
      <input type="text" class="header-key flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Header name" />
      <input type="text" class="header-value flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Header value" />
      <button class="remove-header-btn p-2 text-red-500 hover:bg-red-50 rounded">×</button>
    `;
    document.getElementById('headers-list')?.appendChild(row);
    attachRemoveHandler(row.querySelector('.remove-header-btn'));
  });

  // Add param row
  document.getElementById('add-param-btn')?.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'param-row flex gap-2';
    row.innerHTML = `
      <input type="text" class="param-key flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Parameter name" />
      <input type="text" class="param-value flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded text-sm" placeholder="Parameter value" />
      <button class="remove-param-btn p-2 text-red-500 hover:bg-red-50 rounded">×</button>
    `;
    document.getElementById('params-list')?.appendChild(row);
    attachRemoveHandler(row.querySelector('.remove-param-btn'));
  });

  function attachRemoveHandler(btn: Element | null) {
    btn?.addEventListener('click', () => {
      btn.parentElement?.remove();
    });
  }

  // Initial remove handlers
  document.querySelectorAll('.remove-header-btn, .remove-param-btn').forEach(attachRemoveHandler);

  // Get headers from UI
  function getHeaders(): Record<string, string> {
    const headers: Record<string, string> = {};
    document.querySelectorAll('.header-row').forEach(row => {
      const key = (row.querySelector('.header-key') as HTMLInputElement)?.value.trim();
      const value = (row.querySelector('.header-value') as HTMLInputElement)?.value.trim();
      if (key) headers[key] = value;
    });
    return headers;
  }

  // Get params from UI
  function getParams(): URLSearchParams {
    const params = new URLSearchParams();
    document.querySelectorAll('.param-row').forEach(row => {
      const key = (row.querySelector('.param-key') as HTMLInputElement)?.value.trim();
      const value = (row.querySelector('.param-value') as HTMLInputElement)?.value.trim();
      if (key) params.append(key, value);
    });
    return params;
  }

  // Send request
  async function sendRequest() {
    let url = urlInput.value.trim();
    if (!url) {
      showError('Please enter a URL');
      return;
    }

    // Add query params
    const params = getParams();
    if (params.toString()) {
      url += (url.includes('?') ? '&' : '?') + params.toString();
    }

    // Use proxy if enabled
    if (useProxy.checked) {
      const proxy = proxyUrl.value.trim();
      try {
        const bridge = new URL(proxy);
        const endpoint = new URL(url);
        if (!['http:', 'https:'].includes(bridge.protocol) || !['http:', 'https:'].includes(endpoint.protocol)) throw new Error();
      } catch {
        showError('Enter complete http:// or https:// URLs for the Holy CORS bridge and target API.');
        return;
      }
      if (!await confirmLocalBridgeAccess(proxy)) return;
      url = `${proxy.replace(/\/+$/, '')}/${url}`;
    }

    const method = methodSelect.value;
    const headers = getHeaders();
    const bodyType = (document.querySelector('input[name="body-type"]:checked') as HTMLInputElement)?.value;

    const options: RequestInit = {
      method,
      headers,
      mode: 'cors'
    };

    // Add body for methods that support it
    if (['POST', 'PUT', 'PATCH'].includes(method) && bodyInput.value.trim()) {
      if (bodyType === 'json') {
        options.body = bodyInput.value;
      } else if (bodyType === 'form') {
        const formData = new URLSearchParams();
        try {
          const jsonBody = JSON.parse(bodyInput.value);
          Object.entries(jsonBody).forEach(([k, v]) => formData.append(k, String(v)));
          options.body = formData;
          headers['Content-Type'] = 'application/x-www-form-urlencoded';
        } catch {
          options.body = bodyInput.value;
        }
      } else {
        options.body = bodyInput.value;
      }
    }

    const startTime = performance.now();
    hideError();
    responseSection?.classList.add('hidden');

    try {
      const response = await fetch(url, options);
      const endTime = performance.now();
      const duration = Math.round(endTime - startTime);

      // Get response text
      const text = await response.text();
      const size = new Blob([text]).size;

      // Update UI
      responseSection?.classList.remove('hidden');

      // Status badge
      const statusCode = response.status;
      let statusClass = 'bg-green-100 text-green-800';
      if (statusCode >= 400) statusClass = 'bg-red-100 text-red-800';
      else if (statusCode >= 300) statusClass = 'bg-yellow-100 text-yellow-800';

      statusBadge.className = `px-2 py-1 rounded font-medium ${statusClass}`;
      statusBadge.textContent = `${statusCode} ${response.statusText}`;
      responseTime.textContent = `${duration}ms`;
      responseSize.textContent = formatBytes(size);

      // Response body
      responseBody.textContent = text;

      // Response headers
      let headersHtml = '';
      response.headers.forEach((value, key) => {
        headersHtml += `<div><span class="text-gray-500 dark:text-slate-400">${key}:</span> ${value}</div>`;
      });
      responseHeaders.innerHTML = headersHtml;
    } catch (e) {
      const errorMsg = (e as Error).message;
      const isNetworkFailure = errorMsg.includes('Failed to fetch') || errorMsg.includes('NetworkError') || errorMsg.includes('Load failed');

      if (isNetworkFailure && !useProxy.checked) {
        showError(
          `The browser could not reach this API. The service may be offline, its URL or TLS configuration may be wrong, or its CORS policy may block browser requests.\n\n` +
          `If it works in a desktop client, enable local Holy CORS above and retry. Open Setup instructions to install the bridge.`
        );
      } else if (isNetworkFailure && useProxy.checked) {
        showError(
          `Could not reach Holy CORS or the target API. Check that Holy CORS is running at ${proxyUrl.value.trim()}, the target URL is correct, and your browser allows local access for bugdays.com. Then retry.`
        );
      } else {
        showError('Request failed: ' + errorMsg);
      }
    }
  }

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function hideError() {
    errorBox.classList.add('hidden');
  }

  document.getElementById('send-btn')?.addEventListener('click', sendRequest);

  // Prettify JSON
  document.getElementById('prettify-btn')?.addEventListener('click', () => {
    try {
      const json = JSON.parse(responseBody.textContent || '');
      responseBody.textContent = JSON.stringify(json, null, 2);
    } catch {
      // Not JSON, ignore
    }
  });

  // Copy response
  document.getElementById('copy-response-btn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(responseBody.textContent || '');
  });

  // Proxy modal
  document.getElementById('proxy-info-btn')?.addEventListener('click', () => {
    proxyModal?.classList.remove('hidden');
  });

  document.getElementById('close-modal-btn')?.addEventListener('click', () => {
    proxyModal?.classList.add('hidden');
  });

  proxyModal?.addEventListener('click', (e) => {
    if (e.target === proxyModal) proxyModal.classList.add('hidden');
  });

  // Enter key to send
  urlInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendRequest();
  });

  import { ShareManager } from '../lib/share';
  ShareManager.register({
    tool: 'api-client',
    actions: {
      send: () => {} // Don't auto-send on load - just populate fields
    }
  });
</script>

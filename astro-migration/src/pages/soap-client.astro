---
import Layout from '../layouts/Layout.astro';
import LocalBridgeAccessDialog from '../components/LocalBridgeAccessDialog.astro';

const starterEnvelope = `<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header/>
  <soap:Body>
    <!-- Add your operation and parameters here -->
  </soap:Body>
</soap:Envelope>`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'SOAP API Client - Online WSDL Tester',
    description: 'Browser SOAP client with WSDL and XSD imports, schema-based request generation, WS-Security UsernameToken, local saved requests, and response inspection.',
    url: 'https://bugdays.com/soap-client/',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'WSDL parsing and operation discovery',
      'Direct SOAP request mode',
      'SOAP 1.1 and SOAP 1.2 support',
      'Generated XML request envelopes',
      'Nested XSD types, imports, document and RPC bindings',
      'WS-Security UsernameToken with password text or digest',
      'Local saved requests and opt-in history',
      'Basic authentication and custom HTTP headers',
      'Response body, headers, timing, and SOAP Fault inspection',
      'WSDL service port and binding selection',
      'SOAP envelope validation and cancellable requests',
      'Shareable requests without auth fields or SOAP headers',
      'Private direct-to-endpoint requests',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Can I send a SOAP request without a WSDL?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Enter the SOAP endpoint, choose SOAP 1.1 or 1.2, paste or edit the XML envelope, and send it directly. A WSDL is optional and helps generate operations and sample envelopes.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does Bug Days receive my SOAP payload or credentials?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Requests go from your browser to your endpoint, optionally through your own local bridge. Basic and WS-Security credentials are never saved or shared; SOAP headers are stripped from saved requests and share links. Review the body before sharing because it may contain your own sensitive values.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I inspect SOAP faults even when HTTP returns 200?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. The response inspector detects SOAP 1.1 or 1.2 Fault elements inside the SOAP Body, independently of HTTP status, and displays the fault code, reason, subcodes, and detail XML. An HTTP 200 alone does not mean the operation succeeded.' },
      },
      {
        '@type': 'Question',
        name: 'Does Validate check my request against the full XSD schema?',
        acceptedAnswer: { '@type': 'Answer', text: 'Validate checks well-formed XML, a supported SOAP Envelope namespace, one Body, Header placement, and agreement with the selected SOAP version. It does not validate every business field, datatype, or WS-Security policy against XSD.' },
      },
      {
        '@type': 'Question',
        name: 'Why does my SOAP request show a CORS error?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Browsers enforce the target server’s CORS policy. If the SOAP server does not permit browser requests, use the optional Holy CORS bridge on your own machine or a desktop client for authentication methods that browsers cannot expose.',
        },
      },
    ],
  },
];
---

<Layout
  title="Online SOAP Client & WSDL Tester — Requests, Faults & Sharing"
  description="Test SOAP 1.1/1.2 APIs online. Generate XML from WSDL and XSD, choose service ports, add WS-Security, inspect SOAP faults, and share requests without auth fields."
  keywords="SOAP client, WSDL tester, SOAP request builder from WSDL, XSD import SOAP, JAX-WS SOAP client, RPC SOAP tester, WS-Security UsernameToken, SOAP 1.1, SOAP 1.2"
  breadcrumb={[{ name: 'Network Tools', href: '/network-tools/' }, { name: 'SOAP Client' }]}
  toolId="soap-client"
  jsonLd={jsonLd}
  image="/og/soap-client.png"
  imageAlt="Online SOAP client with WSDL operation browser, XML request editor, and response inspector"
  imageWidth={1280}
  imageHeight={720}
>
  <div id="soap-workspace" class="max-w-[1600px] mx-auto">
    <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-3 mb-1.5">
          <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-slate-100">Online SOAP Client &amp; WSDL Tester</h1>
        </div>
        <p class="text-sm md:text-base text-gray-600 dark:text-slate-300 max-w-4xl">
          Generate a request from WSDL or paste your own XML. Test SOAP 1.1/1.2 APIs, read fault details, and share a reproducible request.
        </p>
      </div>
    </div>

    <p class="mb-3 text-xs text-slate-500 dark:text-slate-400">No account needed. Requests go to your endpoint; auth fields and SOAP headers stay out of saves and shares.</p>

    <section class="mb-4 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
        <div class="hidden sm:block">
          <h2 class="font-semibold text-gray-800 dark:text-slate-100">Start a SOAP session</h2>
          <p class="text-xs text-gray-500 dark:text-slate-400">Use a contract for generated requests, or work directly in the editor below.</p>
        </div>
        <div class="inline-flex p-1 rounded-lg bg-slate-100 dark:bg-slate-900" role="tablist" aria-label="SOAP session mode">
          <button id="wsdl-mode-tab" type="button" role="tab" aria-selected="true" class="mode-tab px-3 py-1.5 rounded-md bg-white dark:bg-slate-700 shadow-sm text-sm font-semibold text-indigo-700 dark:text-indigo-300">Import WSDL</button>
          <button id="direct-mode-tab" type="button" role="tab" aria-selected="false" class="mode-tab px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 dark:text-slate-300">Direct request</button>
        </div>
      </div>

      <div id="wsdl-mode-panel" role="tabpanel" class="p-3 md:p-4">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] lg:flex gap-2">
          <div class="relative flex-1 min-w-0">
            <svg class="absolute left-3 top-2.5 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.8 10.2a4.5 4.5 0 0 1 0 6.4l-2 2a4.5 4.5 0 0 1-6.4-6.4l1.1-1m3.7 3.6a4.5 4.5 0 0 1 0-6.4l2-2a4.5 4.5 0 0 1 6.4 6.4l-1.1 1"/></svg>
            <input type="url" id="wsdl-url" data-share-key="wsdl" class="w-full pl-9 pr-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500" placeholder="https://service.example.com/api?wsdl" />
          </div>
          <button id="parse-wsdl-btn" type="button" class="px-3 md:px-5 py-2 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-semibold whitespace-nowrap">Load contract</button>
          <button id="toggle-wsdl-input" type="button" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-600 text-sm font-medium whitespace-nowrap">Paste / upload WSDL</button>
          <button id="load-demo-btn" type="button" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-600 text-sm font-medium whitespace-nowrap">Load demo</button>
        </div>

        <div id="wsdl-xml-input" class="hidden mt-3 p-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <label for="wsdl-xml" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">WSDL XML</label>
            <label class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-200 hover:border-indigo-400">
              Open WSDL + XSD files
              <input id="wsdl-file" type="file" multiple accept=".wsdl,.xsd,.xml,text/xml,application/xml" class="hidden" />
            </label>
          </div>
          <textarea id="wsdl-xml" class="w-full h-44 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-xs bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100 resize-y" placeholder="Paste the WSDL document here…" spellcheck="false"></textarea>
          <div class="mt-2 flex flex-wrap items-center gap-2"><button id="add-xsd-btn" type="button" class="rounded-md border border-indigo-200 px-2.5 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-50 dark:border-indigo-800 dark:text-indigo-300">+ Add pasted XSD</button><span id="local-schema-count" class="text-xs text-slate-500 dark:text-slate-400"></span></div>
          <div id="pasted-schemas" class="mt-2 space-y-2"></div>
          <button id="parse-xml-btn" type="button" class="mt-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-semibold">Use pasted contract</button>
        </div>
      </div>

      <div id="direct-mode-panel" role="tabpanel" class="hidden p-3">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-300">
          <p>No WSDL required. Paste an envelope below.</p>
          <button id="focus-endpoint-btn" type="button" class="rounded-md px-2 py-1.5 text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">Go to endpoint ↓</button>
        </div>
      </div>

      <details class="border-t border-gray-200 dark:border-slate-700">
        <summary class="px-4 py-2.5 cursor-pointer text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50">Browser blocked by CORS? Configure the optional local bridge</summary>
        <div class="px-4 pb-3 grid md:grid-cols-[auto_minmax(220px,1fr)_auto] items-center gap-3">
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-200 cursor-pointer"><input type="checkbox" id="use-proxy" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" /> Use local Holy CORS</label>
          <input type="url" id="proxy-url" class="w-full p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 disabled:opacity-60" value="http://127.0.0.1:2345/" disabled aria-label="Local Holy CORS bridge URL" />
          <button id="proxy-info-btn" type="button" class="text-indigo-600 dark:text-indigo-400 hover:underline text-sm whitespace-nowrap">Setup instructions</button>
        </div>
      </details>
    </section>

    <div id="error-box" class="hidden mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-800 dark:text-red-200 whitespace-pre-wrap break-words" role="alert"></div>
    <div id="contract-warnings" class="hidden mb-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900 dark:border-amber-900 dark:bg-amber-950/20 dark:text-amber-200" role="status"></div>
    <div id="loading" class="hidden mb-4 p-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg text-sm text-blue-800 dark:text-blue-200 flex items-center gap-2" role="status">
      <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4Zm2 5.3A8 8 0 0 1 4 12H0c0 3 1.1 5.8 3 7.9l3-2.6Z"></path></svg>
      <span id="loading-text">Loading…</span>
    </div>

    <section id="request-section" class="grid gap-4 items-start">
      <aside id="operations-section" class="hidden bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden xl:sticky xl:top-16">
        <div class="px-3 py-3 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between gap-2">
          <div>
            <h2 class="text-sm font-semibold text-gray-800 dark:text-slate-100">Service navigator</h2>
            <p id="operation-count" class="text-[11px] text-gray-500 dark:text-slate-400">Manual session</p>
          </div>
          <span id="contract-status" class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-slate-600" title="No WSDL loaded"></span>
        </div>
        <div id="contract-summary" class="hidden px-3 py-2.5 border-b border-gray-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-xs">
          <div id="service-name" class="font-semibold text-slate-800 dark:text-slate-100 truncate"></div>
          <div id="target-namespace" class="mt-1 font-mono text-[10px] text-slate-500 dark:text-slate-400 break-all max-h-10 overflow-hidden"></div>
        </div>
        <div class="p-2 border-b border-gray-200 dark:border-slate-700">
          <input id="operation-filter" type="search" class="w-full px-2.5 py-1.5 rounded-md border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-xs" placeholder="Filter operations…" aria-label="Filter WSDL operations" />
        </div>
        <label id="port-field" class="hidden block p-3 border-b border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-300">Service port / binding<select id="soap-port" aria-label="WSDL service port" class="mt-1 w-full min-w-0 rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 p-2 text-xs"></select></label>
        <div id="operations-list" class="p-2 space-y-1 max-h-44 xl:max-h-[480px] overflow-y-auto">
          <button type="button" class="w-full text-left p-2.5 rounded-lg border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-900/20">
            <span class="block text-sm font-semibold text-indigo-800 dark:text-indigo-200">Manual request</span>
            <span class="block mt-0.5 text-[11px] text-indigo-600 dark:text-indigo-400">No contract required</span>
          </button>
          <p class="px-2 py-3 text-xs leading-5 text-slate-500 dark:text-slate-400">Import a WSDL to discover operations and generate request envelopes.</p>
        </div>
      </aside>

      <div class="min-w-0 space-y-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <span id="session-mode-badge" class="px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">Manual</span>
              <h2 id="selected-operation" class="font-semibold text-gray-800 dark:text-slate-100 truncate">New SOAP request</h2>
            </div>
            <button id="share-request-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Share request ↗</button>
          </div>

          <div class="p-3 border-b border-gray-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50">
            <div class="grid grid-cols-2 lg:grid-cols-[auto_minmax(240px,1fr)_120px_108px_auto] gap-2 items-center">
              <span class="hidden lg:block px-3 py-2 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-sm font-bold text-center">POST</span>
              <input type="url" id="endpoint-url" data-share-key="endpoint" class="col-span-2 lg:col-span-1 w-full min-w-0 px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500" placeholder="https://service.example.com/soap" aria-label="SOAP endpoint URL" />
              <select id="soap-version" data-share-key="version" class="w-full px-2 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100" aria-label="SOAP version"><option value="1.1">SOAP 1.1</option><option value="1.2">SOAP 1.2</option></select>
              <select id="request-timeout" class="w-full px-2 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100" aria-label="Request timeout"><option value="15000">15 sec</option><option value="30000" selected>30 sec</option><option value="60000">60 sec</option><option value="0">No timeout</option></select>
              <button id="send-btn" type="button" data-share-action="send" class="col-span-2 lg:col-span-1 px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-50 transition-colors font-semibold whitespace-nowrap inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 14-7-4 14-3-5-7-2Z"/></svg> Send
              </button>
            </div>
            <div class="mt-2 flex flex-wrap items-center justify-between gap-2"><span class="text-[11px] text-slate-500 dark:text-slate-400">Share the endpoint and body; auth fields and SOAP headers are excluded. Review body values first.</span><button id="cancel-request-btn" type="button" class="hidden rounded-md border border-slate-300 dark:border-slate-600 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:border-indigo-400">Cancel request</button></div>
          </div>

          <details id="request-options" class="border-b border-gray-200 dark:border-slate-700">
            <summary class="px-4 py-2.5 cursor-pointer text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50">Authentication, WS-Security, SOAPAction, and HTTP headers</summary>
            <div class="px-4 pb-4 grid md:grid-cols-2 gap-3">
              <label class="text-xs font-medium text-gray-600 dark:text-slate-300">SOAPAction
                <input type="text" id="soap-action" data-share-key="soapAction" class="mt-1 w-full p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-xs bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100" placeholder="Auto-detected from WSDL, or enter manually" />
              </label>
              <label class="text-xs font-medium text-gray-600 dark:text-slate-300">Authentication
                <select id="auth-type" class="mt-1 w-full p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100"><option value="none">None</option><option value="basic">HTTP Basic</option><option value="wsse-text">WS-Security PasswordText</option><option value="wsse-digest">WS-Security PasswordDigest</option></select>
              </label>
              <div id="basic-auth-fields" class="hidden md:col-span-2 grid sm:grid-cols-2 gap-3 p-3 rounded-lg border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/20">
                <label class="text-xs font-medium text-amber-900 dark:text-amber-100">Username<input id="auth-username" type="text" autocomplete="off" class="mt-1 w-full p-2 border border-amber-300 dark:border-amber-800 rounded-lg bg-white dark:bg-slate-950 text-sm text-gray-900 dark:text-slate-100" /></label>
                <label class="text-xs font-medium text-amber-900 dark:text-amber-100">Password<input id="auth-password" type="password" autocomplete="new-password" class="mt-1 w-full p-2 border border-amber-300 dark:border-amber-800 rounded-lg bg-white dark:bg-slate-950 text-sm text-gray-900 dark:text-slate-100" /></label>
                <p id="auth-help" class="sm:col-span-2 text-[11px] text-amber-800 dark:text-amber-200">Stored only in this page’s memory. The browser may trigger a CORS preflight when Authorization is present.</p>
              </div>
              <label class="md:col-span-2 text-xs font-medium text-gray-600 dark:text-slate-300">Additional HTTP headers <span class="font-normal text-gray-400">(one per line)</span>
                <textarea id="custom-headers" class="mt-1 w-full h-20 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-xs bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100 resize-y" placeholder="X-Correlation-ID: test-001&#10;Accept-Language: en-US" spellcheck="false"></textarea>
              </label>
            </div>
          </details>

          <div class="grid lg:grid-cols-2 min-w-0">
            <section class="min-w-0 border-b lg:border-b-0 lg:border-r border-gray-200 dark:border-slate-700">
              <div class="px-3 py-2 flex flex-wrap items-center justify-between gap-2 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700">
                <div><h3 class="text-sm font-semibold text-gray-800 dark:text-slate-100">Request</h3><p id="request-content-type" class="text-[10px] font-mono text-slate-500 dark:text-slate-400">text/xml; charset=utf-8</p></div>
                <div class="flex flex-wrap gap-1.5"><button id="validate-request-btn" data-share-action="validate" type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium hover:border-indigo-400">Validate</button><button id="format-request-btn" type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium hover:border-indigo-400">Format XML</button><button id="copy-request-btn" type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium hover:border-indigo-400">Copy</button></div>
              </div>
              <textarea id="request-xml" data-share-key="request" class="block w-full h-80 lg:h-[420px] p-4 border-0 font-mono text-[13px] leading-5 bg-white dark:bg-slate-950 text-gray-900 dark:text-slate-100 resize-y focus:ring-2 focus:ring-inset focus:ring-indigo-500" spellcheck="false" wrap="off" aria-label="SOAP request XML">{starterEnvelope}</textarea>
              <div class="flex flex-wrap justify-between gap-2 border-t border-slate-200 dark:border-slate-700 px-3 py-2 text-[11px] text-slate-500 dark:text-slate-400"><span id="request-validation" role="status">Validate envelope structure and SOAP version before sending.</span><button id="regenerate-request-btn" type="button" class="hidden font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Reset to WSDL template</button></div>
            </section>

            <section id="response-section" class="min-w-0">
              <div class="px-3 py-2 flex flex-wrap items-center justify-between gap-2 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700">
                <div class="flex flex-wrap items-center gap-2"><h3 class="text-sm font-semibold text-gray-800 dark:text-slate-100">Response</h3><span id="status-badge" class="hidden px-2 py-0.5 rounded text-[11px] font-semibold"></span><span id="response-time" class="text-[11px] text-gray-500 dark:text-slate-400"></span><span id="response-size" class="text-[11px] text-gray-500 dark:text-slate-400"></span></div>
                <div class="flex flex-wrap gap-1.5"><button id="format-response-btn" disabled type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium disabled:opacity-40 hover:border-indigo-400">Readable</button><button id="raw-response-btn" disabled type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium disabled:opacity-40 hover:border-indigo-400">Raw</button><button id="copy-response-btn" disabled type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium disabled:opacity-40 hover:border-indigo-400">Copy</button><button id="download-response-btn" disabled type="button" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-medium disabled:opacity-40 hover:border-indigo-400">Download</button></div>
              </div>
              <div id="response-empty" class="h-44 lg:h-[450px] flex flex-col items-center justify-center p-5 text-center bg-slate-50/50 dark:bg-slate-950 text-slate-500 dark:text-slate-400">
                <svg class="w-11 h-11 mb-3 text-slate-300 dark:text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9h8m-8 4h5m8-1a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                <p class="font-medium text-slate-600 dark:text-slate-300">Response inspector</p><p class="mt-1 text-xs max-w-xs">Status, elapsed time, payload size, body, and HTTP headers will appear here after you send.</p>
              </div>
              <div id="response-content" class="hidden">
                <div id="response-checks" class="flex flex-wrap gap-2 border-b border-slate-200 dark:border-slate-700 px-3 py-2 text-[11px]" role="status"></div>
                <details id="soap-fault" class="hidden border-b border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/20 p-3" open><summary class="cursor-pointer text-sm font-semibold text-red-800 dark:text-red-200">SOAP fault details</summary><dl id="fault-summary" class="mt-2 space-y-2 break-words text-xs text-red-900 dark:text-red-100"></dl><pre id="fault-detail" class="mt-2 max-h-36 overflow-auto whitespace-pre-wrap break-words font-mono text-xs text-red-900 dark:text-red-100"></pre></details>
                <div class="flex border-b border-gray-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50" role="tablist" aria-label="Response views"><button id="response-body-tab" type="button" class="response-tab px-4 py-2 text-xs font-semibold text-indigo-700 dark:text-indigo-300 border-b-2 border-indigo-600" aria-selected="true">Body</button><button id="response-headers-tab" type="button" class="response-tab px-4 py-2 text-xs font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent" aria-selected="false">Headers</button></div>
                <pre id="response-body" class="h-80 lg:h-[360px] p-4 bg-white dark:bg-slate-950 font-mono text-[13px] leading-5 overflow-auto whitespace-pre-wrap break-words text-gray-900 dark:text-slate-100"></pre>
                <pre id="response-headers" class="hidden h-80 lg:h-[360px] p-4 bg-white dark:bg-slate-950 font-mono text-xs leading-5 overflow-auto whitespace-pre-wrap break-words text-gray-900 dark:text-slate-100"></pre>
              </div>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-4 grid gap-3 md:grid-cols-2" aria-label="Saved SOAP requests and history">
      <div class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Saved requests</h2><div class="flex gap-2"><button id="save-request-btn" type="button" class="rounded-md bg-indigo-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">Save current</button><button id="clear-saved-btn" type="button" class="text-xs text-slate-500 hover:underline">Clear</button></div></div><p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Stored in this browser without auth fields or SOAP headers. Check endpoint and body values.</p><div id="saved-list" class="mt-2 max-h-44 space-y-1 overflow-y-auto text-xs text-slate-500 dark:text-slate-400">Nothing saved yet.</div></div>
      <div class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Local history</h2><button id="clear-history-btn" type="button" class="text-xs text-slate-500 hover:underline">Clear</button></div><label class="mt-1 flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-300"><input id="save-history" type="checkbox" class="rounded border-slate-300 text-indigo-600" /> Keep sanitized request history in this browser</label><div id="history-list" class="mt-2 max-h-44 space-y-1 overflow-y-auto text-xs text-slate-500 dark:text-slate-400">No requests yet.</div></div>
    </section>

    <section class="mt-8 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-4">An online SOAP client for focused request debugging</h2>
      <div class="grid md:grid-cols-3 gap-6 text-sm text-gray-600 dark:text-slate-300">
        <div><h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Contract-driven when available</h3><p>Import WSDL from a URL, local file, or pasted XML. Browse operations and start from generated envelopes, endpoint addresses, namespaces, and SOAPAction values.</p></div>
        <div><h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Manual when it isn’t</h3><p>A WSDL is optional. Direct mode keeps the endpoint, version, headers, authentication, request XML, and response inspector in one working surface.</p></div>
        <div><h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Browser connection notes</h3><p>Target servers must permit browser CORS requests, or you can use the local Holy CORS bridge. UsernameToken is supported here; mTLS, NTLM/Kerberos, and client certificates still need an approved desktop or internal enterprise client.</p></div>
      </div>
      <div class="mt-5 p-3 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-300">
        <strong>Request path:</strong> Browser → your SOAP endpoint. When enabled, the path is Browser → Holy CORS on your computer → your SOAP endpoint. Normal requests are not relayed through Bug Days infrastructure.
      </div>
      <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700 grid md:grid-cols-2 gap-6 text-sm text-gray-600 dark:text-slate-300">
        <div><h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">WSDL tester or direct SOAP request</h3><p>Load a WSDL when you want service names, ports, operations, endpoint addresses, namespaces, SOAPAction values, and starter envelopes. Switch to direct mode when you already have the endpoint and XML body or when a contract URL is unavailable.</p></div>
        <div><h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">SOAP 1.1 versus SOAP 1.2</h3><p>SOAP 1.1 commonly sends <code class="text-xs">text/xml</code> plus a separate <code class="text-xs">SOAPAction</code> header. SOAP 1.2 uses <code class="text-xs">application/soap+xml</code> and can carry the action as a content-type parameter. Choosing the matching version avoids many otherwise opaque HTTP 415 and action-routing failures.</p></div>
      </div>
      <p class="mt-5 text-sm text-gray-600 dark:text-slate-300">Need a walkthrough? Read <a href="/guides/test-soap-api-from-wsdl-soap-11-vs-12/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">how to test a SOAP API from WSDL and choose SOAP 1.1 or 1.2</a>, then use the <a href="/guides/soap-api-authentication-basic-ws-security-mtls/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">SOAP authentication guide</a> to distinguish Basic auth, WS-Security, and mTLS. Useful companions include the <a href="/certificate-inspector/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">X.509 certificate decoder</a>, <a href="/xml-formatter/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">XML formatter</a>, and <a href="/bulk-api-invoker/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">CSV bulk API runner</a>.</p>
      <div class="mt-6 grid gap-5 md:grid-cols-2 text-sm text-gray-600 dark:text-slate-300">
        <div><h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Inspect a SOAP fault, not just an HTTP status</h3><p>SOAP 1.1 faults expose <code>faultcode</code> and <code>faultstring</code>; SOAP 1.2 uses Code, nested Subcode, and multilingual Reason fields. The inspector pulls these out with the detail XML, even when the server returns HTTP 200. Response checks distinguish HTTP success, a SOAP envelope, and absence of a SOAP fault; they do not certify business success.</p></div>
        <div><h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1">Share an editable SOAP request</h3><p>Use <strong>Share request</strong> to send a colleague your endpoint, SOAP version, action, and XML body. Auth fields, HTTP headers, and the entire SOAP Header are left out. Review body values before sharing. Opening a link restores the editor; it never sends a request automatically. Choose a self-contained URL to keep the shared state out of server storage.</p></div>
      </div>
      <h2 class="mt-6 mb-3 text-lg font-semibold text-slate-900 dark:text-slate-100">SOAP client questions</h2>
      <div class="divide-y divide-slate-200 dark:divide-slate-700">
        {jsonLd[1].mainEntity?.map(item => <details class="py-3"><summary class="cursor-pointer text-sm font-semibold text-slate-800 dark:text-slate-100">{item.name}</summary><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{item.acceptedAnswer.text}</p></details>)}
      </div>
      <div class="mt-3 text-right"><button id="inline-feedback-btn" type="button" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline">Send feedback about this SOAP client</button></div>
    </section>

    <LocalBridgeAccessDialog directOption="If the SOAP service allows browser requests, turn off Holy CORS and send directly." />

    <dialog id="proxy-modal" class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl overflow-auto rounded-xl bg-white dark:bg-slate-800 shadow-xl backdrop:bg-black/55" aria-labelledby="proxy-modal-title">
      <div class="p-5">
        <div class="flex items-start justify-between gap-4 mb-4"><div><h3 id="proxy-modal-title" class="text-lg font-semibold text-gray-800 dark:text-slate-100">Connect through Holy CORS</h3><p class="text-sm text-gray-500 dark:text-slate-400 mt-1">If a SOAP service blocks browser requests, start this small local bridge and try again.</p></div><button id="close-proxy-modal-btn" type="button" class="p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500" aria-label="Close">✕</button></div>
        <div class="space-y-4 text-sm text-gray-600 dark:text-slate-300">
          <p class="font-medium text-gray-800 dark:text-slate-100">1. Start Holy CORS:</p>
          <div class="bg-slate-950 text-emerald-300 p-3 rounded-lg font-mono text-xs overflow-auto"><p class="text-slate-400"># macOS (trust the Bug Days tap once)</p><p>brew trust bugdays-com/tap</p><p>brew install bugdays-com/tap/holy-cors</p><p>holy-cors</p></div>
          <p>On Windows or Linux, <a href="https://github.com/bugdays-com/holy-cors/releases/latest" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">download the Holy CORS binary</a> and run it locally.</p>
          <p>Or use Docker:</p>
          <code class="block break-all rounded-lg bg-slate-950 p-3 text-xs text-emerald-300">docker run --rm -p 127.0.0.1:2345:2345 ghcr.io/bugdays-com/holy-cors:latest</code>
          <p><span class="font-medium text-gray-800 dark:text-slate-100">2. Come back and retry your request.</span> Leave the bridge URL set to <code class="bg-gray-100 dark:bg-slate-700 px-1 rounded">http://127.0.0.1:2345/</code>. If the SOAP service runs on your computer and Holy CORS runs in Docker, use <code>host.docker.internal</code> in the endpoint URL instead of <code>localhost</code>. On Linux, add <code>--add-host=host.docker.internal:host-gateway</code> to the Docker command if needed.</p>
          <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-800 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-900">
            Holy CORS runs on your computer. Your request is not sent to or stored by Bug Days.
          </div>
          <p class="text-xs text-gray-500 dark:text-slate-400">Want the details? <a href="https://github.com/bugdays-com/holy-cors" target="_blank" rel="noopener" class="text-indigo-600 dark:text-indigo-400 hover:underline">View Holy CORS on GitHub</a>.</p>
        </div>
      </div>
    </dialog>

    <div id="soap-toast" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 w-max max-w-[calc(100%-2rem)] px-4 py-2.5 rounded-lg bg-slate-900 text-white shadow-xl text-sm" role="status" aria-live="polite"></div>
  </div>
</Layout>

<style is:global>
  body[data-tool-id='soap-client'] #share-btn-floating,
  body[data-tool-id='soap-client'] #feedback-btn {
    display: none;
  }
</style>

<script>
  import { track } from '../lib/analytics.ts';
  import { ShareManager } from '../lib/share.ts';
  import { createLocalBridgeAccessGuard } from '../lib/local-bridge-access.ts';
  import { parseSoapContract, selectSoapPort, generateSoapRequest, type SoapContract, type LocalSoapDocument } from '../lib/soap-wsdl.ts';
  import { usernameTokenRequest, requestWithoutSoapHeader } from '../lib/soap-security.ts';
  import { changeSoapVersion, soapEnvelope, readableSoapXml, inspectSoapResponse, readSoapBody, type SoapVersion } from '../lib/soap-messages.ts';

  function initSoapClient(): void {
  const workspace = document.getElementById('soap-workspace');
  if (!workspace || workspace.dataset.init) return;
  workspace.dataset.init = 'true';

  const DEMO_WSDL = `<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="https://example.com/customer" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="https://example.com/customer" name="CustomerDirectory">
  <types><xsd:schema targetNamespace="https://example.com/customer"><xsd:element name="GetCustomer"><xsd:complexType><xsd:sequence><xsd:element name="customerId" type="xsd:string"/></xsd:sequence></xsd:complexType></xsd:element></xsd:schema></types>
  <message name="GetCustomerRequest"><part name="parameters" element="tns:GetCustomer"/></message>
  <message name="GetCustomerResponse"><part name="parameters" element="tns:GetCustomerResponse"/></message>
  <portType name="CustomerDirectoryPortType"><operation name="GetCustomer"><input message="tns:GetCustomerRequest"/><output message="tns:GetCustomerResponse"/></operation></portType>
  <binding name="CustomerDirectoryBinding" type="tns:CustomerDirectoryPortType"><soap:binding transport="http://schemas.xmlsoap.org/soap/http"/><operation name="GetCustomer"><soap:operation soapAction="https://example.com/customer/GetCustomer"/></operation></binding>
  <service name="CustomerDirectory"><port name="CustomerDirectoryPort" binding="tns:CustomerDirectoryBinding"><soap:address location="https://api.example.com/customer-service"/></port></service>
</definitions>`;

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const wsdlUrlInput = byId<HTMLInputElement>('wsdl-url');
  const wsdlXmlInput = byId<HTMLTextAreaElement>('wsdl-xml');
  const wsdlFileInput = byId<HTMLInputElement>('wsdl-file');
  const parseWsdlBtn = byId<HTMLButtonElement>('parse-wsdl-btn');
  const parseXmlBtn = byId<HTMLButtonElement>('parse-xml-btn');
  const wsdlModeTab = byId<HTMLButtonElement>('wsdl-mode-tab');
  const directModeTab = byId<HTMLButtonElement>('direct-mode-tab');
  const wsdlModePanel = byId<HTMLElement>('wsdl-mode-panel');
  const directModePanel = byId<HTMLElement>('direct-mode-panel');
  const wsdlXmlSection = byId<HTMLElement>('wsdl-xml-input');
  const operationsList = byId<HTMLElement>('operations-list');
  const operationFilter = byId<HTMLInputElement>('operation-filter');
  const selectedOperationEl = byId<HTMLElement>('selected-operation');
  const endpointUrlInput = byId<HTMLInputElement>('endpoint-url');
  const soapActionInput = byId<HTMLInputElement>('soap-action');
  const soapVersionSelect = byId<HTMLSelectElement>('soap-version');
  const timeoutSelect = byId<HTMLSelectElement>('request-timeout');
  const requestXmlInput = byId<HTMLTextAreaElement>('request-xml');
  const responseBody = byId<HTMLElement>('response-body');
  const responseHeaders = byId<HTMLElement>('response-headers');
  const responseEmpty = byId<HTMLElement>('response-empty');
  const responseContent = byId<HTMLElement>('response-content');
  const statusBadge = byId<HTMLElement>('status-badge');
  const responseTime = byId<HTMLElement>('response-time');
  const responseSize = byId<HTMLElement>('response-size');
  const errorBox = byId<HTMLElement>('error-box');
  const loadingEl = byId<HTMLElement>('loading');
  const loadingText = byId<HTMLElement>('loading-text');
  const useProxyCheckbox = byId<HTMLInputElement>('use-proxy');
  const proxyUrlInput = byId<HTMLInputElement>('proxy-url');
  const proxyModal = byId<HTMLDialogElement>('proxy-modal');
  const confirmLocalBridgeAccess = createLocalBridgeAccessGuard();
  const authType = byId<HTMLSelectElement>('auth-type');
  const authUsername = byId<HTMLInputElement>('auth-username');
  const authPassword = byId<HTMLInputElement>('auth-password');
  const basicAuthFields = byId<HTMLElement>('basic-auth-fields');
  const customHeadersInput = byId<HTMLTextAreaElement>('custom-headers');
  const toast = byId<HTMLElement>('soap-toast');

  let parsedWsdl: SoapContract | null = null;
  let selectedOperation = '';
  let lastResponseText = '';
  let hasResponse = false;
  let responseView: 'body' | 'headers' = 'body';
  let requestController: AbortController | null = null;
  let requestRevision = 0;
  let contractController: AbortController | null = null;
  let disposed = false;
  let generatedRequest = requestXmlInput.value;
  let toastTimer = 0;
  let localSchemas: LocalSoapDocument[] = [];
  const SAVED_KEY = 'bugdays-soap-saved-v1';
  const HISTORY_KEY = 'bugdays-soap-history-v1';

  function setMode(mode: 'wsdl' | 'direct'): void {
    const wsdl = mode === 'wsdl';
    wsdlModePanel.classList.toggle('hidden', !wsdl);
    directModePanel.classList.toggle('hidden', wsdl);
    wsdlModeTab.setAttribute('aria-selected', String(wsdl));
    directModeTab.setAttribute('aria-selected', String(!wsdl));
    wsdlModeTab.className = `mode-tab px-3 py-1.5 rounded-md text-sm ${wsdl ? 'bg-white dark:bg-slate-700 shadow-sm font-semibold text-indigo-700 dark:text-indigo-300' : 'font-medium text-slate-600 dark:text-slate-300'}`;
    directModeTab.className = `mode-tab px-3 py-1.5 rounded-md text-sm ${!wsdl ? 'bg-white dark:bg-slate-700 shadow-sm font-semibold text-indigo-700 dark:text-indigo-300' : 'font-medium text-slate-600 dark:text-slate-300'}`;
    if (!wsdl) setManualSession(false);
    byId<HTMLElement>('operations-section').classList.toggle('hidden', !wsdl || !parsedWsdl);
    byId<HTMLElement>('request-section').classList.toggle('xl:grid-cols-[240px_minmax(0,1fr)]', wsdl && !!parsedWsdl);
  }

  function setManualSession(focusEndpoint = true): void {
    selectedOperation = '';
    byId<HTMLElement>('regenerate-request-btn').classList.add('hidden');
    selectedOperationEl.textContent = 'New SOAP request';
    byId<HTMLElement>('session-mode-badge').textContent = 'Manual';
    byId<HTMLElement>('session-mode-badge').className = 'px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-[11px] font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300';
    if (focusEndpoint) endpointUrlInput.focus();
  }

  function showToast(message: string, isError = false): void {
    window.clearTimeout(toastTimer);
    toast.textContent = message;
    toast.classList.toggle('bg-red-700', isError);
    toast.classList.toggle('bg-slate-900', !isError);
    toast.classList.remove('hidden');
    toastTimer = window.setTimeout(() => toast.classList.add('hidden'), 2600);
  }

  function showError(message: string): void {
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function hideError(): void {
    errorBox.classList.add('hidden');
    errorBox.textContent = '';
  }

  function showLoading(message: string): void {
    loadingText.textContent = message;
    loadingEl.classList.remove('hidden');
  }

  function hideLoading(): void {
    loadingEl.classList.add('hidden');
  }

  function validateHttpUrl(value: string, label: string): URL {
    let url: URL;
    try { url = new URL(value); } catch { throw new Error(`${label} must be a complete http:// or https:// URL.`); }
    if (!['http:', 'https:'].includes(url.protocol)) throw new Error(`${label} must use http:// or https://.`);
    if (url.username || url.password) throw new Error(`${label} must not include user:password. Use the authentication fields instead.`);
    return url;
  }

  function requestUrl(target: string): string {
    validateHttpUrl(target, 'Endpoint');
    if (!useProxyCheckbox.checked) return target;
    const proxy = proxyUrlInput.value.trim();
    validateHttpUrl(proxy, 'Local bridge URL');
    return proxy.endsWith('/') ? proxy + target : `${proxy}/${target}`;
  }

  function collectedSchemas(): LocalSoapDocument[] {
    const pasted = Array.from(byId<HTMLElement>('pasted-schemas').querySelectorAll<HTMLElement>('[data-xsd-row]')).map((row, index) => ({
      name: (row.querySelector<HTMLInputElement>('input')?.value || `schema-${index + 1}.xsd`).trim(),
      xml: row.querySelector<HTMLTextAreaElement>('textarea')?.value || '',
    })).filter(item => item.xml.trim());
    return [...localSchemas, ...pasted];
  }

  function renderContractWarnings(extra: string[] = []): void {
    const panel = byId<HTMLElement>('contract-warnings');
    const warnings = [...new Set([...(parsedWsdl?.warnings || []), ...extra])];
    panel.replaceChildren();
    panel.classList.toggle('hidden', !warnings.length);
    if (!warnings.length) return;
    const heading = document.createElement('strong');
    heading.textContent = `${warnings.length} contract note${warnings.length === 1 ? '' : 's'} — review the generated XML`;
    panel.appendChild(heading);
    for (const warning of warnings.slice(0, 20)) {
      const line = document.createElement('p');
      line.className = 'mt-1';
      line.textContent = warning;
      panel.appendChild(line);
    }
  }

  async function parseWsdlXml(xml: string, sourceLabel = 'WSDL', baseUrl?: string, existingController?: AbortController): Promise<void> {
    if (!existingController) contractController?.abort();
    const controller = existingController || new AbortController();
    contractController = controller;
    const timer = window.setTimeout(() => controller.abort(), 30_000);
    showLoading('Reading WSDL and linked schemas…');
    hideError();
    try {
      const contract = await parseSoapContract(xml, {
        sourceName: sourceLabel,
        baseUrl,
        localDocuments: collectedSchemas(),
        fetchText: async url => {
          if (useProxyCheckbox.checked && !await confirmLocalBridgeAccess(proxyUrlInput.value)) throw new Error('Local bridge access was not approved.');
          const response = await fetch(requestUrl(url), { signal: controller.signal });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const content = await readSoapBody(response);
          if (content.length > 5 * 1024 * 1024) throw new Error('XSD is larger than 5 MB.');
          return content;
        },
      });
      if (disposed || controller !== contractController) return;
      if (controller.signal.aborted) throw new Error('Contract loading was cancelled or timed out. Try local WSDL/XSD files.');
      if (generatedRequest && requestXmlInput.value !== generatedRequest && !window.confirm('Load this contract and replace your edited request with its WSDL template?')) return;
      generatedRequest = '';
      parsedWsdl = contract;
      setMode('wsdl');
      const portSelect = byId<HTMLSelectElement>('soap-port');
      portSelect.replaceChildren(...contract.ports.map(port => {
        const option = document.createElement('option'); option.value = port.id;
        option.textContent = `${port.service} / ${port.name} · SOAP ${port.version}`;
        return option;
      }));
      portSelect.value = contract.selectedPort;
      byId<HTMLElement>('port-field').classList.toggle('hidden', !contract.ports.length);
      displayOperations();
      byId<HTMLElement>('contract-summary').classList.remove('hidden');
      byId<HTMLElement>('service-name').textContent = contract.serviceName;
      byId<HTMLElement>('target-namespace').textContent = `${contract.namespace || 'No target namespace'}${contract.importedCount ? ` · ${contract.importedCount} linked XSD${contract.importedCount === 1 ? '' : 's'}` : ''}`;
      byId<HTMLElement>('contract-status').className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
      byId<HTMLElement>('contract-status').title = 'WSDL loaded';
      byId<HTMLElement>('operation-count').textContent = `${contract.operations.length} operation${contract.operations.length === 1 ? '' : 's'}`;
      soapVersionSelect.value = contract.version;
      updateContentType();
      if (contract.operations.length) selectOperation(contract.operations[0].name);
      else {
        setManualSession(false);
        if (contract.endpoint) endpointUrlInput.value = contract.endpoint;
        showError('The WSDL loaded, but no operations were found for its selected binding. You can still send a manual request.');
      }
      renderContractWarnings();
    } catch (error) {
      if (!disposed && controller === contractController) showError(`Could not parse ${sourceLabel}: ${error instanceof Error ? error.message : 'Unknown error'}`);
    } finally {
      window.clearTimeout(timer);
      if (!disposed && controller === contractController) { contractController = null; hideLoading(); }
    }
  }

  function displayOperations(): void {
    operationsList.replaceChildren();
    if (!parsedWsdl) return;
    const query = operationFilter.value.trim().toLowerCase();
    const visible = parsedWsdl.operations.filter(operation => operation.name.toLowerCase().includes(query));
    for (const operation of visible) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.operation = operation.name;
      button.className = `operation-btn w-full text-left p-2.5 rounded-lg border transition-colors ${selectedOperation === operation.name ? 'border-indigo-300 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/20' : 'border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50'}`;
      const name = document.createElement('span');
      name.className = 'block text-sm font-semibold text-slate-800 dark:text-slate-100 truncate';
      name.textContent = operation.name;
      const action = document.createElement('span');
      action.className = 'block mt-0.5 text-[10px] font-mono text-slate-500 dark:text-slate-400 truncate';
      action.textContent = operation.soapAction || 'No SOAPAction declared';
      button.append(name, action);
      button.addEventListener('click', () => selectOperation(operation.name));
      operationsList.append(button);
    }
    if (!visible.length) {
      const empty = document.createElement('p');
      empty.className = 'px-2 py-4 text-center text-xs text-slate-500 dark:text-slate-400';
      empty.textContent = 'No matching operations.';
      operationsList.append(empty);
    }
  }

  function selectOperation(name: string): void {
    const operation = parsedWsdl?.operations.find(candidate => candidate.name === name);
    if (!operation || !parsedWsdl) return;
    if (generatedRequest && requestXmlInput.value !== generatedRequest && !window.confirm('Replace your edited request with this WSDL template?')) return;
    selectedOperation = name;
    selectedOperationEl.textContent = operation.name;
    const badge = byId<HTMLElement>('session-mode-badge');
    badge.textContent = 'WSDL';
    badge.className = 'px-2 py-1 rounded-md bg-indigo-100 dark:bg-indigo-900/40 text-[11px] font-semibold uppercase tracking-wide text-indigo-700 dark:text-indigo-300';
    endpointUrlInput.value = parsedWsdl.endpoint;
    soapActionInput.value = operation.soapAction;
    const generated = generateSoapRequest(parsedWsdl, operation, soapVersionSelect.value as '1.1' | '1.2');
    requestXmlInput.value = generated.xml;
    generatedRequest = generated.xml;
    byId<HTMLElement>('regenerate-request-btn').classList.remove('hidden');
    byId<HTMLElement>('request-validation').textContent = 'Template ready. Fill in the operation parameters, then validate or send.';
    renderContractWarnings(generated.warnings);
    displayOperations();
  }

  function formatXml(xml: string): string {
    return readableSoapXml(xml);
  }

  function parseCustomHeaders(value: string): Headers {
    const headers = new Headers();
    value.split('\n').forEach((line, index) => {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#')) return;
      const separator = trimmed.indexOf(':');
      if (separator < 1) throw new Error(`Header line ${index + 1} must use “Name: value”.`);
      const name = trimmed.slice(0, separator).trim();
      const headerValue = trimmed.slice(separator + 1).trim();
      if (!/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name)) throw new Error(`Header line ${index + 1} has an invalid name.`);
      headers.set(name, headerValue);
    });
    return headers;
  }

  function basicAuthorization(username: string, password: string): string {
    const bytes = new TextEncoder().encode(`${username}:${password}`);
    let binary = '';
    bytes.forEach(byte => { binary += String.fromCharCode(byte); });
    return `Basic ${btoa(binary)}`;
  }

  interface SoapSnapshot { endpoint: string; version: string; action: string; request: string; authMode: string }
  interface StoredSoapRequest { name?: string; at?: string; status?: string; elapsed?: number; snapshot: SoapSnapshot }

  function snapshot(): SoapSnapshot {
    return {
      endpoint: shareEndpoint(endpointUrlInput.value.trim()), version: soapVersionSelect.value,
      action: soapActionInput.value.trim(), request: requestWithoutSoapHeader(requestXmlInput.value),
      authMode: authType.value,
    };
  }

  function getStored(key: string): StoredSoapRequest[] {
    try {
      const value = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(value) ? value.filter(item => item && typeof item === 'object' && item.snapshot && typeof item.snapshot.request === 'string') : [];
    } catch { return []; }
  }

  function store(key: string, items: StoredSoapRequest[]): boolean {
    try { localStorage.setItem(key, JSON.stringify(items)); return true; }
    catch { showToast('Browser storage is full or unavailable. Clear older entries and retry.', true); return false; }
  }

  function applySnapshot(saved: SoapSnapshot): void {
    resetSessionResponse();
    endpointUrlInput.value = saved.endpoint || '';
    soapVersionSelect.value = saved.version === '1.2' ? '1.2' : '1.1';
    soapActionInput.value = saved.action || '';
    requestXmlInput.value = saved.request || '';
    authType.value = ['basic', 'wsse-text', 'wsse-digest'].includes(saved.authMode) ? saved.authMode : 'none';
    authUsername.value = '';
    authPassword.value = '';
    customHeadersInput.value = '';
    authType.dispatchEvent(new Event('change'));
    setMode('direct');
    updateContentType();
    requestXmlInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function renderStored(elementId: string, storageKey: string, kind: 'saved' | 'history'): void {
    const list = byId<HTMLElement>(elementId);
    const items = getStored(storageKey);
    list.replaceChildren();
    if (!items.length) { list.textContent = kind === 'saved' ? 'Nothing saved yet.' : 'No requests yet.'; return; }
    for (const [index, item] of items.entries()) {
      const row = document.createElement('div');
      row.className = 'flex min-w-0 items-center gap-2 rounded-lg border border-slate-200 p-2 dark:border-slate-700';
      const load = document.createElement('button');
      load.type = 'button';
      load.className = 'min-w-0 flex-1 text-left hover:text-indigo-600';
      const title = document.createElement('strong');
      title.className = 'block truncate text-xs text-slate-800 dark:text-slate-100';
      title.textContent = item.name || item.snapshot.endpoint || 'SOAP request';
      const detail = document.createElement('span');
      detail.className = 'block truncate text-[11px] text-slate-500 dark:text-slate-400';
      detail.textContent = kind === 'history' ? `${item.status || 'Sent'} · ${item.elapsed || 0} ms · ${item.at ? new Date(item.at).toLocaleString() : ''}` : `${item.snapshot.version} · ${item.snapshot.action || 'No action'}`;
      load.append(title, detail);
      load.addEventListener('click', () => applySnapshot(item.snapshot));
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'shrink-0 text-[11px] text-red-600 hover:underline dark:text-red-400';
      remove.textContent = 'Delete';
      remove.setAttribute('aria-label', `Delete ${kind} entry ${index + 1}`);
      remove.addEventListener('click', () => { items.splice(index, 1); store(storageKey, items); renderStored(elementId, storageKey, kind); });
      row.append(load, remove);
      list.appendChild(row);
    }
  }

  function addHistory(status: string, elapsed: number, current: SoapSnapshot): void {
    if (!byId<HTMLInputElement>('save-history').checked) return;
    if (!current.request || current.request.length > 100_000) { showToast('History skipped: request is invalid or too large to store locally.', true); return; }
    const items = getStored(HISTORY_KEY);
    items.unshift({ at: new Date().toISOString(), status, elapsed, snapshot: current });
    if (store(HISTORY_KEY, items.slice(0, 30))) renderStored('history-list', HISTORY_KEY, 'history');
  }

  function updateContentType(): void {
    const action = soapActionInput.value.trim();
    const contentType = soapVersionSelect.value === '1.2'
      ? `application/soap+xml; charset=utf-8${action ? '; action="' + quotedAction(action) + '"' : ''}`
      : 'text/xml; charset=utf-8';
    byId<HTMLElement>('request-content-type').textContent = contentType;
  }

  function quotedAction(value: string): string { return value.replaceAll('\\', '\\\\').replaceAll('"', '\\"'); }

  async function sendRequest(): Promise<void> {
    if (requestController) return;
    hideError();
    const endpoint = endpointUrlInput.value.trim();
    const requestXml = requestXmlInput.value.trim();
    if (!endpoint) { showError('Enter the SOAP endpoint URL before sending.'); endpointUrlInput.focus(); return; }
    if (!requestXml) { showError('Enter a SOAP XML envelope before sending.'); requestXmlInput.focus(); return; }

    const version = soapVersionSelect.value as SoapVersion;
    try { soapEnvelope(requestXml, version); } catch (error) { showError(error instanceof Error ? error.message : 'The request XML is invalid.'); return; }

    let target: string;
    let headers: Headers;
    try {
      target = requestUrl(endpoint);
      headers = parseCustomHeaders(customHeadersInput.value);
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Review the request settings.');
      return;
    }

    const savedSnapshot = snapshot();
    const mode = authType.value;
    const username = authUsername.value, password = authPassword.value;
    const proxyEnabled = useProxyCheckbox.checked, bridgeUrl = proxyUrlInput.value;
    const soapAction = soapActionInput.value.trim();
    if (/[\x00-\x1f\x7f]|[^\x00-\xff]/.test(soapAction)) { showError('SOAPAction must be a single HTTP header value. Percent-encode non-ASCII URI characters.'); return; }
    headers.set('Content-Type', version === '1.2'
      ? `application/soap+xml; charset=utf-8${soapAction ? `; action="${quotedAction(soapAction)}"` : ''}`
      : 'text/xml; charset=utf-8');
    headers.delete('SOAPAction');
    if (version === '1.1' && soapAction) headers.set('SOAPAction', `"${quotedAction(soapAction)}"`);
    if (mode === 'basic') headers.set('Authorization', basicAuthorization(username, password));

    const controller = new AbortController();
    const revision = ++requestRevision;
    requestController = controller;
    byId<HTMLButtonElement>('send-btn').disabled = true;
    byId<HTMLElement>('cancel-request-btn').classList.remove('hidden');
    clearResponse();
    showLoading('Sending SOAP request…');
    const timeout = Number(timeoutSelect.value);
    let timedOut = false;
    let timer = 0;
    let started = performance.now();

    try {
      if (proxyEnabled && !await confirmLocalBridgeAccess(bridgeUrl)) { showToast('Request not sent.'); return; }
      if (disposed || controller.signal.aborted || revision !== requestRevision) return;
      let outgoingXml = requestXml;
      if (mode === 'wsse-text' || mode === 'wsse-digest') outgoingXml = await usernameTokenRequest(requestXml, username.trim(), password, mode === 'wsse-digest' ? 'digest' : 'text');
      if (disposed || controller.signal.aborted || revision !== requestRevision) return;
      timer = timeout > 0 ? window.setTimeout(() => { timedOut = true; controller.abort(); }, timeout) : 0;
      started = performance.now();
      const response = await fetch(target, { method: 'POST', headers, body: outgoingXml, signal: controller.signal });
      const text = await readSoapBody(response);
      if (disposed || controller.signal.aborted || revision !== requestRevision) return;
      lastResponseText = text;
      hasResponse = true;
      const elapsed = Math.round(performance.now() - started);
      let formattedResponse = lastResponseText;
      if (lastResponseText.length <= 1_000_000) try { formattedResponse = formatXml(lastResponseText); } catch { /* Preserve non-XML error bodies. */ }
      responseBody.textContent = formattedResponse;
      responseHeaders.textContent = [...response.headers.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([name, value]) => `${name}: ${value}`).join('\n') || '(No response headers exposed by CORS)';
      responseTime.textContent = `${elapsed.toLocaleString()} ms`;
      responseSize.textContent = `${new TextEncoder().encode(lastResponseText).length.toLocaleString()} bytes`;

      const inspection = inspectSoapResponse(lastResponseText);
      const hasSoapFault = !!inspection.fault;
      renderResponseChecks(response, inspection, version);
      statusBadge.textContent = hasSoapFault ? `SOAP Fault · ${response.status}` : `${response.status} ${response.statusText}`;
      statusBadge.className = `px-2 py-0.5 rounded text-[11px] font-semibold ${hasSoapFault || !response.ok ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300'}`;
      responseContent.classList.remove('hidden');
      responseEmpty.classList.add('hidden');
      responseButtons(true);
      showResponseView('body');
      addHistory(hasSoapFault ? `SOAP Fault ${response.status}` : `HTTP ${response.status}`, elapsed, savedSnapshot);
    } catch (error) {
      if (disposed || revision !== requestRevision) return;
      responseEmpty.classList.remove('hidden');
      const cancelled = controller.signal.aborted;
      const message = cancelled
        ? timedOut ? `Request timed out after ${timeout / 1000} seconds.` : 'Request cancelled. No retry was sent.'
        : error instanceof Error ? error.message : 'Unknown network error';
      const corsHelp = cancelled || !(error instanceof TypeError) ? '' : !proxyEnabled
        ? '\n\nIf the endpoint works in a desktop client, its CORS policy may be blocking browsers. Open “Browser blocked by CORS?” above to configure the optional local bridge.'
        : `\n\nThe local Holy CORS bridge is enabled. Check that it is running at ${bridgeUrl.trim()}, the endpoint is correct, and your browser allows local access for bugdays.com.`;
      showError(`Request failed: ${message}${corsHelp}`);
      addHistory(cancelled ? timedOut ? 'Timed out' : 'Cancelled' : 'Request error', Math.round(performance.now() - started), savedSnapshot);
    } finally {
      if (timer) window.clearTimeout(timer);
      requestController = null;
      if (!disposed) {
        byId<HTMLButtonElement>('send-btn').disabled = false;
        byId<HTMLElement>('cancel-request-btn').classList.add('hidden');
        hideLoading();
      }
    }
  }

  function responseButtons(enabled: boolean): void {
    for (const id of ['format-response-btn', 'raw-response-btn', 'copy-response-btn', 'download-response-btn']) byId<HTMLButtonElement>(id).disabled = !enabled;
  }

  function clearResponse(): void {
    hasResponse = false;
    lastResponseText = '';
    responseBody.textContent = '';
    responseHeaders.textContent = '';
    responseTime.textContent = '';
    responseSize.textContent = '';
    statusBadge.classList.add('hidden');
    byId<HTMLElement>('soap-fault').classList.add('hidden');
    responseEmpty.classList.remove('hidden');
    responseContent.classList.add('hidden');
    responseButtons(false);
  }

  function resetSessionResponse(): void {
    requestRevision++;
    requestController?.abort();
    if (byId<HTMLDialogElement>('bridge-access-dialog').open) byId<HTMLButtonElement>('bridge-access-cancel').click();
    clearResponse();
    hideError();
  }

  function renderResponseChecks(response: Response, inspection: ReturnType<typeof inspectSoapResponse>, expected: SoapVersion): void {
    const checks = byId<HTMLElement>('response-checks');
    checks.replaceChildren();
    const entries: [boolean, string][] = [
      [response.ok, `HTTP ${response.status}`],
      [!!inspection.version, inspection.version ? `SOAP ${inspection.version}` : 'Not SOAP'],
      ...(inspection.version ? [[!inspection.fault, inspection.fault ? 'Fault returned' : 'No SOAP fault'] as [boolean, string]] : []),
      ...(inspection.version && inspection.version !== expected ? [[false, `Expected SOAP ${expected}`] as [boolean, string]] : []),
    ];
    for (const [pass, label] of entries) {
      const badge = document.createElement('span');
      badge.className = pass ? 'rounded bg-emerald-50 px-2 py-1 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300' : 'rounded bg-amber-50 px-2 py-1 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300';
      badge.textContent = `${pass ? '✓' : '!'} ${label}`;
      checks.append(badge);
    }
    const faultPanel = byId<HTMLDetailsElement>('soap-fault');
    faultPanel.classList.toggle('hidden', !inspection.fault);
    if (!inspection.fault) return;
    faultPanel.open = true;
    const fault = inspection.fault;
    const summary = byId<HTMLElement>('fault-summary');
    summary.replaceChildren();
    for (const [label, value] of [['Code', fault.code || 'Not supplied'], ['Subcodes', fault.subcodes.join(' → ')], ['Reason', fault.reasons.join('\n')], ['Node / actor / role', fault.actor]]) {
      if (!value) continue;
      const row = document.createElement('div'), term = document.createElement('dt'), description = document.createElement('dd');
      term.className = 'font-semibold'; term.textContent = label;
      description.className = 'mt-0.5 whitespace-pre-wrap'; description.textContent = value;
      row.append(term, description); summary.append(row);
    }
    byId<HTMLElement>('fault-detail').textContent = fault.detail;
  }

  function showResponseView(view: 'body' | 'headers'): void {
    responseView = view;
    const body = view === 'body';
    responseBody.classList.toggle('hidden', !body);
    responseHeaders.classList.toggle('hidden', body);
    const bodyTab = byId<HTMLButtonElement>('response-body-tab');
    const headersTab = byId<HTMLButtonElement>('response-headers-tab');
    bodyTab.setAttribute('aria-selected', String(body));
    headersTab.setAttribute('aria-selected', String(!body));
    bodyTab.className = `response-tab px-4 py-2 text-xs ${body ? 'font-semibold text-indigo-700 dark:text-indigo-300 border-b-2 border-indigo-600' : 'font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent'}`;
    headersTab.className = `response-tab px-4 py-2 text-xs ${!body ? 'font-semibold text-indigo-700 dark:text-indigo-300 border-b-2 border-indigo-600' : 'font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent'}`;
  }

  wsdlModeTab.addEventListener('click', () => { setMode('wsdl'); wsdlUrlInput.focus(); });
  directModeTab.addEventListener('click', () => setMode('direct'));
  byId<HTMLButtonElement>('focus-endpoint-btn').addEventListener('click', () => endpointUrlInput.focus());
  byId<HTMLButtonElement>('toggle-wsdl-input').addEventListener('click', () => wsdlXmlSection.classList.toggle('hidden'));
  byId<HTMLButtonElement>('load-demo-btn').addEventListener('click', () => { wsdlXmlInput.value = DEMO_WSDL; void parseWsdlXml(DEMO_WSDL, 'demo contract'); });
  byId<HTMLButtonElement>('add-xsd-btn').addEventListener('click', () => {
    const list = byId<HTMLElement>('pasted-schemas');
    const row = document.createElement('div');
    row.dataset.xsdRow = 'true';
    row.className = 'rounded-lg border border-slate-200 bg-white p-2 dark:border-slate-700 dark:bg-slate-800';
    const bar = document.createElement('div');
    bar.className = 'mb-1 flex items-center gap-2';
    const name = document.createElement('input');
    name.className = 'min-w-0 flex-1 rounded border border-slate-300 bg-white p-1.5 font-mono text-xs dark:border-slate-600 dark:bg-slate-900';
    name.placeholder = 'schemaLocation, e.g. types/customer.xsd';
    name.setAttribute('aria-label', 'Pasted XSD filename');
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'text-xs text-red-600 hover:underline dark:text-red-400';
    remove.textContent = 'Remove';
    remove.addEventListener('click', () => row.remove());
    bar.append(name, remove);
    const input = document.createElement('textarea');
    input.className = 'h-28 w-full resize-y rounded border border-slate-300 bg-white p-2 font-mono text-xs dark:border-slate-600 dark:bg-slate-950';
    input.placeholder = 'Paste this XSD document…';
    input.spellcheck = false;
    input.setAttribute('aria-label', 'Pasted XSD XML');
    row.append(bar, input);
    list.appendChild(row);
    name.focus();
  });
  operationFilter.addEventListener('input', displayOperations);

  parseWsdlBtn.addEventListener('click', async () => {
    const value = wsdlUrlInput.value.trim();
    if (!value) { showError('Enter a WSDL URL, or choose Paste / upload WSDL.'); wsdlUrlInput.focus(); return; }
    let url: string;
    try { url = requestUrl(validateHttpUrl(value, 'WSDL URL').toString()); } catch (error) { showError(error instanceof Error ? error.message : 'Invalid WSDL URL.'); return; }
    if (useProxyCheckbox.checked && !await confirmLocalBridgeAccess(proxyUrlInput.value)) return;
    contractController?.abort();
    const controller = new AbortController();
    contractController = controller;
    const timer = window.setTimeout(() => controller.abort(), 30_000);
    showLoading('Fetching WSDL contract…');
    hideError();
    try {
      const response = await fetch(url, { signal: controller.signal });
      if (!response.ok) throw new Error(`HTTP ${response.status} ${response.statusText}`);
      const xml = await readSoapBody(response);
      if (!disposed && contractController === controller && !controller.signal.aborted) await parseWsdlXml(xml, 'WSDL', value, controller);
    } catch (error) {
      if (disposed || contractController !== controller) return;
      const message = error instanceof Error ? error.message : 'Unknown network error';
      const help = useProxyCheckbox.checked
        ? `The local Holy CORS bridge is enabled. Check that it is running at ${proxyUrlInput.value.trim()}, the WSDL URL is correct, and your browser allows local access for bugdays.com.`
        : 'The service may block cross-origin requests. Paste the WSDL XML or enable the optional local Holy CORS bridge.';
      showError(`Could not fetch WSDL: ${message}\n\n${help}`);
    } finally {
      window.clearTimeout(timer);
      if (!disposed && contractController === controller) { contractController = null; hideLoading(); }
    }
  });

  parseXmlBtn.addEventListener('click', () => {
    if (!wsdlXmlInput.value.trim()) { showError('Paste or open a WSDL document first.'); return; }
    void parseWsdlXml(wsdlXmlInput.value, 'pasted WSDL', wsdlUrlInput.value.trim() || undefined);
  });

  wsdlFileInput.addEventListener('change', async () => {
    const files = [...(wsdlFileInput.files || [])];
    if (!files.length) return;
    if (files.some(file => file.size > 5 * 1024 * 1024) || files.reduce((sum, file) => sum + file.size, 0) > 20 * 1024 * 1024) {
      showError('Each WSDL/XSD must be under 5 MB and the selection under 20 MB.');
      wsdlFileInput.value = '';
      return;
    }
    const documents = await Promise.all(files.map(async file => ({ name: file.webkitRelativePath || file.name, xml: await file.text() })));
    if (disposed) return;
    const wsdl = documents.find(item => item.name.toLowerCase().endsWith('.wsdl')) || documents.find(item => new DOMParser().parseFromString(item.xml, 'text/xml').documentElement.localName === 'definitions');
    wsdlFileInput.value = '';
    if (!wsdl) { localSchemas.push(...documents); byId<HTMLElement>('local-schema-count').textContent = `${localSchemas.length} XSD file${localSchemas.length === 1 ? '' : 's'} ready`; showToast('XSD files added. Paste or open the WSDL, then load the contract.'); return; }
    wsdlXmlInput.value = wsdl.xml;
    localSchemas = [...localSchemas, ...documents.filter(item => item !== wsdl)];
    byId<HTMLElement>('local-schema-count').textContent = `${localSchemas.length} XSD file${localSchemas.length === 1 ? '' : 's'} ready`;
    void parseWsdlXml(wsdl.xml, wsdl.name, wsdlUrlInput.value.trim() || undefined);
  });

  useProxyCheckbox.addEventListener('change', () => { proxyUrlInput.disabled = !useProxyCheckbox.checked; });
  byId<HTMLButtonElement>('proxy-info-btn').addEventListener('click', () => proxyModal.showModal());
  byId<HTMLButtonElement>('close-proxy-modal-btn').addEventListener('click', () => proxyModal.close());

  authType.addEventListener('change', () => {
    const mode = authType.value;
    basicAuthFields.classList.toggle('hidden', mode === 'none');
    byId<HTMLElement>('auth-help').textContent = mode === 'basic'
      ? 'Credentials stay in this tab and are never saved or shared. HTTP Authorization may trigger a CORS preflight.'
      : mode === 'wsse-digest'
        ? 'A fresh nonce and timestamp are generated for every send. PasswordDigest is added only to the outgoing XML, never the editor, saves, history, or shares.'
        : 'A UsernameToken is added only when sending. PasswordText exposes the password to the target service; use a trusted HTTPS endpoint.';
  });
  soapActionInput.addEventListener('input', updateContentType);
  soapVersionSelect.addEventListener('change', () => {
    updateContentType();
    const version = soapVersionSelect.value as SoapVersion;
    try {
      const untouched = requestXmlInput.value === generatedRequest;
      requestXmlInput.value = changeSoapVersion(requestXmlInput.value, version);
      if (untouched) generatedRequest = requestXmlInput.value;
      byId<HTMLElement>('request-validation').textContent = `SOAP ${version} envelope. Your parameter values are preserved; check the service port and security policy.`;
      hideError();
    } catch (error) { showError(error instanceof Error ? error.message : 'Could not change the envelope version.'); }
  });

  byId<HTMLSelectElement>('soap-port').addEventListener('change', event => {
    if (!parsedWsdl) return;
    const select = event.target as HTMLSelectElement;
    if (generatedRequest && requestXmlInput.value !== generatedRequest && !window.confirm('Switch service port and replace your edited request with its WSDL template?')) { select.value = parsedWsdl.selectedPort; return; }
    selectSoapPort(parsedWsdl, select.value);
    generatedRequest = '';
    soapVersionSelect.value = parsedWsdl.version;
    endpointUrlInput.value = parsedWsdl.endpoint;
    byId<HTMLElement>('service-name').textContent = parsedWsdl.serviceName;
    byId<HTMLElement>('operation-count').textContent = `${parsedWsdl.operations.length} operations · SOAP ${parsedWsdl.version}`;
    operationFilter.value = '';
    const operation = parsedWsdl.operations.find(item => item.name === selectedOperation) || parsedWsdl.operations[0];
    if (operation) selectOperation(operation.name);
    else { setManualSession(false); displayOperations(); }
    updateContentType();
  });
  byId<HTMLButtonElement>('regenerate-request-btn').addEventListener('click', () => { if (selectedOperation) selectOperation(selectedOperation); });
  function validateRequest(): void {
    try {
      const envelope = soapEnvelope(requestXmlInput.value, soapVersionSelect.value as SoapVersion);
      hideError();
      byId<HTMLElement>('request-validation').textContent = `✓ Valid SOAP ${envelope.version} envelope. This checks XML and envelope structure, not XSD business rules.`;
    } catch (error) {
      byId<HTMLElement>('request-validation').textContent = 'Fix the XML or SOAP version before sending.';
      showError(error instanceof Error ? error.message : 'Invalid SOAP XML.');
    }
  }
  byId<HTMLButtonElement>('validate-request-btn').addEventListener('click', validateRequest);
  requestXmlInput.addEventListener('input', () => { byId<HTMLElement>('request-validation').textContent = 'Request edited. Validate envelope structure and SOAP version before sending.'; });
  byId<HTMLButtonElement>('share-request-btn').addEventListener('click', () => {
    if (!requestWithoutSoapHeader(requestXmlInput.value)) { validateRequest(); return; }
    byId<HTMLButtonElement>('share-btn').click();
  });
  byId<HTMLButtonElement>('cancel-request-btn').addEventListener('click', () => { requestController?.abort(); });

  byId<HTMLButtonElement>('send-btn').addEventListener('click', sendRequest);
  byId<HTMLButtonElement>('format-request-btn').addEventListener('click', () => { try { requestXmlInput.value = formatXml(requestXmlInput.value); showToast('Request XML formatted.'); } catch (error) { showError(error instanceof Error ? error.message : 'Invalid XML.'); } });
  byId<HTMLButtonElement>('copy-request-btn').addEventListener('click', async () => { try { await navigator.clipboard.writeText(requestXmlInput.value); showToast('Request copied.'); } catch { showToast('Clipboard access was blocked.', true); } });
  byId<HTMLButtonElement>('format-response-btn').addEventListener('click', () => { try { responseBody.textContent = formatXml(lastResponseText); showResponseView('body'); showToast('Readable view. Raw response and downloads are unchanged.'); } catch { showToast('The response is not valid XML.', true); } });
  byId<HTMLButtonElement>('raw-response-btn').addEventListener('click', () => { responseBody.textContent = lastResponseText; showResponseView('body'); });
  byId<HTMLButtonElement>('copy-response-btn').addEventListener('click', async () => { try { await navigator.clipboard.writeText(responseView === 'headers' ? responseHeaders.textContent || '' : responseBody.textContent || ''); showToast(responseView === 'headers' ? 'Headers copied.' : 'Response copied.'); } catch { showToast('Clipboard access was blocked.', true); } });
  byId<HTMLButtonElement>('download-response-btn').addEventListener('click', () => {
    if (!hasResponse) { showToast('Send a request before downloading.', true); return; }
    track('export_used', { tool: 'soap-client', format: 'xml' });
    const blob = new Blob([lastResponseText], { type: 'application/xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `soap-response-${new Date().toISOString().replace(/[:.]/g, '-')}.xml`;
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  byId<HTMLButtonElement>('response-body-tab').addEventListener('click', () => showResponseView('body'));
  byId<HTMLButtonElement>('response-headers-tab').addEventListener('click', () => showResponseView('headers'));
  byId<HTMLButtonElement>('inline-feedback-btn').addEventListener('click', () => byId<HTMLButtonElement>('feedback-btn').click());

  byId<HTMLButtonElement>('save-request-btn').addEventListener('click', () => {
    const current = snapshot();
    if (!current.request) { showToast('Enter valid SOAP XML before saving.', true); return; }
    if (current.request.length > 100_000) { showToast('This request is too large to save locally (100 KB limit).', true); return; }
    const name = window.prompt('Saved request name', selectedOperation || current.action || 'SOAP request');
    if (name === null) return;
    const items = getStored(SAVED_KEY);
    items.unshift({ name: name.trim().slice(0, 80) || 'SOAP request', snapshot: current });
    if (store(SAVED_KEY, items.slice(0, 20))) { renderStored('saved-list', SAVED_KEY, 'saved'); showToast('Request saved in this browser.'); }
  });
  byId<HTMLButtonElement>('clear-saved-btn').addEventListener('click', () => { if (store(SAVED_KEY, [])) renderStored('saved-list', SAVED_KEY, 'saved'); });
  byId<HTMLButtonElement>('clear-history-btn').addEventListener('click', () => { if (store(HISTORY_KEY, [])) renderStored('history-list', HISTORY_KEY, 'history'); });
  const historyToggle = byId<HTMLInputElement>('save-history');
  try { historyToggle.checked = localStorage.getItem('bugdays-soap-history-enabled-v1') === 'true'; } catch {}
  historyToggle.addEventListener('change', () => { try { localStorage.setItem('bugdays-soap-history-enabled-v1', String(historyToggle.checked)); } catch {} });
  renderStored('saved-list', SAVED_KEY, 'saved');
  renderStored('history-list', HISTORY_KEY, 'history');

  function shareEndpoint(value: string): string {
    try {
      const url = new URL(value);
      url.username = '';
      url.password = '';
      url.hash = '';
      for (const name of [...url.searchParams.keys()]) if (/key|token|secret|pass|auth|signature|credential/i.test(name)) url.searchParams.delete(name);
      return url.toString();
    } catch { return ''; }
  }

  ShareManager.register({
    tool: 'soap-client',
    // Sharing never replays a POST, including legacy links containing action: "send".
    beforeShare: () => ShareManager.setLastAction(''),
    customCollect: () => ({
      endpoint: shareEndpoint(endpointUrlInput.value.trim()),
      version: soapVersionSelect.value,
      soapAction: soapActionInput.value.trim(),
      request: requestWithoutSoapHeader(requestXmlInput.value),
    }),
    customRestore: data => {
      resetSessionResponse();
      if (typeof data.wsdl === 'string') wsdlUrlInput.value = data.wsdl;
      endpointUrlInput.value = typeof data.endpoint === 'string' ? data.endpoint : '';
      soapVersionSelect.value = data.version === '1.2' ? '1.2' : '1.1';
      soapActionInput.value = typeof data.soapAction === 'string' ? data.soapAction : '';
      requestXmlInput.value = typeof data.request === 'string' ? requestWithoutSoapHeader(data.request) : '';
      authUsername.value = '';
      authPassword.value = '';
      authType.value = 'none';
      customHeadersInput.value = '';
      authType.dispatchEvent(new Event('change'));
      updateContentType();
      setMode('direct');
    },
  });

  authType.dispatchEvent(new Event('change'));
  updateContentType();
  document.addEventListener('astro:before-swap', () => {
    disposed = true;
    requestController?.abort();
    contractController?.abort();
    window.clearTimeout(toastTimer);
    if (byId<HTMLDialogElement>('bridge-access-dialog').open) byId<HTMLButtonElement>('bridge-access-cancel').click();
  }, { once: true });
  }
  initSoapClient();
  document.addEventListener('astro:after-swap', initSoapClient);
</script>

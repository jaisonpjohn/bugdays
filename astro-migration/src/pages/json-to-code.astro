---
import Layout from '../layouts/Layout.astro';

const faqs = [
  ['What JSON code can this generator create?', 'It generates TypeScript interfaces, Zod validation schemas, and Pydantic models from a JSON example.'],
  ['How are optional fields inferred?', 'When an array contains objects with a field missing in some entries, that field becomes optional in the generated model. Null is represented as a nullable type.'],
  ['Can I generate code from a local JSON file?', 'Yes. The file is read in your browser and is never uploaded.'],
  ['Can I share a generated example?', 'Yes. Share a small synthetic JSON example and the selected target. Anyone with the link can read the included JSON, so do not share production payloads or credentials.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'JSON to TypeScript, Zod, and Pydantic Generator', url: 'https://bugdays.com/json-to-code/', description: 'Generate TypeScript interfaces, Zod schemas, and Pydantic models from JSON in the browser. Infer nested objects, arrays, optional fields, nullable values, and safe property names.', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['JSON to TypeScript interfaces', 'JSON to Zod schemas', 'JSON to Pydantic models', 'Optional field and null inference', 'Local file input', 'Shareable synthetic examples'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---

<Layout title="JSON to TypeScript, Zod & Pydantic Generator" description="Generate TypeScript interfaces, Zod schemas, and Pydantic models from JSON. Infer nested objects, arrays, optional fields, and nulls locally in your browser; copy, download, or share a safe example." keywords="JSON to TypeScript, JSON to Zod, JSON to Pydantic, JSON type generator, generate TypeScript interface from JSON, JSON schema code generator, JSON to Python model" breadcrumb={[{ name: 'JSON Tools', href: '/json-tools/' }, { name: 'JSON to Code' }]} toolId="json-to-code" jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-1">JSON to TypeScript, Zod &amp; Pydantic</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Turn a JSON example into typed code locally. Copy, download, or share a small synthetic reproducer with the generated target.</p>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="json-input" class="text-sm font-semibold text-slate-700 dark:text-slate-200">JSON example</label><label class="cursor-pointer text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Open local JSON<input id="json-file" type="file" accept="application/json,.json" class="hidden" /></label></div>
        <textarea id="json-input" data-share-key="json" class="h-80 w-full resize-none rounded-lg border border-slate-300 p-3 font-mono text-sm text-slate-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder='{"id": 42, "name": "Ada"}' spellcheck="false"></textarea>
        <p id="file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">JSON stays in this browser.</p>
      </section>
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="code-output" class="text-sm font-semibold text-slate-700 dark:text-slate-200">Generated <span id="target-label">TypeScript</span></label><button id="copy-btn" type="button" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Copy output</button></div>
        <textarea id="code-output" readonly class="h-80 w-full resize-none rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Generated code appears here…" spellcheck="false"></textarea>
        <p id="output-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p>
      </section>
    </div>

    <div class="mt-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="flex flex-wrap items-end gap-4">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Output target<select id="target" data-share-key="target" class="mt-1 block rounded-lg border border-slate-300 bg-white p-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="typescript">TypeScript interface</option><option value="zod">Zod schema</option><option value="pydantic">Pydantic model</option></select></label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Root type name<input id="root-name" data-share-key="rootName" value="Root" class="mt-1 block w-40 rounded-lg border border-slate-300 p-2 font-mono text-sm dark:border-slate-600 dark:bg-slate-900" /></label>
        <button id="generate-btn" data-share-action="generate" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Generate code</button>
        <button id="download-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Download</button>
        <button id="share-code-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Share example ↗</button>
        <button id="sample-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Load sample</button>
      </div>
    </div>

    <div id="error-box" role="alert" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>
    <p class="mt-5 text-sm text-slate-600 dark:text-slate-300">Already have a JSON Schema? <a href="/json-schema-validator/" class="font-semibold text-indigo-600 underline dark:text-indigo-400">Validate an API response with JSON Schema Doctor</a> and share the exact failing example.</p>

    <div class="mt-7 grid gap-4 md:grid-cols-3 text-sm"><a href="/json-formatter/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Invalid JSON?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Format, validate, and find the error location first.</span></a><a href="/json-diff/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Compare API shapes</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">See exactly which fields changed between responses.</span></a><a href="/schema-explorer/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Need an ER diagram?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Explore SQL DDL and its table relationships.</span></a></div>

    <section class="mt-8 max-w-4xl space-y-5 text-sm leading-7 text-slate-600 dark:text-slate-300"><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Generate types from a representative JSON example</h2><p class="mt-2">A type generator learns only from the values you give it. Include a representative array when fields can be missing, include <code>null</code> when a value can be null, and include nested records when the API returns them. The tool merges object shapes across an array to mark fields that are absent in some entries as optional.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">TypeScript, Zod, or Pydantic?</h2><p class="mt-2">Use a TypeScript interface for editor type checking, Zod when you also need runtime validation in JavaScript or TypeScript, and a Pydantic model for a Python service. Generated code is a starting point: add domain constraints, enums, integer ranges, and API-specific validation before treating it as a contract. See the <a href="/guides/json-to-typescript-zod-pydantic/" class="text-indigo-600 underline dark:text-indigo-400">JSON-to-code guide</a> for a worked nested response.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Share a reproducible example, never a production payload</h2><p class="mt-2">The visible share action keeps the selected target, root name, and JSON example together. It is ideal for a tiny mock response in a ticket or code review. Anybody with the link can read included JSON, so remove customer data, access tokens, and private endpoints first.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">JSON code generator questions</h2><div class="mt-3 space-y-2">{faqs.map(([question, answer]) => <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-100">{question}</summary><p class="mt-2">{answer}</p></details>)}</div></div></section>
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import { parseAndGenerateJsonCode, type CodeTarget } from '../lib/json-codegen.ts';
  import { ShareManager } from '../lib/share.ts';

  const input = document.getElementById('json-input') as HTMLTextAreaElement;
  const output = document.getElementById('code-output') as HTMLTextAreaElement;
  const target = document.getElementById('target') as HTMLSelectElement;
  const rootName = document.getElementById('root-name') as HTMLInputElement;
  const errorBox = document.getElementById('error-box')!;
  const targetLabel = document.getElementById('target-label')!;
  const outputStatus = document.getElementById('output-status')!;
  const fileStatus = document.getElementById('file-status')!;
  const fileInput = document.getElementById('json-file') as HTMLInputElement;
  const sample = JSON.stringify([{ id: 42, displayName: 'Ada', roles: ['admin'], profile: { timezone: 'UTC' } }, { id: 43, displayName: 'Lin', profile: null }], null, 2);

  ShareManager.register({ tool: 'json-to-code', actions: { generate: () => document.getElementById('generate-btn')?.click() } });
  document.getElementById('share-code-btn')!.addEventListener('click', () => document.getElementById('share-btn')?.click());
  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function hideError() { errorBox.classList.add('hidden'); }
  function updateTargetLabel() { targetLabel.textContent = target.options[target.selectedIndex].text.replace(' interface', '').replace(' schema', '').replace(' model', ''); }
  function generate() {
    if (!input.value.trim()) return showError('Paste JSON or open a local JSON file first.');
    try {
      output.value = parseAndGenerateJsonCode(input.value, { target: target.value as CodeTarget, rootName: rootName.value });
      hideError(); updateTargetLabel(); outputStatus.textContent = `${output.value.split('\n').length} lines generated locally.`;
    } catch (error) { showError(error instanceof Error ? `Invalid JSON: ${error.message}` : 'Invalid JSON.'); }
  }
  document.getElementById('generate-btn')!.addEventListener('click', generate);
  document.getElementById('sample-btn')!.addEventListener('click', () => { input.value = sample; fileStatus.textContent = 'Synthetic sample loaded. Nothing was uploaded.'; generate(); });
  document.getElementById('copy-btn')!.addEventListener('click', () => { if (output.value) navigator.clipboard.writeText(output.value); });
  document.getElementById('download-btn')!.addEventListener('click', () => {
    if (!output.value) return;
    const extension = target.value === 'pydantic' ? 'py' : 'ts';
    track('export_used', { tool: 'json-to-code', format: extension });
    const href = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' }));
    const link = document.createElement('a'); link.href = href; link.download = `${rootName.value.trim() || 'root'}.${extension}`; link.click(); URL.revokeObjectURL(href);
  });
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0]; fileInput.value = '';
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) return showError('Choose a JSON file smaller than 5 MB.');
    try { input.value = await file.text(); fileStatus.textContent = `Loaded ${Math.max(1, Math.round(file.size / 1024))} KB locally. Nothing was uploaded.`; generate(); }
    catch { showError('The local JSON file could not be read.'); }
  });
  target.addEventListener('change', () => { updateTargetLabel(); if (input.value.trim()) generate(); });
  rootName.addEventListener('change', () => { if (input.value.trim()) generate(); });
  updateTargetLabel();
</script>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="QR Code Generator & Reader"
  description="Generate QR codes from text, URLs, and data or scan and read QR codes from images. Free online QR code tool with customizable size and error correction levels."
  keywords="QR code generator, QR code reader, create QR code, scan QR code, QR code maker, read QR code from image, QR code decoder, free QR code"
  breadcrumb={[{ name: "Encoding Tools", href: "/encoding-tools" }, { name: "QR Code" }]}
  toolId="qr-code"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">QR Code Generator & Reader</h1>

    <div class="grid md:grid-cols-2 gap-4">
      <!-- Generator -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-3">Generate QR Code</h2>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Text or URL</label>
            <textarea
              id="qr-text"
              data-share-key="text"
              class="w-full h-24 p-3 border border-gray-300 dark:border-slate-600 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
              placeholder="Enter text or URL to encode..."
            ></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-1">Size</label>
              <select id="qr-size" data-share-key="size" class="w-full p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm">
                <option value="128">128 x 128</option>
                <option value="256" selected>256 x 256</option>
                <option value="512">512 x 512</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-1">Error Correction</label>
              <select id="qr-error" data-share-key="errorLevel" class="w-full p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm">
                <option value="L">Low (7%)</option>
                <option value="M" selected>Medium (15%)</option>
                <option value="Q">Quartile (25%)</option>
                <option value="H">High (30%)</option>
              </select>
            </div>
          </div>

          <button id="generate-btn" class="w-full px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
            Generate QR Code
          </button>

          <div id="qr-output" class="flex flex-col items-center">
            <canvas id="qr-canvas" class="border border-gray-200 dark:border-slate-700 rounded-lg"></canvas>
            <div class="mt-3 flex gap-2">
              <button id="download-png-btn" class="px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 text-sm">
                Download PNG
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Reader -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-3">Read QR Code</h2>

        <div class="space-y-4">
          <div
            id="reader-drop-zone"
            class="border-2 border-dashed border-gray-300 dark:border-slate-600 rounded-lg p-8 text-center hover:border-indigo-400 transition-colors cursor-pointer"
          >
            <svg class="w-12 h-12 mx-auto text-gray-400 dark:text-slate-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <p class="text-gray-600 dark:text-slate-300 mb-2">Drop QR code image here or click to browse</p>
            <p class="text-sm text-gray-400 dark:text-slate-500">Supports PNG, JPG, GIF</p>
            <input type="file" id="qr-file-input" accept="image/*" class="hidden" />
          </div>

          <div id="reader-preview-container" class="hidden">
            <img id="reader-preview" class="max-w-full h-auto max-h-48 mx-auto rounded-lg border border-gray-200 dark:border-slate-700" />
          </div>

          <div id="reader-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>

          <div id="reader-result" class="hidden">
            <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Decoded Content</label>
            <div class="p-3 bg-green-50 border border-green-200 rounded-lg">
              <p id="reader-content" class="text-sm font-mono break-all"></p>
            </div>
            <div class="mt-2 flex gap-2">
              <button id="copy-result-btn" class="px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 text-sm">
                Copy
              </button>
              <a id="open-url-btn" href="#" target="_blank" class="hidden px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">
                Open URL
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online QR Code Tool</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Generate QR codes from text or URLs, and read QR codes from images. Customize size and error correction level.
        Download generated QR codes as PNG images. All processing happens in your browser.
      </p>
    </div>
  </div>
</Layout>

<script>
  import QRCode from 'qrcode';
  import jsQR from 'jsqr';
  import { ShareManager } from '../lib/share';

  const qrText = document.getElementById('qr-text') as HTMLTextAreaElement;
  const qrSize = document.getElementById('qr-size') as HTMLSelectElement;
  const qrError = document.getElementById('qr-error') as HTMLSelectElement;
  const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const qrFileInput = document.getElementById('qr-file-input') as HTMLInputElement;
  const readerDropZone = document.getElementById('reader-drop-zone')!;
  const readerPreview = document.getElementById('reader-preview') as HTMLImageElement;
  const readerPreviewContainer = document.getElementById('reader-preview-container')!;
  const readerErrorEl = document.getElementById('reader-error')!;
  const readerResult = document.getElementById('reader-result')!;
  const readerContent = document.getElementById('reader-content')!;
  const openUrlBtn = document.getElementById('open-url-btn') as HTMLAnchorElement;

  function generateQR() {
    const text = qrText.value.trim();
    if (!text) {
      const ctx = qrCanvas.getContext('2d')!;
      qrCanvas.width = 256;
      qrCanvas.height = 256;
      ctx.fillStyle = '#f9fafb';
      ctx.fillRect(0, 0, 256, 256);
      ctx.fillStyle = '#9ca3af';
      ctx.font = '14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Enter text to generate QR', 128, 128);
      return;
    }

    const size = parseInt(qrSize.value, 10);
    const errorLevel = qrError.value as 'L' | 'M' | 'Q' | 'H';

    QRCode.toCanvas(qrCanvas, text, {
      width: size,
      margin: 2,
      errorCorrectionLevel: errorLevel,
      color: {
        dark: '#000000',
        light: '#ffffff'
      }
    }, (error) => {
      if (error) {
        console.error('QR generation error:', error);
      }
    });
  }

  function decodeQR(imageData: ImageData) {
    const code = jsQR(imageData.data, imageData.width, imageData.height);

    readerErrorEl.classList.add('hidden');
    readerResult.classList.add('hidden');

    if (code) {
      readerContent.textContent = code.data;
      readerResult.classList.remove('hidden');

      try {
        const url = new URL(code.data);
        openUrlBtn.href = url.href;
        openUrlBtn.classList.remove('hidden');
      } catch {
        openUrlBtn.classList.add('hidden');
      }
    } else {
      readerErrorEl.textContent = 'No QR code found in image';
      readerErrorEl.classList.remove('hidden');
    }
  }

  function processImage(file: File) {
    if (!file.type.startsWith('image/')) {
      readerErrorEl.textContent = 'Please select an image file';
      readerErrorEl.classList.remove('hidden');
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        readerPreview.src = e.target?.result as string;
        readerPreviewContainer.classList.remove('hidden');

        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d')!;
        canvas.width = img.width;
        canvas.height = img.height;
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        decodeQR(imageData);
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  document.getElementById('generate-btn')!.addEventListener('click', generateQR);
  qrText.addEventListener('input', generateQR);
  qrSize.addEventListener('change', generateQR);
  qrError.addEventListener('change', generateQR);

  document.getElementById('download-png-btn')!.addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = 'qrcode.png';
    link.href = qrCanvas.toDataURL('image/png');
    link.click();
  });

  qrFileInput.addEventListener('change', () => {
    const file = qrFileInput.files?.[0];
    if (file) processImage(file);
  });

  readerDropZone.addEventListener('click', () => {
    qrFileInput.click();
  });

  readerDropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    readerDropZone.classList.add('border-indigo-500', 'bg-indigo-50');
  });

  readerDropZone.addEventListener('dragleave', () => {
    readerDropZone.classList.remove('border-indigo-500', 'bg-indigo-50');
  });

  readerDropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    readerDropZone.classList.remove('border-indigo-500', 'bg-indigo-50');
    const file = e.dataTransfer?.files[0];
    if (file) processImage(file);
  });

  document.getElementById('copy-result-btn')!.addEventListener('click', () => {
    navigator.clipboard.writeText(readerContent.textContent || '');
  });

  ShareManager.register({
    tool: 'qr-code',
    afterLoad: () => generateQR()
  });

  generateQR();
</script>

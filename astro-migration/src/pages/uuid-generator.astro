---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="UUID Generator - v4 & v7"
  description="Generate UUID v4 (random) and UUID v7 (timestamp-based) identifiers. Bulk generate multiple UUIDs instantly. Free online UUID generator with copy functionality."
  keywords="UUID generator, generate UUID, UUID v4, UUID v7, GUID generator, random UUID, unique identifier, bulk UUID generator"
  breadcrumb={[{ name: "Encoding Tools", href: "/encoding-tools" }, { name: "UUID Generator" }]}
  toolId="uuid-generator"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">UUID Generator</h1>

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Version:</label>
          <select id="uuid-version" data-share-key="version" class="p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            <option value="4">v4 (Random)</option>
            <option value="7">v7 (Timestamp-based)</option>
          </select>
        </div>
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700 dark:text-slate-200">Count:</label>
          <input
            type="number"
            id="uuid-count"
            data-share-key="count"
            min="1"
            max="1000"
            value="1"
            class="w-20 p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          />
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="uppercase" data-share-key="uppercase" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
          <label for="uppercase" class="text-sm text-gray-700 dark:text-slate-200">Uppercase</label>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="no-hyphens" data-share-key="noHyphens" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
          <label for="no-hyphens" class="text-sm text-gray-700 dark:text-slate-200">No hyphens</label>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button id="generate-btn" data-share-action="generate" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
          Generate
        </button>
        <button id="copy-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
          Copy All
        </button>
        <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
          Clear
        </button>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
      <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Generated UUIDs</label>
      <textarea
        id="output"
        readonly
        class="w-full h-64 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-gray-50 dark:bg-slate-900 resize-none"
        placeholder="Click 'Generate' to create UUIDs..."
      ></textarea>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mt-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">UUID Validator</h3>
      <div class="flex gap-3">
        <input
          type="text"
          id="validate-input"
          class="flex-1 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          placeholder="Paste UUID to validate..."
        />
        <button id="validate-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
          Validate
        </button>
      </div>
      <div id="validation-result" class="hidden mt-3 p-3 rounded-lg text-sm"></div>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online UUID Generator</h2>
      <p class="text-gray-600 dark:text-slate-300 mb-4">
        Generate universally unique identifiers (UUIDs) instantly. Supports UUID v4 (random) and v7 (timestamp-based).
        Generate single or bulk UUIDs with customizable formatting options.
      </p>
      <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-600 dark:text-slate-300">
        <div>
          <h3 class="font-medium text-gray-700 dark:text-slate-200">UUID v4 (Random)</h3>
          <p>Generated using cryptographically secure random numbers. Best for most use cases requiring unique identifiers.</p>
        </div>
        <div>
          <h3 class="font-medium text-gray-700 dark:text-slate-200">UUID v7 (Timestamp-based)</h3>
          <p>Includes a Unix timestamp prefix for natural sorting. Ideal for database primary keys and distributed systems.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { ShareManager } from '../lib/share';

  const output = document.getElementById('output') as HTMLTextAreaElement;
  const uuidVersion = document.getElementById('uuid-version') as HTMLSelectElement;
  const uuidCount = document.getElementById('uuid-count') as HTMLInputElement;
  const uppercaseCheck = document.getElementById('uppercase') as HTMLInputElement;
  const noHyphensCheck = document.getElementById('no-hyphens') as HTMLInputElement;
  const validateInput = document.getElementById('validate-input') as HTMLInputElement;
  const validationResult = document.getElementById('validation-result');

  ShareManager.register({
    tool: 'uuid-generator',
    actions: {
      generate: () => document.getElementById('generate-btn')?.click(),
    }
  });

  function generateUUIDv4(): string {
    // Use crypto.randomUUID if available
    if (typeof crypto.randomUUID === 'function') {
      return crypto.randomUUID();
    }

    // Fallback implementation
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);

    // Set version (4) and variant (10xx)
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;

    const hex = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
  }

  function generateUUIDv7(): string {
    const now = Date.now();
    const bytes = new Uint8Array(16);

    // Fill with random bytes
    crypto.getRandomValues(bytes);

    // Set timestamp (48 bits)
    const timestamp = BigInt(now);
    bytes[0] = Number((timestamp >> 40n) & 0xffn);
    bytes[1] = Number((timestamp >> 32n) & 0xffn);
    bytes[2] = Number((timestamp >> 24n) & 0xffn);
    bytes[3] = Number((timestamp >> 16n) & 0xffn);
    bytes[4] = Number((timestamp >> 8n) & 0xffn);
    bytes[5] = Number(timestamp & 0xffn);

    // Set version (7) and variant (10xx)
    bytes[6] = (bytes[6] & 0x0f) | 0x70;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;

    const hex = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
  }

  function formatUUID(uuid: string): string {
    if (uppercaseCheck.checked) {
      uuid = uuid.toUpperCase();
    }
    if (noHyphensCheck.checked) {
      uuid = uuid.replace(/-/g, '');
    }
    return uuid;
  }

  function generate() {
    const version = uuidVersion.value;
    const count = Math.min(Math.max(1, parseInt(uuidCount.value, 10) || 1), 1000);

    const uuids: string[] = [];
    for (let i = 0; i < count; i++) {
      const uuid = version === '7' ? generateUUIDv7() : generateUUIDv4();
      uuids.push(formatUUID(uuid));
    }

    output.value = uuids.join('\n');
  }

  function validateUUID(uuid: string): { valid: boolean; version?: number; message: string } {
    // Remove hyphens for validation
    const cleanUuid = uuid.replace(/-/g, '').toLowerCase();

    // Check length
    if (cleanUuid.length !== 32) {
      return { valid: false, message: 'Invalid length. UUID must be 32 hex characters.' };
    }

    // Check if all hex
    if (!/^[0-9a-f]+$/.test(cleanUuid)) {
      return { valid: false, message: 'Invalid characters. UUID must contain only hex digits.' };
    }

    // Check format with hyphens
    const uuidWithHyphens = uuid.toLowerCase().replace(/-/g, '');
    const formatted = `${uuidWithHyphens.slice(0, 8)}-${uuidWithHyphens.slice(8, 12)}-${uuidWithHyphens.slice(12, 16)}-${uuidWithHyphens.slice(16, 20)}-${uuidWithHyphens.slice(20)}`;

    // Extract version (character at position 14, or index 12 in clean)
    const versionChar = cleanUuid[12];
    const version = parseInt(versionChar, 16);

    // Extract variant (character at position 19, or index 16 in clean)
    const variantChar = cleanUuid[16];
    const variantBits = parseInt(variantChar, 16);

    let variantType = '';
    if ((variantBits & 0x8) === 0) {
      variantType = 'NCS backward compatibility';
    } else if ((variantBits & 0xc) === 0x8) {
      variantType = 'RFC 4122/DCE 1.1';
    } else if ((variantBits & 0xe) === 0xc) {
      variantType = 'Microsoft GUID';
    } else {
      variantType = 'Reserved';
    }

    return {
      valid: true,
      version,
      message: `Valid UUID\nVersion: ${version}\nVariant: ${variantType}\nFormatted: ${formatted}`
    };
  }

  document.getElementById('generate-btn').addEventListener('click', generate);

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    output.value = '';
  });

  document.getElementById('validate-btn').addEventListener('click', () => {
    const uuid = validateInput.value.trim();
    if (!uuid) {
      validationResult.classList.add('hidden');
      return;
    }

    const result = validateUUID(uuid);
    validationResult.classList.remove('hidden');

    if (result.valid) {
      validationResult.className = 'mt-3 p-3 rounded-lg text-sm bg-green-50 border border-green-200 text-green-800 whitespace-pre-line';
    } else {
      validationResult.className = 'mt-3 p-3 rounded-lg text-sm bg-red-50 border border-red-200 text-red-800';
    }
    validationResult.textContent = result.message;
  });

  validateInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      document.getElementById('validate-btn').click();
    }
  });

  // Generate one UUID on page load
  generate();
</script>

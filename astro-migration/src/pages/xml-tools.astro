---
import Layout from '../layouts/Layout.astro';

const tools = [
  { name: 'XML Formatter', href: '/xml-formatter', description: 'Pretty print, validate, and beautify XML documents' },
  { name: 'XML ↔ JSON', href: '/xml-json-converter', description: 'Bidirectional conversion between XML and JSON with attribute handling' },
];
---

<Layout
  title="XML Tools"
  description="Free online XML tools for developers. Format, validate, and convert XML documents. XML formatter, XML to JSON converter with customizable attribute handling."
  keywords="XML tools, XML formatter, XML to JSON, JSON to XML, XML converter, XML validator, XML beautifier, online XML tools"
  breadcrumb={[{ name: "XML Tools" }]}
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-2">XML Tools</h1>
    <p class="text-gray-600 dark:text-slate-400 mb-6">Format, validate, and convert XML documents</p>

    <div class="grid md:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="block p-4 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-500 hover:shadow-md transition-all"
        >
          <h2 class="text-lg font-semibold text-indigo-600 dark:text-indigo-400 mb-1">{tool.name}</h2>
          <p class="text-sm text-gray-600 dark:text-slate-300">{tool.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-8 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-2">About XML Tools</h2>
      <p class="text-gray-600 dark:text-slate-300 text-sm">
        XML (Extensible Markup Language) is still widely used in enterprise systems, APIs, and configuration files.
        Our XML tools help you format minified XML for readability, validate document structure, and convert between
        XML and JSON with flexible attribute handling options. All processing happens in your browser.
      </p>
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const faqs = [
  ['What is JSONL or NDJSON?', 'JSON Lines and newline-delimited JSON store one complete JSON value on each line. It is common for logs, exports, streaming APIs, and model datasets.'],
  ['Does one bad line invalidate the whole file?', 'No. The viewer reports valid and invalid lines separately so you can inspect the first parse error while still previewing valid records.'],
  ['Can I convert JSONL to a JSON array?', 'Yes. Export the valid parsed records as a JSON array after reviewing invalid lines.'],
  ['Can I share a JSONL example?', 'Yes, for a small synthetic sample. Anyone with the link can read its included input, so never share production logs, tokens, or customer data.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'JSONL Viewer and NDJSON Validator', url: 'https://bugdays.com/jsonl-viewer/', description: 'Validate JSON Lines and NDJSON locally, find bad line numbers, preview records, filter them, inspect a selected value, and export valid records as a JSON array.', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['JSONL and NDJSON validation', 'Line-specific parse errors', 'Bounded record preview and text filter', 'Selected record inspection', 'Export valid records to JSON', 'Shareable synthetic examples'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---

<Layout title="JSONL Viewer & NDJSON Validator — JSON Lines to JSON" description="Validate JSONL or NDJSON locally, find invalid line numbers, preview and filter records, inspect one JSON value, and export valid lines as a JSON array. Copy, download, or share a safe example." keywords="JSONL viewer, NDJSON viewer, JSON Lines validator, JSONL parser, NDJSON parser, JSONL to JSON, newline delimited JSON, JSON Lines formatter" breadcrumb={[{ name: 'JSON Tools', href: '/json-tools/' }, { name: 'JSONL Viewer' }]} toolId="jsonl-viewer" jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-1">JSONL Viewer &amp; NDJSON Validator</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Inspect newline-delimited JSON one record at a time. Find the bad line, preview valid records, export a JSON array, or share a small scrubbed example.</p>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="mb-2 flex items-center justify-between gap-3"><label for="jsonl-input" class="text-sm font-semibold text-slate-700 dark:text-slate-200">JSON Lines / NDJSON input</label><label class="cursor-pointer text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Open local file<input id="jsonl-file" type="file" accept=".jsonl,.ndjson,.json,text/plain,application/x-ndjson" class="hidden" /></label></div>
      <textarea id="jsonl-input" data-share-key="jsonl" class="h-64 w-full resize-none rounded-lg border border-slate-300 p-3 font-mono text-sm text-slate-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder='{"event":"started","id":1}\n{"event":"finished","id":1}' spellcheck="false"></textarea>
      <p id="file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Input stays in this browser.</p>
      <div class="mt-3 flex flex-wrap gap-2"><button id="parse-btn" data-share-action="parse" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Validate &amp; view lines</button><button id="export-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Download valid JSON</button><button id="share-jsonl-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Share example ↗</button><button id="sample-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Load sample</button><button id="clear-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Clear</button></div>
    </section>

    <div id="error-box" role="alert" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>
    <section id="results" class="hidden mt-4 space-y-4">
      <div class="grid gap-3 sm:grid-cols-3"><div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800"><span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Non-empty lines</span><strong id="line-count" class="mt-1 block text-2xl text-slate-900 dark:text-white">0</strong></div><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30"><span class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">Valid JSON values</span><strong id="valid-count" class="mt-1 block text-2xl text-emerald-800 dark:text-emerald-100">0</strong></div><div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900/60 dark:bg-red-950/30"><span class="text-xs font-semibold uppercase tracking-wide text-red-700 dark:text-red-300">Invalid lines</span><strong id="invalid-count" class="mt-1 block text-2xl text-red-800 dark:text-red-100">0</strong></div></div>
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.8fr)]"><div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-3 dark:border-slate-700"><label for="filter-input" class="text-sm font-semibold text-slate-700 dark:text-slate-200">Records <span id="preview-note" class="font-normal text-slate-500 dark:text-slate-400"></span></label><input id="filter-input" data-share-key="filter" class="w-48 rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900" placeholder="Filter visible JSON…" /></div><div class="max-h-[30rem] overflow-auto"><table class="w-full text-left text-sm"><thead class="sticky top-0 bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900"><tr><th class="px-3 py-2">Line</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Preview</th></tr></thead><tbody id="records-body"></tbody></table></div></div><aside class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="flex items-center justify-between gap-3"><h2 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Selected record</h2><button id="copy-record-btn" type="button" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Copy</button></div><pre id="selected-record" class="mt-3 max-h-[28rem] overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-950 p-3 text-xs leading-6 text-slate-100">Select a valid record to inspect it.</pre></aside></div>
    </section>

    <div class="mt-7 grid gap-4 md:grid-cols-3 text-sm"><a href="/json-formatter/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">One JSON value?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Format, validate, search, and explore a regular JSON document.</span></a><a href="/access-log-analyzer/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Access-log JSON?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Analyze traffic, errors, and client networks locally.</span></a><a href="/json-to-code/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Need typed models?</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Generate TypeScript, Zod, or Pydantic from a representative record.</span></a></div>

    <section class="mt-8 max-w-4xl space-y-5 text-sm leading-7 text-slate-600 dark:text-slate-300"><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">JSONL, NDJSON, and JSON Lines are one-record-per-line formats</h2><p class="mt-2">A JSON Lines file contains one complete JSON value on each non-empty line. That makes it useful for logs, streaming exports, and datasets because a reader can process one record at a time. A normal JSON array is different: it has one enclosing <code>[</code> and <code>]</code> around every record.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Find the line that breaks a pipeline</h2><p class="mt-2">The viewer validates each line independently, so a malformed record does not hide the valid ones. Filter the bounded preview, select a record to see formatted JSON, and download valid records as an array only after deciding how to handle any errors. Read the <a href="/guides/jsonl-ndjson-viewer-validator/" class="text-indigo-600 underline dark:text-indigo-400">JSONL and NDJSON troubleshooting guide</a> for ingestion and conversion examples.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Share synthetic data only</h2><p class="mt-2">A share link carries the JSONL input and filter state, which is useful for a minimal reproducible example. It is not a secret store. Redact user records, access tokens, internal hostnames, and log context before sharing a link with anyone else.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">JSONL viewer questions</h2><div class="mt-3 space-y-2">{faqs.map(([question, answer]) => <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-100">{question}</summary><p class="mt-2">{answer}</p></details>)}</div></div></section>
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import { ShareManager } from '../lib/share.ts';
  type RecordLine = { line: number; raw: string; value?: unknown; error?: string; preview: string };
  const input = document.getElementById('jsonl-input') as HTMLTextAreaElement;
  const filterInput = document.getElementById('filter-input') as HTMLInputElement;
  const results = document.getElementById('results')!;
  const errorBox = document.getElementById('error-box')!;
  const recordsBody = document.getElementById('records-body')!;
  const selectedRecord = document.getElementById('selected-record')!;
  const fileStatus = document.getElementById('file-status')!;
  const fileInput = document.getElementById('jsonl-file') as HTMLInputElement;
  const sample = '{"event":"started","id":1,"labels":["api","blue"]}\n{"event":"finished","id":1,"durationMs":142}\n{"event":"started","id":2,"ok":true}';
  let parsed: RecordLine[] = [];
  const previewLimit = 500;
  ShareManager.register({ tool: 'jsonl-viewer', actions: { parse: () => document.getElementById('parse-btn')?.click() } });
  document.getElementById('share-jsonl-btn')!.addEventListener('click', () => document.getElementById('share-btn')?.click());
  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function hideError() { errorBox.classList.add('hidden'); }
  function shortPreview(raw: string) { return raw.length > 180 ? `${raw.slice(0, 177)}…` : raw; }
  function parseLines() {
    const lines = input.value.split(/\r?\n/); parsed = [];
    lines.forEach((raw, index) => { if (!raw.trim()) return; try { const value = JSON.parse(raw); parsed.push({ line: index + 1, raw, value, preview: shortPreview(raw) }); } catch (error) { parsed.push({ line: index + 1, raw, error: error instanceof Error ? error.message : 'Invalid JSON', preview: shortPreview(raw) }); } });
    if (!parsed.length) { showError('Paste at least one non-empty JSON line first.'); results.classList.add('hidden'); return; }
    hideError(); results.classList.remove('hidden');
    const valid = parsed.filter(record => record.value !== undefined);
    document.getElementById('line-count')!.textContent = String(parsed.length);
    document.getElementById('valid-count')!.textContent = String(valid.length);
    document.getElementById('invalid-count')!.textContent = String(parsed.length - valid.length);
    renderRecords();
    if (parsed.some(record => record.error)) showError(`Invalid JSON on line${parsed.filter(record => record.error).length > 1 ? 's' : ''} ${parsed.filter(record => record.error).slice(0, 5).map(record => record.line).join(', ')}. Valid records remain available below.`);
  }
  function renderRecords() {
    const query = filterInput.value.trim().toLowerCase();
    const visible = parsed.filter(record => !query || record.raw.toLowerCase().includes(query));
    const displayed = visible.slice(0, previewLimit);
    const note = document.getElementById('preview-note')!; note.textContent = `${visible.length === parsed.length ? '' : `${visible.length} matching · `}${displayed.length}${visible.length > displayed.length ? ` of ${visible.length}` : ''} shown`;
    recordsBody.replaceChildren(...displayed.map(record => { const row = document.createElement('tr'); row.className = `border-t border-slate-100 dark:border-slate-700 ${record.value === undefined ? 'bg-red-50/50 dark:bg-red-950/15' : 'cursor-pointer hover:bg-indigo-50 dark:hover:bg-indigo-950/30'}`; const line = document.createElement('td'); line.className = 'px-3 py-2 font-mono text-xs text-slate-500'; line.textContent = String(record.line); const status = document.createElement('td'); status.className = record.value === undefined ? 'px-3 py-2 text-xs font-semibold text-red-700 dark:text-red-300' : 'px-3 py-2 text-xs font-semibold text-emerald-700 dark:text-emerald-300'; status.textContent = record.value === undefined ? 'Invalid' : 'Valid'; const preview = document.createElement('td'); preview.className = 'max-w-0 truncate px-3 py-2 font-mono text-xs text-slate-700 dark:text-slate-200'; preview.textContent = record.preview; row.append(line, status, preview); if (record.value !== undefined) row.addEventListener('click', () => { selectedRecord.textContent = JSON.stringify(record.value, null, 2); }); else row.title = record.error || 'Invalid JSON'; return row; }));
  }
  document.getElementById('parse-btn')!.addEventListener('click', parseLines);
  filterInput.addEventListener('input', () => { if (parsed.length) renderRecords(); });
  document.getElementById('copy-record-btn')!.addEventListener('click', () => { if (!selectedRecord.textContent?.startsWith('Select a valid')) navigator.clipboard.writeText(selectedRecord.textContent || ''); });
  document.getElementById('sample-btn')!.addEventListener('click', () => { input.value = sample; fileStatus.textContent = 'Synthetic sample loaded. Nothing was uploaded.'; parseLines(); });
  document.getElementById('clear-btn')!.addEventListener('click', () => { input.value = ''; filterInput.value = ''; parsed = []; results.classList.add('hidden'); selectedRecord.textContent = 'Select a valid record to inspect it.'; fileStatus.textContent = 'Input stays in this browser.'; hideError(); });
  document.getElementById('export-btn')!.addEventListener('click', () => { const valid = parsed.filter(record => record.value !== undefined).map(record => record.value); if (!valid.length) return showError('Validate at least one valid JSON line before exporting.'); track('export_used', { tool: 'jsonl-viewer', format: 'json' }); const href = URL.createObjectURL(new Blob([JSON.stringify(valid, null, 2)], { type: 'application/json;charset=utf-8' })); const link = document.createElement('a'); link.href = href; link.download = 'jsonl-valid-records.json'; link.click(); URL.revokeObjectURL(href); });
  fileInput.addEventListener('change', async () => { const file = fileInput.files?.[0]; fileInput.value = ''; if (!file) return; if (file.size > 10 * 1024 * 1024) return showError('Choose a JSONL file smaller than 10 MB.'); try { input.value = await file.text(); fileStatus.textContent = `Loaded ${Math.max(1, Math.round(file.size / 1024))} KB locally. Nothing was uploaded.`; parseLines(); } catch { showError('The local JSONL file could not be read.'); } });
</script>

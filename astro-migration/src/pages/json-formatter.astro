---
import Layout from '../layouts/Layout.astro';
import JsonEditor from '../components/JsonEditor.astro';
import JsonToolContent from '../components/JsonToolContent.astro';
import { formatterFaqs } from '../lib/json-examples.ts';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "JSON Formatter & Validator",
    "description": "Format, minify and validate JSON without rounding large numbers or dropping duplicate keys. Explore a lazy tree, copy jq paths and JSON Pointers, and share examples.",
    "url": "https://bugdays.com/json-formatter/",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": ["Lossless JSON formatting and minification", "2-space, 4-space and tab indentation", "JSON syntax validation with line and column errors", "Duplicate-key detection", "Large integer preservation", "Line numbers and search", "Lazy tree viewer", "jq paths and JSON Pointer", "Local file loading", "Undo formatting", "Shareable JSON examples"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": formatterFaqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } }))
  }
];
---

<Layout
  title="JSON Formatter & Validator — Beautify, Minify & Share"
  description="Format, validate and minify JSON online without rounding large numbers. Find errors, explore a JSON tree, copy paths, and share examples. Free, browser-local."
  image="/og/json-formatter.png" imageAlt="JSON formatter preserving a large numeric ID and duplicate keys, with a shareable tree view" imageWidth={1280} imageHeight={720}
  keywords="JSON formatter, JSON beautifier, JSON prettify, JSON validator, JSON pretty print, format JSON online, JSON beautify, validate JSON, JSON viewer, JSON parser, minify JSON, JSON lint, JSON checker"
  breadcrumb={[{ name: "JSON Tools", href: "/json-tools/" }, { name: "JSON Formatter" }]}
  toolId="json-formatter"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto" id="formatter-workspace">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-1">JSON Formatter & Validator</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Beautify, minify, or explore JSON. Exact numbers and duplicate keys stay intact. Everything runs in your browser.</p>

    <div class="min-w-0 overflow-hidden bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700">
      <!-- Toolbar -->
      <div class="flex flex-wrap items-center gap-2 p-3 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
        <div id="text-buttons" class="flex flex-wrap gap-2">
          <button id="prettify-btn" data-share-action="prettify" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 transition-colors text-sm font-medium">
            Prettify
          </button>
          <button id="compact-btn" data-share-action="compact" class="json-secondary">
            Compact
          </button>
          <button id="validate-btn" data-share-action="validate" class="json-secondary">Validate</button>
          <button id="tree-btn" data-share-action="tree" class="json-secondary">
            Tree & Fold
          </button>
        </div>
        <div id="tree-buttons" class="hidden flex flex-wrap gap-2">
          <button id="back-btn" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 transition-colors text-sm font-medium">
            Back to text
          </button>
          <button id="expand-btn" class="json-secondary">
            Expand All
          </button>
          <button id="collapse-btn" class="json-secondary">
            Collapse All
          </button>
        </div>

        <div class="flex-1"></div>
        <button id="cancel-btn" class="json-secondary hidden">Cancel</button>
        <button id="share-json-btn" class="rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Share JSON ↗</button>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-slate-200 px-3 py-2 dark:border-slate-700">
        <label for="json-indent" class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300">Indent <select id="json-indent" data-share-key="indent" class="rounded border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-600 dark:bg-slate-800"><option value="2">2 spaces</option><option value="4">4 spaces</option><option value="tab">Tabs</option></select></label>
        <button id="find-btn" class="rounded px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700">Find</button>
        <button id="file-btn" class="rounded px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700">Open file</button>
        <input id="json-file" type="file" accept="application/json,.json,text/plain" class="hidden" />
        <button id="sample-btn" class="rounded px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700">Load sample</button>
        <button id="undo-btn" class="json-secondary" disabled>Undo</button><button id="clear-btn" class="json-secondary">Clear</button>
        <div class="flex-1"></div>

        <div class="relative">
          <button id="copy-btn" class="p-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 hover:bg-gray-100 dark:hover:bg-slate-700 rounded transition-colors" title="Copy JSON" aria-label="Copy JSON">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </button>
          <span id="copied-msg" class="hidden absolute -top-8 left-1/2 -translate-x-1/2 bg-green-500 text-white text-xs px-2 py-1 rounded whitespace-nowrap">Copied!</span>
        </div>
        <button id="download-btn" class="p-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 hover:bg-gray-100 dark:hover:bg-slate-700 rounded transition-colors" title="Download JSON" aria-label="Download JSON">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
        </button>
      </div>

      <!-- Error message -->
      <div id="error-box" role="alert" class="hidden flex flex-wrap items-center gap-3 bg-red-50 dark:bg-red-900/30 border-l-4 border-red-500 p-4">
        <p class="text-red-700 dark:text-red-300 text-sm">
          <span class="font-medium">Invalid JSON:</span> <span id="error-text"></span>
        </p>
        <button id="error-jump-btn" class="hidden rounded border border-red-300 px-2 py-1 text-xs font-semibold text-red-800 hover:bg-red-100 dark:border-red-800 dark:text-red-200 dark:hover:bg-red-950/50">Jump to error</button>
      </div>

      <div id="formatter-find-bar" class="hidden flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
        <label for="formatter-find-input" class="text-sm font-medium text-slate-700 dark:text-slate-200">Find keys or values</label>
        <input id="formatter-find-input" type="search" class="min-w-0 flex-1 rounded border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" placeholder="Search this JSON" />
        <span id="formatter-find-count" class="min-w-20 text-right text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></span>
        <button id="formatter-find-prev" class="rounded border border-slate-300 px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-200 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" title="Previous match" aria-label="Previous match">↑</button>
        <button id="formatter-find-next" class="rounded border border-slate-300 px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-200 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" title="Next match" aria-label="Next match">↓</button>
        <button id="formatter-find-close" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700" aria-label="Close find">×</button>
      </div>

      <!-- Editor area -->
      <div id="editor-view" class="p-3">
        <JsonEditor id="editor" label="JSON input" shareKey="json" height="formatter-editor-height" />
        <p id="file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Drop a JSON file here or choose Open file. Nothing is uploaded.</p>
      </div>

      <!-- Tree View -->
      <div id="tree-view" class="hidden formatter-editor-height p-4 overflow-auto font-mono text-sm" aria-label="JSON tree"></div>

      <!-- Path tooltip -->
      <div id="path-tooltip" class="hidden border-t border-indigo-200 bg-indigo-50 p-3 dark:border-indigo-900 dark:bg-indigo-950/30">
        <p class="mb-2 text-xs text-slate-600 dark:text-slate-300">Selected value · copy a path or the exact JSON</p>
        <div class="flex flex-wrap gap-2"><button id="path-copy-btn" class="json-secondary min-w-0 max-w-full break-all text-left" aria-label="Copy jq path"><span class="text-xs">jq </span><code id="path-text"></code></button><button id="pointer-copy-btn" class="json-secondary">Copy JSON Pointer</button><button id="value-copy-btn" class="json-secondary">Copy value</button></div>
        <p id="pointer-text" class="mt-2 break-all font-mono text-xs text-slate-500 dark:text-slate-400"></p>
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-1 border-t border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"><p id="formatter-status" role="status" class="min-w-0 flex-1">Paste JSON, open a file, or try the sample.</p><span id="json-size"></span></div>
      <details id="json-findings" class="hidden border-t border-slate-200 p-3 text-xs dark:border-slate-700"><summary id="json-findings-summary" class="cursor-pointer font-semibold text-slate-700 dark:text-slate-200"></summary><ul id="json-findings-list" class="mt-2 space-y-2 break-words text-slate-600 dark:text-slate-300"></ul></details>
    </div>

    <JsonToolContent tool="formatter" />

  </div>
</Layout>

<script>import '../lib/json-formatter-ui.ts';</script>
<style>
  /* Reserve room for the header, toolbars and bottom status instead of letting
     a fixed-height editor push the rest of the workflow below the fold. */
  #formatter-workspace :global(.formatter-editor-height) { height:clamp(10rem, calc(100svh - 24rem), 20rem); }
  @media (max-width:639px) {
    #formatter-workspace :global(.formatter-editor-height) { height:clamp(9rem, calc(100svh - 37rem), 15rem); }
  }
  .json-secondary { border:1px solid #cbd5e1; border-radius:.4rem; padding:.4rem .65rem; font-size:.8125rem; font-weight:600; color:#334155; background:white; cursor:pointer; }
  .json-secondary:hover { background:#eef2ff; } button:disabled { cursor:default; opacity:.4; }
  button:focus-visible { outline:2px solid #6366f1; outline-offset:2px; }
  :global(.dark) .json-secondary { border-color:#475569; color:#e2e8f0; background:#1e293b; }
  :global(.dark) .json-secondary:hover { background:#334155; }
  :global(.json-tree-row) { display:flex; align-items:baseline; gap:.4rem; min-width:0; padding:.22rem 0; }
  :global(.json-tree-value) { text-align:left; overflow-wrap:anywhere; min-width:0; color:#047857; }
  :global(.json-tree-key) { color:#0369a1; overflow-wrap:anywhere; }
  :global(.json-tree-value:hover) { background:#eef2ff; border-radius:.2rem; }
  :global(.json-tree-children) { margin-left:.65rem; border-left:1px solid #cbd5e1; padding-left:.5rem; }
  :global(.json-tree-row .json-tree-toggle) { flex-shrink:0; width:1.3rem; padding:0; color:#64748b; }
  :global(.json-tree-more) { margin:.4rem 0; color:#4f46e5; font-weight:600; }
  :global(.dark) .json-tree-value { color:#6ee7b7; } :global(.dark) .json-tree-key { color:#7dd3fc; }
  :global(.dark) .json-tree-children { border-color:#475569; } :global(.dark) .json-tree-value:hover { background:#334155; }
  :global(.dark) .json-tree-more { color:#a5b4fc; }
</style>

7px 9px;border-radius:6px;font-size:11px;color:var(--d-muted);cursor:pointer}.dns-segments input:checked+span{background:var(--d-card);color:var(--d-ink);font-weight:700;box-shadow:0 1px 3px #0f172a14}.dns-types{display:flex;flex-wrap:wrap;gap:6px}.dns-types span{display:block;padding:5px 8px;border:1px solid var(--d-border);border-radius:6px;font:10px ui-monospace,monospace;color:var(--d-muted);cursor:pointer}.dns-types input:checked+span{border-color:#6366f1;background:#6366f112;color:var(--d-accent);font-weight:700}.dns-types-disabled .dns-types{opacity:.35;pointer-events:none}#dns-reverse-note{font-size:10px;color:var(--d-muted);line-height:1.5;margin-top:8px}.dns-primary,.dns-export button{border:1px solid #4f46e5;border-radius:8px;background:#4f46e5;color:#fff;padding:10px 12px;font-size:11px;font-weight:700;cursor:pointer}.dns-controls>.dns-primary{width:100%;margin-top:20px;display:flex;justify-content:space-between}.dns-primary:disabled{opacity:.6}.dns-link{color:var(--d-accent);font-size:11px;font-weight:650;margin-top:13px}.dns-bridge-settings{border-top:1px solid var(--d-border);margin-top:20px;padding-top:15px;color:var(--d-muted);font-size:10px;line-height:1.55}.dns-bridge-settings summary{cursor:pointer;font-weight:650;color:var(--d-ink);margin-bottom:10px}.dns-bridge-settings code{display:block;overflow-wrap:anywhere;background:var(--d-soft);border:1px solid var(--d-border);border-radius:6px;padding:7px;margin:7px 0}.dns-results-column{min-width:0}.dns-empty{min-height:430px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:34px;background:radial-gradient(ellipse at 50% 10%,#6366f10b,transparent 60%),var(--d-card)}.dns-empty h2{font-size:21px;font-weight:720;margin:25px 0 8px}.dns-empty p{font-size:13px;line-height:1.7;color:var(--d-muted);max-width:500px}.dns-route{display:flex;align-items:center;gap:10px;color:var(--d-muted);font:10px ui-monospace,monospace}.dns-route i{display:block;width:55px;b
---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="WebSocket Client - Test WebSocket Connections Online"
  description="Free online WebSocket client to test WS and WSS connections. Send and receive messages in real-time, view connection status, and debug WebSocket APIs."
  keywords="websocket client, websocket tester, ws client online, wss tester, websocket debugger, real-time api testing, websocket connection test"
  breadcrumb={[{ name: "Network Tools", href: "/network-tools" }, { name: "WebSocket Client" }]}
  toolId="websocket-client"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">WebSocket Client</h1>

    <!-- Connection -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <div class="flex flex-wrap gap-3 mb-4">
        <input
          type="text"
          id="ws-url"
          class="flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100"
          placeholder="wss://echo.websocket.org or ws://localhost:8080"
          value="wss://echo.websocket.org"
        />
        <button id="connect-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
          Connect
        </button>
        <button id="disconnect-btn" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium hidden">
          Disconnect
        </button>
      </div>

      <!-- Proxy Settings -->
      <div class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-slate-900 rounded-lg mb-4">
        <input type="checkbox" id="use-proxy" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
        <label for="use-proxy" class="text-sm text-gray-700 dark:text-slate-200">Use CORS Proxy (for HTTP upgrade)</label>
        <input
          type="text"
          id="proxy-url"
          class="flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100"
          placeholder="http://localhost:2345/"
          value="http://localhost:2345/"
          disabled
        />
        <button id="proxy-info-btn" class="text-indigo-600 hover:text-indigo-800 text-sm">
          Setup Instructions
        </button>
      </div>

      <!-- Connection Status -->
      <div class="flex items-center gap-2">
        <span id="status-indicator" class="w-3 h-3 rounded-full bg-gray-400"></span>
        <span id="status-text" class="text-sm text-gray-600 dark:text-slate-400">Disconnected</span>
      </div>
    </div>

    <!-- Send Message -->
    <div id="send-section" class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4 opacity-50 pointer-events-none">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-3">Send Message</h3>
      <div class="flex gap-3">
        <select id="msg-type" class="p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100">
          <option value="text">Text</option>
          <option value="json">JSON</option>
        </select>
        <textarea
          id="message-input"
          class="flex-1 p-2 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm resize-none bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100"
          rows="2"
          placeholder="Enter message to send..."
        ></textarea>
        <button id="send-btn" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium self-end">
          Send
        </button>
      </div>
    </div>

    <!-- Messages Log -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200">Messages</h3>
        <button id="clear-btn" class="text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 rounded text-gray-700 dark:text-slate-200">
          Clear
        </button>
      </div>
      <div id="messages-log" class="h-96 overflow-y-auto bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-200 dark:border-slate-700 p-3 font-mono text-sm space-y-2">
        <div class="text-gray-400 dark:text-slate-500 text-center py-8">Connect to a WebSocket server to start</div>
      </div>
    </div>

    <!-- Proxy Setup Modal -->
    <div id="proxy-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4 p-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-100 mb-4">CORS Proxy Setup</h3>
        <div class="space-y-4 text-sm text-gray-600 dark:text-slate-300">
          <p>For WebSocket connections through a proxy, run <a href="https://github.com/bugdays-com/holy-cors" target="_blank" class="text-indigo-600 hover:underline">Holy CORS</a> locally:</p>
          <div class="bg-gray-800 text-green-400 p-3 rounded-lg font-mono text-xs overflow-auto">
            <p class="text-gray-400"># macOS (Homebrew)</p>
            <p>brew install bugdays-com/tap/holy-cors</p>
            <p>holy-cors</p>
          </div>
          <div class="bg-gray-800 text-green-400 p-3 rounded-lg font-mono text-xs overflow-auto">
            <p class="text-gray-400"># Docker</p>
            <p>docker run -p 2345:2345 ghcr.io/bugdays-com/holy-cors</p>
          </div>
          <p class="text-yellow-600">Note: Most WebSocket servers support cross-origin connections natively. Only use the proxy if you encounter connection issues.</p>
        </div>
        <button id="close-modal-btn" class="mt-4 px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 dark:hover:bg-slate-500">Close</button>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online WebSocket Tester</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Test WebSocket connections in real-time. Connect to WS or WSS endpoints, send text or JSON messages,
        and view incoming messages with timestamps. Perfect for debugging WebSocket APIs and real-time applications.
      </p>
    </div>
  </div>
</Layout>

<script>
  let ws: WebSocket | null = null;

  const wsUrlInput = document.getElementById('ws-url') as HTMLInputElement;
  const connectBtn = document.getElementById('connect-btn') as HTMLButtonElement;
  const disconnectBtn = document.getElementById('disconnect-btn') as HTMLButtonElement;
  const sendSection = document.getElementById('send-section') as HTMLDivElement;
  const messageInput = document.getElementById('message-input') as HTMLTextAreaElement;
  const msgTypeSelect = document.getElementById('msg-type') as HTMLSelectElement;
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const messagesLog = document.getElementById('messages-log') as HTMLDivElement;
  const statusIndicator = document.getElementById('status-indicator') as HTMLSpanElement;
  const statusText = document.getElementById('status-text') as HTMLSpanElement;
  const useProxyCheckbox = document.getElementById('use-proxy') as HTMLInputElement;
  const proxyUrlInput = document.getElementById('proxy-url') as HTMLInputElement;
  const proxyModal = document.getElementById('proxy-modal');

  // Proxy toggle
  useProxyCheckbox?.addEventListener('change', () => {
    proxyUrlInput.disabled = !useProxyCheckbox.checked;
  });

  function setStatus(status: 'connecting' | 'connected' | 'disconnected' | 'error') {
    const colors: Record<string, string> = {
      connecting: 'bg-yellow-400',
      connected: 'bg-green-500',
      disconnected: 'bg-gray-400',
      error: 'bg-red-500'
    };
    const texts: Record<string, string> = {
      connecting: 'Connecting...',
      connected: 'Connected',
      disconnected: 'Disconnected',
      error: 'Connection Error'
    };

    statusIndicator.className = `w-3 h-3 rounded-full ${colors[status]}`;
    statusText.textContent = texts[status];

    if (status === 'connected') {
      connectBtn.classList.add('hidden');
      disconnectBtn.classList.remove('hidden');
      sendSection.classList.remove('opacity-50', 'pointer-events-none');
    } else {
      connectBtn.classList.remove('hidden');
      disconnectBtn.classList.add('hidden');
      sendSection.classList.add('opacity-50', 'pointer-events-none');
    }
  }

  function formatTime(): string {
    return new Date().toLocaleTimeString('en-US', { hour12: false });
  }

  function addMessage(type: 'sent' | 'received' | 'system' | 'error', content: string) {
    const placeholder = messagesLog.querySelector('.text-center');
    if (placeholder) placeholder.remove();

    const div = document.createElement('div');
    const time = formatTime();

    const colors: Record<string, string> = {
      sent: 'text-blue-600 dark:text-blue-400',
      received: 'text-green-600 dark:text-green-400',
      system: 'text-gray-500 dark:text-slate-400',
      error: 'text-red-600 dark:text-red-400'
    };
    const prefixes: Record<string, string> = {
      sent: '→',
      received: '←',
      system: '●',
      error: '✕'
    };

    div.className = colors[type];
    div.innerHTML = `<span class="text-gray-400 dark:text-slate-500">[${time}]</span> <span class="font-semibold">${prefixes[type]}</span> ${escapeHtml(content)}`;

    messagesLog.appendChild(div);
    messagesLog.scrollTop = messagesLog.scrollHeight;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function connect() {
    let url = wsUrlInput.value.trim();
    if (!url) {
      addMessage('error', 'Please enter a WebSocket URL');
      return;
    }

    // Handle proxy
    if (useProxyCheckbox.checked) {
      const proxyUrl = proxyUrlInput.value.trim();
      // Convert ws:// to http:// and wss:// to https:// for the proxy
      const httpUrl = url.replace(/^ws:/, 'http:').replace(/^wss:/, 'https:');
      url = proxyUrl + httpUrl;
      // Then convert back to ws/wss
      url = url.replace(/^http:/, 'ws:').replace(/^https:/, 'wss:');
    }

    setStatus('connecting');
    addMessage('system', `Connecting to ${wsUrlInput.value.trim()}...`);

    try {
      ws = new WebSocket(url);

      ws.onopen = () => {
        setStatus('connected');
        addMessage('system', 'Connection established');
      };

      ws.onmessage = (event) => {
        let content = event.data;
        try {
          const json = JSON.parse(content);
          content = JSON.stringify(json, null, 2);
        } catch {
          // Not JSON, display as-is
        }
        addMessage('received', content);
      };

      ws.onerror = () => {
        setStatus('error');
        const isCorsLikely = !ws || ws.readyState === WebSocket.CLOSED;
        if (isCorsLikely && !useProxyCheckbox.checked) {
          addMessage('error', 'Connection failed. If this is a CORS issue, try enabling the proxy.');
        } else if (isCorsLikely && useProxyCheckbox.checked) {
          addMessage('error', 'Connection failed. Is Holy CORS running? Start it with: holy-cors');
        } else {
          addMessage('error', 'WebSocket error occurred');
        }
      };

      ws.onclose = (event) => {
        setStatus('disconnected');
        addMessage('system', `Connection closed (code: ${event.code}${event.reason ? ', reason: ' + event.reason : ''})`);
        ws = null;
      };

    } catch (err) {
      setStatus('error');
      addMessage('error', `Failed to connect: ${(err as Error).message}`);
    }
  }

  function disconnect() {
    if (ws) {
      ws.close();
      ws = null;
    }
  }

  function sendMessage() {
    if (!ws || ws.readyState !== WebSocket.OPEN) {
      addMessage('error', 'Not connected');
      return;
    }

    let message = messageInput.value;
    if (!message.trim()) return;

    if (msgTypeSelect.value === 'json') {
      try {
        JSON.parse(message);
      } catch {
        addMessage('error', 'Invalid JSON');
        return;
      }
    }

    ws.send(message);
    addMessage('sent', message);
    messageInput.value = '';
  }

  connectBtn.addEventListener('click', connect);
  disconnectBtn.addEventListener('click', disconnect);
  sendBtn.addEventListener('click', sendMessage);

  messageInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    messagesLog.innerHTML = '<div class="text-gray-400 dark:text-slate-500 text-center py-8">Messages cleared</div>';
  });

  // Proxy modal
  document.getElementById('proxy-info-btn')?.addEventListener('click', () => {
    proxyModal?.classList.remove('hidden');
  });

  document.getElementById('close-modal-btn')?.addEventListener('click', () => {
    proxyModal?.classList.add('hidden');
  });

  proxyModal?.addEventListener('click', (e) => {
    if (e.target === proxyModal) proxyModal.classList.add('hidden');
  });

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => {
    if (ws) ws.close();
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../lib/guides';

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bug Days Developer Guides',
  description: 'Practical field guides for GZip and Base64 payloads, JVM diagnostics, SOAP APIs, certificates, database documentation, and terminal data.',
  url: 'https://bugdays.com/guides/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: `https://bugdays.com/guides/${guide.slug}/`,
    })),
  },
}];
---

<Layout
  title="Developer Guides: Payloads, APIs & Debugging"
  description="Example-driven guides to GZip Base64 decoding, Java thread dumps, SOAP APIs, certificate formats, SQL schemas, and terminal tables. Try the workflows in your browser."
  keywords="developer guides, gzip base64 guide, base64 gzip examples, Java thread dump guide, SOAP API testing guide, certificate formats, DDL ER diagram, terminal table Excel"
  breadcrumb={[{ name: 'Developer Guides' }]}
  jsonLd={jsonLd}
>
  <main class="max-w-6xl mx-auto">
    <header class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Bug Days field guides</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-slate-950 dark:text-white">Useful answers for inconvenient developer problems</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">Short on theory, long on recognizable evidence. These guides explain what to inspect, why it matters, which mistakes waste time, and how to move from raw diagnostic material to a defensible answer.</p>
      <a href="/guides/rss.xml" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"><span aria-hidden="true">◉</span> Subscribe with RSS</a>
    </header>

    <div class="mt-9 grid md:grid-cols-2 gap-6">
      {guides.map((guide, index) => (
        <article class:list={["group overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm", index === 0 && "md:col-span-2 md:grid md:grid-cols-2"]}>
          <a href={`/guides/${guide.slug}`} class="block overflow-hidden bg-slate-100 dark:bg-slate-900">
            <img src={guide.image} alt="" width="1280" height="720" loading={index === 0 ? 'eager' : 'lazy'} class="w-full aspect-video object-cover group-hover:scale-[1.015] transition-transform duration-300" />
          </a>
          <div class="p-6">
            <div class="flex items-center gap-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400"><span>{guide.topic}</span><span aria-hidden="true">·</span><span>{guide.readingMinutes} min</span></div>
            <h2 class="mt-2 text-xl md:text-2xl font-bold leading-snug text-slate-900 dark:text-white"><a href={`/guides/${guide.slug}`} class="hover:text-indigo-600 dark:hover:text-indigo-400">{guide.title}</a></h2>
            <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{guide.description}</p>
            <a href={`/guides/${guide.slug}`} class="mt-4 inline-flex font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Read the guide →</a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const faqs = [
  ['Which SQL dialects can I format?', 'Choose generic SQL, PostgreSQL, MySQL, SQLite, SQL Server, Oracle PL/SQL, DB2, BigQuery, Snowflake, or another supported dialect. The selected dialect controls syntax recognition.'],
  ['Does SQL formatting validate or execute a query?', 'No. Formatting never connects to a database or executes SQL. It makes a best-effort layout of the text you provide; use your database or test environment to validate semantics.'],
  ['Can I format a DDL file?', 'Yes. Format a CREATE TABLE or other DDL script for readability, then open the SQL Schema Explorer when you want an ER diagram and data dictionary.'],
  ['Can I share formatted SQL?', 'Yes, for a small scrubbed example. Anyone with the shared link can read the SQL it includes, so remove production identifiers, credentials, and proprietary queries first.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'SQL Formatter and Beautifier', url: 'https://bugdays.com/sql-formatter/', description: 'Format SQL queries and DDL for PostgreSQL, MySQL, SQLite, SQL Server, Oracle, DB2, BigQuery, Snowflake, and generic SQL locally in the browser.', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['Multi-dialect SQL formatting', 'Keyword case and indentation controls', 'Local SQL file input', 'Copy and download', 'Shareable scrubbed examples', 'Schema Explorer handoff for DDL'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---

<Layout title="SQL Formatter & Beautifier — PostgreSQL, MySQL, SQL Server" description="Format and beautify SQL queries or DDL for PostgreSQL, MySQL, SQLite, SQL Server, Oracle, DB2, BigQuery, Snowflake, and generic SQL. Runs locally; copy, download, or share a scrubbed example." keywords="SQL formatter, SQL beautifier, format SQL online, PostgreSQL formatter, MySQL formatter, SQL Server formatter, Oracle SQL formatter, SQL pretty print, format SQL query, SQL DDL formatter" breadcrumb={[{ name: 'Database Tools', href: '/database-tools/' }, { name: 'SQL Formatter' }]} toolId="sql-formatter" jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-1">SQL Formatter &amp; Beautifier</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Pretty-print a SQL query or DDL script for the dialect you use—then copy, download, share a scrubbed example, or turn supported DDL into an ER diagram.</p>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="sql-input" class="text-sm font-semibold text-slate-700 dark:text-slate-200">SQL input</label><label class="cursor-pointer text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Open local .sql<input id="sql-file" type="file" accept=".sql,text/plain,application/sql" class="hidden" /></label></div>
        <textarea id="sql-input" data-share-key="sql" class="h-80 w-full resize-none rounded-lg border border-slate-300 p-3 font-mono text-sm text-slate-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="select customer_id,count(*) from orders where status='paid' group by customer_id order by count(*) desc;" spellcheck="false"></textarea>
        <p id="file-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400">SQL stays in this browser.</p>
      </section>
      <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div class="mb-2 flex items-center justify-between gap-3"><label for="sql-output" class="text-sm font-semibold text-slate-700 dark:text-slate-200">Formatted SQL</label><button id="copy-btn" type="button" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Copy output</button></div>
        <textarea id="sql-output" readonly class="h-80 w-full resize-none rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Formatted SQL appears here…" spellcheck="false"></textarea>
        <p id="output-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p>
      </section>
    </div>

    <div class="mt-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="flex flex-wrap items-end gap-4">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Dialect<select id="dialect" data-share-key="dialect" class="mt-1 block rounded-lg border border-slate-300 bg-white p-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="sql">Generic SQL</option><option value="postgresql">PostgreSQL</option><option value="mysql">MySQL / MariaDB</option><option value="sqlite">SQLite</option><option value="transactsql">SQL Server (T-SQL)</option><option value="plsql">Oracle PL/SQL</option><option value="db2">IBM DB2</option><option value="bigquery">BigQuery</option><option value="snowflake">Snowflake</option><option value="trino">Trino / Presto</option></select></label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Keywords<select id="keyword-case" data-share-key="keywordCase" class="mt-1 block rounded-lg border border-slate-300 bg-white p-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="upper">UPPERCASE</option><option value="preserve">Preserve</option><option value="lower">lowercase</option></select></label>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Indent<select id="indent" data-share-key="indent" class="mt-1 block rounded-lg border border-slate-300 bg-white p-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="2">2 spaces</option><option value="4">4 spaces</option><option value="tab">Tab</option></select></label>
        <button id="format-btn" data-share-action="format" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Format SQL</button><button id="download-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Download .sql</button><button id="share-sql-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Share example ↗</button><button id="sample-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Load sample</button>
      </div>
    </div>
    <div id="error-box" role="alert" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>

    <div class="mt-7 grid gap-4 md:grid-cols-3 text-sm"><a href="/schema-explorer/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">DDL to ER diagram</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Explore formatted CREATE TABLE statements as relationships and a data dictionary.</span></a><a href="/json-to-code/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">JSON to typed code</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Generate API models after checking your data shape.</span></a><a href="/text-diff/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Compare query revisions</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Review a changed migration or query line by line.</span></a></div>

    <section class="mt-8 max-w-4xl space-y-5 text-sm leading-7 text-slate-600 dark:text-slate-300"><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Format SQL without connecting to a database</h2><p class="mt-2">This formatter only reorganizes the SQL text in your browser. It does not execute a query, inspect a schema, or connect to your database. Pick the closest dialect because quoting, functions, placeholders, and procedural syntax vary between PostgreSQL, MySQL, SQL Server, Oracle, and analytical databases.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Use formatting before a schema review</h2><p class="mt-2">A readable migration is easier to review. Format DDL, then paste supported <code>CREATE TABLE</code> statements into the <a href="/schema-explorer/" class="text-indigo-600 underline dark:text-indigo-400">SQL Schema Explorer</a> to map foreign keys and export a data dictionary. Read the <a href="/guides/format-sql-query-postgres-mysql-sql-server/" class="text-indigo-600 underline dark:text-indigo-400">SQL formatting guide</a> for dialect and review examples.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Share a scrubbed query, not production context</h2><p class="mt-2">Use the prominent Share example action for a small sanitized query in a ticket, answer, or code review. Anyone with the link can read the included SQL. Remove passwords, customer values, private table names, connection strings, and other production context before sharing.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">SQL formatter questions</h2><div class="mt-3 space-y-2">{faqs.map(([question, answer]) => <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-100">{question}</summary><p class="mt-2">{answer}</p></details>)}</div></div></section>
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import { ShareManager } from '../lib/share.ts';
  const input = document.getElementById('sql-input') as HTMLTextAreaElement;
  const output = document.getElementById('sql-output') as HTMLTextAreaElement;
  const dialect = document.getElementById('dialect') as HTMLSelectElement;
  const keywordCase = document.getElementById('keyword-case') as HTMLSelectElement;
  const indent = document.getElementById('indent') as HTMLSelectElement;
  const errorBox = document.getElementById('error-box')!;
  const outputStatus = document.getElementById('output-status')!;
  const fileStatus = document.getElementById('file-status')!;
  const fileInput = document.getElementById('sql-file') as HTMLInputElement;
  const sample = "select customer_id,count(*) as paid_orders from orders where status = 'paid' and created_at >= current_date - interval '30 days' group by customer_id order by paid_orders desc;";
  ShareManager.register({ tool: 'sql-formatter', actions: { format: () => document.getElementById('format-btn')?.click() } });
  document.getElementById('share-sql-btn')!.addEventListener('click', () => document.getElementById('share-btn')?.click());
  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function hideError() { errorBox.classList.add('hidden'); }
  async function formatSql() {
    if (!input.value.trim()) return showError('Paste SQL or open a local .sql file first.');
    try {
      const { format } = await import('sql-formatter');
      output.value = format(input.value, { language: dialect.value as any, keywordCase: keywordCase.value as any, tabWidth: indent.value === 'tab' ? 2 : Number(indent.value), useTabs: indent.value === 'tab', linesBetweenQueries: 1 });
      hideError(); outputStatus.textContent = `${output.value.split('\n').length} formatted lines. No database connection was made.`;
    } catch (error) { showError(error instanceof Error ? `Could not format this SQL: ${error.message}` : 'Could not format this SQL.'); }
  }
  document.getElementById('format-btn')!.addEventListener('click', formatSql);
  document.getElementById('sample-btn')!.addEventListener('click', () => { input.value = sample; fileStatus.textContent = 'Synthetic sample loaded. Nothing was uploaded.'; formatSql(); });
  document.getElementById('copy-btn')!.addEventListener('click', () => { if (output.value) navigator.clipboard.writeText(output.value); });
  document.getElementById('download-btn')!.addEventListener('click', () => { if (!output.value) return; track('export_used', { tool: 'sql-formatter', format: 'sql' }); const href = URL.createObjectURL(new Blob([output.value], { type: 'application/sql;charset=utf-8' })); const link = document.createElement('a'); link.href = href; link.download = 'formatted.sql'; link.click(); URL.revokeObjectURL(href); });
  fileInput.addEventListener('change', async () => { const file = fileInput.files?.[0]; fileInput.value = ''; if (!file) return; if (file.size > 5 * 1024 * 1024) return showError('Choose a SQL file smaller than 5 MB.'); try { input.value = await file.text(); fileStatus.textContent = `Loaded ${Math.max(1, Math.round(file.size / 1024))} KB locally. Nothing was uploaded.`; formatSql(); } catch { showError('The local SQL file could not be read.'); } });
  [dialect, keywordCase, indent].forEach(control => control.addEventListener('change', () => { if (input.value.trim()) formatSql(); }));
</script>

---
import Layout from '../layouts/Layout.astro';
import LocalBridgeAccessDialog from '../components/LocalBridgeAccessDialog.astro';
import { sampleCertificate } from '../lib/certificate-sample.ts';


const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TLS Certificate Chain Checker, Inspector & Converter',
    description: 'Check a live TLS certificate chain on any port, inspect expiry and SAN hostname coverage, and convert PEM, DER, CER, Base64, hex, and PKCS#7 formats.',
    url: 'https://bugdays.com/certificate-inspector/',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Live TLS certificate chain and expiry check on any port',
      'SAN hostname and IP address match analysis',
      'HTTPS, Kafka SSL, LDAPS, SMTPS, IMAPS, and raw TLS support',
      'X.509 certificate file inspection',
      'PEM, DER, CER, Base64, hex, and PKCS#7 input',
      'PEM, DER/CER, Base64, hex, JSON, and PKCS#7 export',
      'Certificate chain and bundle support',
      'SAN, usage, extension, fingerprint, and validity details',
      'Private client-side processing',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Can I check a TLS certificate on a non-HTTPS port?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. Enter a hostname or IP, any direct-TLS port, and an optional SNI server name. The local Holy CORS bridge can inspect certificate chains from HTTPS, Kafka SSL, LDAPS, SMTPS, IMAPS, and other services where TLS starts immediately.' },
      },
      {
        '@type': 'Question',
        name: 'Does the certificate match a hostname or IP address?',
        acceptedAnswer: { '@type': 'Answer', text: 'Both live and file inspection compare a hostname or IP with Subject Alternative Names. DNS wildcards cover one leftmost label; IPs require an IP SAN. Common Name is not used as a fallback. Live inspection additionally reports the local bridge’s device trust check.' },
      },
      {
        '@type': 'Question',
        name: 'How do I inspect a PEM or CER certificate?',
        acceptedAnswer: { '@type': 'Answer', text: 'Paste a PEM certificate or open a PEM, CRT, CER, DER, or P7B file. The inspector shows identity, validity, public key, fingerprints, SANs, usages, and extensions.' },
      },
      {
        '@type': 'Question',
        name: 'Can I convert PEM to DER or CER?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. Inspect the certificate and download its binary DER encoding with a CER extension, or export PEM, Base64 DER, hex DER, JSON, and PKCS#7 bundles.' },
      },
      {
        '@type': 'Question',
        name: 'How does live certificate inspection connect to the service?',
        acceptedAnswer: { '@type': 'Answer', text: 'Holy CORS runs on your computer and opens the TLS connection to the hostname, IP, and port you enter. The certificate analysis and format conversion then happen in your browser.' },
      },
      { '@type': 'Question', name: 'Does a verified signature mean the bundle is trusted?', acceptedAnswer: { '@type': 'Answer', text: 'No. A signature check verifies the certificate against a supplied issuer key, where the browser supports the algorithm. A file bundle is not a trust decision. This inspector does not perform full certificate-path validation, OCSP or CRL checks; live inspection separately reports the bridge’s device trust check at connection time.' } },
      { '@type': 'Question', name: 'Are files or share links sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'File decoding and conversion happen in your browser. Embedded share links keep the report in the URL fragment. An optional stored short link uploads the shared public certificate report after you choose it. Private-key PEM blocks and PKCS#12/PFX archives are not supported.' } },
    ],
  },
];
---

<Layout
  title="SSL Certificate Checker & Decoder — PEM, DER, P7B"
  description="Check SSL certificate expiry, SANs and chain signatures. Decode PEM, DER, CER or P7B, inspect live TLS on any port, convert formats and share a report."
  keywords="SSL certificate checker, TLS certificate checker, certificate chain checker, SSL expiry checker, SAN checker, hostname certificate match, check certificate on port, Kafka SSL certificate, X509 certificate inspector, PEM to DER, DER to PEM, P7B converter"
  breadcrumb={[{ name: 'Security Tools', href: '/security-tools/' }, { name: 'Certificate Inspector' }]}
  toolId="certificate-inspector"
  jsonLd={jsonLd}
  image="/og/certificate-checker-v2.png"
  imageAlt="TLS certificate chain checker showing hostname match, expiry, trust, SANs, and format exports"
  imageWidth={1280}
  imageHeight={720}
>
  <div id="certificate-workspace" class="max-w-[1450px] mx-auto min-w-0">
    <div class="mb-5">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-slate-100">SSL Certificate Checker, Decoder & Converter</h1>
        <span class="hidden sm:inline-flex px-2 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-xs font-semibold">Live TLS + X.509 files</span>
      </div>
      <p class="text-sm text-gray-600 dark:text-slate-300 max-w-5xl">
        Check expiry and hostname coverage, inspect a chain, convert its format, and share the findings. Open a local certificate file or connect to a TLS service through your local bridge.
      </p>
      <nav class="mt-3 flex flex-wrap gap-2 text-xs font-semibold" aria-label="Choose a certificate workflow"><a href="#live-certificate-inputs" class="certificate-export-button">Live service ↓</a><a href="#file-certificate-inputs" class="certificate-export-button">Paste / open a file ↓</a></nav>
    </div>

    <section id="live-certificate-inputs" class="mb-4 scroll-mt-20 bg-gradient-to-br from-indigo-50 to-white dark:from-indigo-950/30 dark:to-slate-800 rounded-xl shadow-sm border border-indigo-200 dark:border-indigo-800/70 overflow-hidden">
      <div class="px-4 py-3 border-b border-indigo-100 dark:border-indigo-900 flex flex-wrap items-center justify-between gap-3">
        <div><h2 class="font-semibold text-gray-800 dark:text-slate-100">Check a live TLS certificate chain</h2><p class="text-xs text-gray-500 dark:text-slate-400">Any hostname or IP · any port where TLS starts immediately</p></div>
        <div class="hidden sm:flex gap-2 text-[11px] text-indigo-700 dark:text-indigo-300"><span class="px-2 py-1 rounded bg-white/70 dark:bg-slate-900/50">Expiry</span><span class="px-2 py-1 rounded bg-white/70 dark:bg-slate-900/50">SAN / SNI</span><span class="px-2 py-1 rounded bg-white/70 dark:bg-slate-900/50">Full chain</span></div>
      </div>
      <div class="p-4 grid grid-cols-[minmax(0,1fr)_90px] lg:grid-cols-[minmax(0,1fr)_100px_minmax(0,1fr)_auto] gap-3 items-end">
        <label class="block"><span class="block text-xs font-semibold text-gray-600 dark:text-slate-300 mb-1.5">Hostname or IP</span><input id="tls-host" value="bugdays.com" autocomplete="off" spellcheck="false" class="w-full px-3 py-2.5 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 font-mono text-sm" placeholder="broker.internal or 10.0.0.8" /></label>
        <label class="block"><span class="block text-xs font-semibold text-gray-600 dark:text-slate-300 mb-1.5">Port</span><input id="tls-port" type="number" min="1" max="65535" value="443" class="w-full px-3 py-2.5 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 font-mono text-sm" /></label>
        <label class="block col-span-2 lg:col-span-1"><span class="block text-xs font-semibold text-gray-600 dark:text-slate-300 mb-1.5">SNI / name to verify <span class="font-normal text-gray-400">(optional)</span></span><input id="tls-server-name" autocomplete="off" spellcheck="false" class="w-full px-3 py-2.5 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 font-mono text-sm" placeholder="Defaults to hostname; useful when connecting by IP" /></label>
        <div class="flex gap-2 col-span-2 lg:col-span-1"><button id="tls-inspect-btn" type="button" class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-semibold whitespace-nowrap">Inspect service ↗</button><button id="tls-cancel" type="button" hidden class="certificate-export-button">Cancel</button></div>
      </div>
      <div class="px-4 pb-4 flex flex-wrap items-center gap-2">
        <span class="text-[11px] text-gray-500 dark:text-slate-400">Quick ports:</span>
        <button type="button" data-tls-port="443" class="tls-port-chip">HTTPS 443</button><button type="button" data-tls-port="9093" class="tls-port-chip">Kafka SSL 9093</button><button type="button" data-tls-port="636" class="tls-port-chip">LDAPS 636</button><button type="button" data-tls-port="465" class="tls-port-chip">SMTPS 465</button><button type="button" data-tls-port="993" class="tls-port-chip">IMAPS 993</button>
        <details class="ml-auto text-xs text-gray-500 dark:text-slate-400"><summary class="cursor-pointer text-indigo-600 dark:text-indigo-400 font-medium">Bridge setup</summary><div class="mt-2 max-w-xl space-y-2"><label class="block">Holy CORS URL <input id="tls-bridge-url" value="http://127.0.0.1:2345" class="ml-2 px-2 py-1 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-900 font-mono" /></label><p>Start with <code>brew tap bugdays-com/holy-cors &amp;&amp; brew install holy-cors &amp;&amp; holy-cors</code>, or <code>docker run --rm -p 127.0.0.1:2345:2345 ghcr.io/bugdays-com/holy-cors:latest</code>.</p></div></details>
      </div>
    </section>

    <div id="tls-error-box" class="hidden mb-4 p-4 rounded-lg border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300 text-sm" role="alert"></div>

    <section id="file-certificate-inputs" class="scroll-mt-20 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-semibold text-gray-800 dark:text-slate-100">Decode a certificate or bundle</h2>
          <p class="text-xs text-gray-500 dark:text-slate-400">PEM, CRT, CER, DER, Base64, hex, or PKCS#7/P7B · 5 MiB / 20 certificates</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <label id="file-drop" class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 cursor-pointer text-sm font-semibold">
            Open certificate file
            <input id="certificate-file" type="file" accept=".pem,.crt,.cer,.der,.p7b,.p7c,.txt,application/x-x509-ca-cert,application/pkcs7-mime,text/plain" class="hidden" />
          </label>
          <button id="paste-btn" type="button" class="px-3 py-1.5 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Paste</button>
          <button id="sample-btn" type="button" class="px-3 py-1.5 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Sample</button>
          <button id="clear-btn" type="button" class="px-3 py-1.5 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Clear</button>
        </div>
      </div>
      <textarea
        id="certificate-input"
        data-share-key="certificate"
        class="block w-full h-32 md:h-36 p-4 font-mono text-[12px] leading-5 resize-y bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500"
        spellcheck="false"
        wrap="soft"
        aria-label="Certificate input"
        placeholder="Paste a -----BEGIN CERTIFICATE----- block, Base64 DER, or hex DER…"
      ></textarea>
      <script id="certificate-sample" type="application/x-pem-file" set:html={sampleCertificate}></script>
      <div class="px-4 py-3 border-t border-gray-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex flex-wrap items-center gap-3">
        <button id="inspect-btn" data-share-action="inspect" type="button" class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-semibold">Inspect certificate</button>
        <span class="text-xs text-gray-500 dark:text-slate-400">Pasted text is inspected automatically. Files never leave this browser.</span>
      </div>
      <div class="px-4 pb-3 bg-slate-50 dark:bg-slate-900/50"><label for="certificate-identity" class="block text-xs font-semibold mb-1">Check hostname or IP <span class="font-normal text-slate-500 dark:text-slate-400">(optional · selected certificate)</span></label><input id="certificate-identity" data-share-key="identity" class="w-full sm:max-w-md px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-sm font-mono" placeholder="api.example.test or 127.0.0.1" autocomplete="off" spellcheck="false" maxlength="253" /></div>
    </section>

    <p id="certificate-progress" class="mt-2 text-xs text-slate-500 dark:text-slate-400" role="status" aria-live="polite">Local file processing · no upload needed</p>

    <div id="error-box" class="hidden mt-4 p-4 rounded-lg border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300 text-sm" role="alert"></div>

    <div id="results" class="hidden mt-4 space-y-4 scroll-mt-20">
      <section id="bundle-summary" class="rounded-xl border border-indigo-200 dark:border-indigo-800 bg-white dark:bg-slate-800 p-4">
        <div class="flex flex-wrap items-center gap-3"><h2 class="font-semibold mr-auto">Your certificate report</h2><button type="button" id="share-certificate-report" class="share-trigger px-4 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-semibold">Share certificate report ↗</button></div>
        <p id="bundle-summary-text" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></p>
        <div id="chain-overview" class="grid md:grid-cols-2 xl:grid-cols-3 gap-3 mt-3"></div>
        <div id="bundle-findings" class="grid md:grid-cols-2 gap-2 mt-3"></div>
        <div class="flex flex-wrap gap-2 mt-3"><button id="live-csv" class="certificate-export-button">CSV ↓</button><button id="live-xlsx" class="certificate-export-button">Excel ↓</button><button id="live-json" class="certificate-export-button">JSON report ↓</button><button id="live-copy" class="certificate-export-button">Copy chain table</button><button id="live-print" class="certificate-export-button">Print / PDF</button><a href="#bundle-exports" class="certificate-export-button">Convert certificate ↓</a></div>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Shares include public certificates and your report settings. Anyone with the link can read them. No live connection runs when a link is opened.</p>
      </section>
      <section id="live-tls-summary" class="hidden bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="px-4 py-4 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-start justify-between gap-4">
          <div><div class="text-[10px] tracking-widest font-bold text-indigo-600 dark:text-indigo-400">LIVE TLS REPORT</div><h2 id="live-endpoint" class="mt-1 text-xl font-bold text-gray-800 dark:text-slate-100 font-mono break-all"></h2><p id="live-connection-meta" class="mt-1 text-xs text-gray-500 dark:text-slate-400"></p></div>
        </div>
        <div id="live-status-grid" class="p-4 grid sm:grid-cols-2 xl:grid-cols-4 gap-3"></div>
        <div class="px-4 pb-4 grid lg:grid-cols-[1fr_auto] gap-4 items-start">
          <div><h3 class="text-sm font-semibold text-gray-800 dark:text-slate-100 mb-2">Checks and findings</h3><div id="live-issues" class="grid md:grid-cols-2 gap-2"></div></div>
        </div>
      </section>
      <section class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="font-semibold text-gray-800 dark:text-slate-100">Certificate chain</h2>
            <p id="source-summary" class="text-xs text-gray-500 dark:text-slate-400"></p>
          </div>
          <span id="chain-count" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold"></span>
        </div>
        <div id="certificate-list" class="p-3 flex flex-wrap gap-2" role="group" aria-label="Select a certificate"></div>
      </section>

      <section class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="px-4 py-4 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2 mb-2">
              <span id="status-pill" class="px-2.5 py-1 rounded-full text-xs font-bold"></span>
              <span id="kind-pill" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold"></span>
              <span id="self-pill" class="hidden px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 text-xs font-semibold">Self-signed</span>
            </div>
            <h2 id="certificate-heading" class="text-xl font-bold text-gray-800 dark:text-slate-100 break-words"></h2>
          </div>
          <div class="text-right">
            <div class="text-xs uppercase tracking-wide text-gray-400">Valid until</div>
            <div id="valid-until" class="font-semibold text-gray-800 dark:text-slate-100"></div>
          </div>
        </div>

        <div id="notice-box" class="hidden mx-4 mt-4 p-3 rounded-lg text-sm"></div>
        <div id="identity-result" class="hidden mx-4 mt-4 p-3 rounded-lg text-sm" role="status"></div>

        <div class="p-4 grid md:grid-cols-2 xl:grid-cols-4 gap-3">
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 min-w-0">
            <div class="text-xs uppercase tracking-wide text-gray-400 mb-1">Subject</div>
            <div id="subject" class="text-sm font-medium text-gray-800 dark:text-slate-100 break-words"></div>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 min-w-0">
            <div class="text-xs uppercase tracking-wide text-gray-400 mb-1">Issuer</div>
            <div id="issuer" class="text-sm font-medium text-gray-800 dark:text-slate-100 break-words"></div>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 min-w-0">
            <div class="text-xs uppercase tracking-wide text-gray-400 mb-1">Public key</div>
            <div id="public-key" class="text-sm font-medium text-gray-800 dark:text-slate-100"></div>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 min-w-0">
            <div class="text-xs uppercase tracking-wide text-gray-400 mb-1">Signature</div>
            <div id="signature" class="text-sm font-medium text-gray-800 dark:text-slate-100 break-words"></div>
          </div>
        </div>

        <div class="px-4 pb-4 grid lg:grid-cols-2 gap-4">
          <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
            <h3 class="px-4 py-3 font-semibold text-gray-800 dark:text-slate-100 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700">Validity and identity</h3>
            <dl class="divide-y divide-gray-100 dark:divide-slate-700 text-sm">
              <div class="p-3 grid sm:grid-cols-[130px_1fr] gap-1"><dt class="text-gray-500 dark:text-slate-400">Not before</dt><dd id="not-before" class="text-gray-800 dark:text-slate-100"></dd></div>
              <div class="p-3 grid sm:grid-cols-[130px_1fr] gap-1"><dt class="text-gray-500 dark:text-slate-400">Not after</dt><dd id="not-after" class="text-gray-800 dark:text-slate-100"></dd></div>
              <div class="p-3 grid sm:grid-cols-[130px_1fr] gap-1"><dt class="text-gray-500 dark:text-slate-400">Serial number</dt><dd id="serial" class="font-mono text-xs text-gray-800 dark:text-slate-100 break-all"></dd></div>
            </dl>
          </div>
          <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold text-gray-800 dark:text-slate-100">Subject alternative names</h3><button id="copy-sans" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">Copy names</button></div>
            <div id="san-list" class="p-4 flex flex-wrap gap-2"></div>
          </div>
          <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
            <h3 class="px-4 py-3 font-semibold text-gray-800 dark:text-slate-100 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700">Allowed uses</h3>
            <div class="p-4 space-y-3">
              <div>
                <div class="text-xs uppercase tracking-wide text-gray-400 mb-2">Key usage</div>
                <div id="key-usage" class="flex flex-wrap gap-2"></div>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wide text-gray-400 mb-2">Extended key usage</div>
                <div id="extended-usage" class="flex flex-wrap gap-2"></div>
              </div>
            </div>
          </div>
          <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
            <h3 class="px-4 py-3 font-semibold text-gray-800 dark:text-slate-100 bg-slate-50 dark:bg-slate-900/50 border-b border-gray-200 dark:border-slate-700">Fingerprints</h3>
            <div class="p-4 space-y-3 text-sm">
              <div>
                <div class="flex justify-between gap-2 mb-1"><span class="text-xs uppercase tracking-wide text-gray-400">SHA-256</span><button data-copy-target="sha256" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline">Copy</button></div>
                <code id="sha256" class="block text-xs text-gray-800 dark:text-slate-100 break-all"></code>
              </div>
              <div>
                <div class="flex justify-between gap-2 mb-1"><span class="text-xs uppercase tracking-wide text-gray-400">SHA-1</span><button data-copy-target="sha1" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline">Copy</button></div>
                <code id="sha1" class="block text-xs text-gray-800 dark:text-slate-100 break-all"></code>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="grid xl:grid-cols-[1.25fr_0.75fr] gap-4 items-start">
        <section class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden min-w-0">
          <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-semibold text-gray-800 dark:text-slate-100">Extensions</h2>
            <span id="extension-count" class="text-xs text-gray-500 dark:text-slate-400"></span>
          </div>
          <div>
            <table class="w-full table-fixed text-xs break-all">
              <thead class="bg-slate-50 dark:bg-slate-900/50 text-left text-xs uppercase tracking-wide text-gray-500 dark:text-slate-400">
                <tr><th class="px-4 py-3">Extension</th><th class="px-4 py-3">OID</th><th class="px-4 py-3">Critical</th><th class="px-4 py-3">Value</th></tr>
              </thead>
              <tbody id="extensions-body" class="divide-y divide-gray-100 dark:divide-slate-700"></tbody>
            </table>
          </div>
          <details class="border-t border-gray-200 dark:border-slate-700">
            <summary class="px-4 py-3 cursor-pointer font-medium text-sm text-gray-700 dark:text-slate-200">Full decoded certificate</summary>
            <pre id="text-dump" class="max-h-[520px] overflow-auto p-4 bg-slate-950 text-slate-100 text-xs leading-5 whitespace-pre"></pre>
          </details>
        </section>

        <section class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700">
            <h2 class="font-semibold text-gray-800 dark:text-slate-100">Convert and export</h2>
            <p class="text-xs text-gray-500 dark:text-slate-400">Selected certificate · public certificate only.</p>
          </div>
          <div class="p-4 space-y-3">
            <div class="grid sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2 gap-2">
              <button id="copy-pem" type="button" class="px-3 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-semibold">Copy PEM</button>
              <button id="download-pem" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Download .pem</button>
              <button id="download-der" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Download DER / .cer</button>
              <button id="copy-base64" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Copy Base64 DER</button>
              <button id="copy-hex" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Copy hex DER</button>
              <button id="download-json" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Download JSON report</button>
            </div>
            <div id="bundle-exports" class="pt-3 border-t border-gray-200 dark:border-slate-700">
              <div class="text-xs uppercase tracking-wide text-gray-400 mb-2">Whole bundle</div>
              <div class="grid gap-2">
                <button id="download-chain" type="button" class="px-3 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 text-sm font-semibold">Download PEM chain</button>
                <button id="download-p7b" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Download PKCS#7 / .p7b</button>
                <button id="download-p7b-pem" type="button" class="px-3 py-2 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-200 dark:hover:bg-slate-600 text-sm font-medium">Download PKCS#7 PEM</button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 hidden px-4 py-2.5 rounded-lg bg-slate-900 text-white shadow-xl text-sm" role="status" aria-live="polite"></div>

    <section class="mt-8 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-6">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-3">Check the certificate a service actually presents</h2>
      <div class="grid md:grid-cols-3 gap-6 text-sm text-gray-600 dark:text-slate-300">
        <div>
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Hostname, IP, SAN, and SNI checks</h3>
          <p>Verify that the leaf certificate covers the name used by a client. When connecting to an IP, provide the expected DNS name as SNI or check whether the certificate contains that IP as a SAN.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Any direct-TLS service and port</h3>
          <p>Inspect HTTPS on 443, Kafka SSL on 9093, LDAPS on 636, SMTPS on 465, IMAPS on 993, or a custom service where TLS begins as soon as the TCP connection opens.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-1">Export and share the whole finding</h3>
          <p>Share a restorable snapshot, copy a chain table, print or save as PDF, and export CSV, Excel, JSON, PEM, DER/CER, Base64, hex, or PKCS#7.</p>
        </div>
      </div>
      <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700 grid md:grid-cols-2 gap-6 text-sm text-gray-600 dark:text-slate-300">
        <div>
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">PEM, DER, CER, and P7B without guesswork</h3>
          <p>PEM is Base64-wrapped DER with readable boundary lines; DER is the binary X.509 encoding. A <code class="text-xs">.cer</code> or <code class="text-xs">.crt</code> filename may contain either one, while PKCS#7 files commonly carry a certificate chain without a private key. Open the file and let the decoder identify the actual encoding before converting it.</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 dark:text-slate-100 mb-2">Trust and chain diagnostics</h3>
          <p>Every supplied certificate gets a validity check. Signatures are verified against supplied issuer candidates where the browser supports the algorithm. A file bundle is not automatically trusted: this does not build a complete trust path, fetch missing issuers, or check revocation. Live inspection separately reports the bridge’s device trust check at the time of connection.</p>
        </div>
      </div>
      <p class="mt-5 text-sm text-gray-600 dark:text-slate-300">Follow the <a href="/guides/check-tls-certificate-chain-any-port/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">TLS certificate chain, expiry, SAN, and SNI checklist</a>, or learn the difference between <a href="/guides/pem-vs-der-vs-cer-vs-p7b-certificate-formats/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">PEM, DER, CER, and P7B certificate formats</a>. Also try the <a href="/dns-lookup/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">DNS and reverse DNS checker</a> or <a href="/grpc-client/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">gRPC client</a>.</p>
    </section>
    <section class="mt-5 text-sm text-slate-600 dark:text-slate-300" aria-label="Certificate questions"><h2 class="text-lg font-semibold text-slate-900 dark:text-white">Certificate decoder questions</h2>{jsonLd[1].mainEntity?.map(question => <details class="py-3 border-b border-slate-200 dark:border-slate-700"><summary class="font-semibold cursor-pointer">{question.name}</summary><p class="mt-2">{question.acceptedAnswer.text}</p></details>)}</section>
    <LocalBridgeAccessDialog directOption="Cancel to inspect a certificate file without the bridge." />
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import type { CertificateInput, CertificateReport } from '../lib/certificate-inspector.ts';
  import { analyzeCertificateChain, certificateReportRows, certificateRole, type CertificateChainAnalysis } from '../lib/certificate-chain.ts';
  import { ShareManager } from '../lib/share.ts';
  import { parseIp } from '../lib/ip-address.ts';
  import { createLocalBridgeAccessGuard } from '../lib/local-bridge-access.ts';
  import { createXlsxBlob, tableToDelimited } from '../lib/spreadsheet-export.ts';
  import {
    analyzeTlsConnection,
    inspectTlsService,
    tlsInspectionErrorMessage,
    certificateMatchesIdentity,
    normalizeCertificateIdentity,
    tlsShareSnapshot,
    validateTlsInspectResult,
    type TlsAnalysis,
    type TlsInspectResult,
  } from '../lib/tls-certificate-check.ts';

  function initCertificateInspector() {
  const root = document.getElementById('certificate-workspace');
  if (!root || root.dataset.init) return;
  root.dataset.init = 'true';
  let codec: typeof import('../lib/certificate-inspector.ts') | null = null;
  const loadCodec = async () => codec ||= await import('../lib/certificate-inspector.ts');

  const input = document.getElementById('certificate-input') as HTMLTextAreaElement;
  const sample = document.getElementById('certificate-sample')?.textContent?.trim() || '';
  const fileInput = document.getElementById('certificate-file') as HTMLInputElement;
  const dropZone = document.getElementById('file-drop') as HTMLLabelElement;
  const results = document.getElementById('results') as HTMLElement;
  const errorBox = document.getElementById('error-box') as HTMLElement;
  const toast = document.getElementById('toast') as HTMLElement;
  let parsedInput: CertificateInput | null = null;
  let reports: CertificateReport[] = [];
  let selectedIndex = 0;
  let liveTlsResult: TlsInspectResult | null = null;
  let liveTlsAnalysis: TlsAnalysis | null = null;
  let inspectTimer = 0;
  let toastTimer = 0;
  let revision = 0;
  let liveController: AbortController | null = null;
  let chainAnalysis: CertificateChainAnalysis | null = null;
  let inspectedAt = '';
  let sharedSnapshot = false;
  const identityInput = document.getElementById('certificate-identity') as HTMLInputElement;
  const confirmLocalBridgeAccess = createLocalBridgeAccessGuard();

  const element = (id: string): HTMLElement => document.getElementById(id) as HTMLElement;

  function invalidate(): number {
    revision++;
    liveController?.abort();
    liveController = null;
    window.clearTimeout(inspectTimer);
    parsedInput = null; reports = []; chainAnalysis = null; liveTlsResult = null; liveTlsAnalysis = null;
    results.classList.add('hidden');
    element('live-tls-summary').classList.add('hidden');
    element('tls-error-box').classList.add('hidden');
    (element('tls-inspect-btn') as HTMLButtonElement).disabled = false;
    element('tls-inspect-btn').textContent = 'Inspect service ↗';
    element('tls-cancel').hidden = true;
    return revision;
  }

  function showToast(message: string, isError = false): void {
    window.clearTimeout(toastTimer);
    toast.textContent = message;
    toast.classList.toggle('bg-red-700', isError);
    toast.classList.toggle('bg-slate-900', !isError);
    toast.classList.remove('hidden');
    toastTimer = window.setTimeout(() => toast.classList.add('hidden'), 2600);
  }

  function showError(message: string): void {
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function clearError(): void {
    errorBox.textContent = '';
    errorBox.classList.add('hidden');
  }

  function commonName(subject: string): string {
    const match = /(?:^|,\s*)CN=([^,]+)/i.exec(subject);
    return match?.[1] || subject || 'Certificate';
  }

  function filename(report: CertificateReport): string {
    const dns = report.subjectAlternativeNames.find(name => name.type === 'dns')?.value;
    return (dns || commonName(report.subject) || 'certificate').replace(/^\*\./, 'wildcard-').replace(/[^a-z0-9._-]+/gi, '-').replace(/^-+|-+$/g, '') || 'certificate';
  }

  function chip(value: string): HTMLSpanElement {
    const item = document.createElement('span');
    item.className = 'px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs break-all';
    item.textContent = value;
    return item;
  }

  function fillChips(id: string, values: string[], emptyMessage: string): void {
    const container = element(id);
    container.replaceChildren();
    if (!values.length) {
      const empty = document.createElement('span');
      empty.className = 'text-sm text-gray-500 dark:text-slate-400';
      empty.textContent = emptyMessage;
      container.append(empty);
      return;
    }
    values.forEach(value => container.append(chip(value)));
  }

  function renderSelected(): void {
    const report = reports[selectedIndex];
    if (!report) return;
    document.querySelectorAll<HTMLButtonElement>('[data-certificate-index]').forEach((button, index) => {
      const active = index === selectedIndex;
      button.classList.toggle('bg-indigo-600', active);
      button.classList.toggle('text-white', active);
      button.classList.toggle('bg-slate-100', !active);
      button.classList.toggle('dark:bg-slate-700', !active);
      button.classList.toggle('text-slate-700', !active);
      button.classList.toggle('dark:text-slate-200', !active);
      button.setAttribute('aria-pressed', String(active));
    });

    const statusPill = element('status-pill');
    statusPill.textContent = report.statusLabel;
    statusPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold ' + (report.status === 'valid'
      ? report.daysRemaining <= 30
        ? 'bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300'
        : 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300'
      : 'bg-red-100 dark:bg-red-900/40 text-red-800 dark:text-red-300');
    element('kind-pill').textContent = report.isCertificateAuthority ? 'Certificate authority' : 'End-entity certificate';
    element('self-pill').classList.toggle('hidden', !report.selfSigned);
    element('certificate-heading').textContent = commonName(report.subject);
    element('valid-until').textContent = report.notAfter.toLocaleDateString(undefined, { dateStyle: 'medium' });
    element('subject').textContent = report.subject;
    element('issuer').textContent = report.issuer;
    element('public-key').textContent = report.publicKey;
    element('signature').textContent = report.signatureAlgorithm;
    element('not-before').textContent = report.notBefore.toLocaleString();
    element('not-after').textContent = report.notAfter.toLocaleString();
    element('serial').textContent = report.serialNumber;
    element('sha256').textContent = report.sha256Fingerprint;
    element('sha1').textContent = report.sha1Fingerprint;
    element('text-dump').textContent = report.textDump;

    const notice = element('notice-box');
    if (report.status === 'expired') {
      notice.textContent = `This certificate expired on ${report.notAfter.toLocaleString()}. Replace or renew it before relying on it.`;
      notice.className = 'mx-4 mt-4 p-3 rounded-lg text-sm border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300';
    } else if (report.status === 'not-yet-valid') {
      notice.textContent = `This certificate is not valid until ${report.notBefore.toLocaleString()}. Check the certificate and system clock.`;
      notice.className = 'mx-4 mt-4 p-3 rounded-lg text-sm border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300';
    } else if (report.daysRemaining <= 30) {
      notice.textContent = `This certificate expires soon: ${report.statusLabel.toLowerCase()}.`;
      notice.className = 'mx-4 mt-4 p-3 rounded-lg text-sm border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300';
    } else if (report.selfSigned) {
      notice.textContent = 'This certificate is self-signed. It can be appropriate for local or private systems when clients are configured to trust it.';
      notice.className = 'mx-4 mt-4 p-3 rounded-lg text-sm border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300';
    } else {
      notice.className = 'hidden mx-4 mt-4 p-3 rounded-lg text-sm';
      notice.textContent = '';
    }

    fillChips('san-list', report.subjectAlternativeNames.map(name => `${name.type.toUpperCase()} · ${name.value}`), 'No Subject Alternative Name extension.');
    fillChips('key-usage', report.keyUsages, 'No Key Usage extension.');
    fillChips('extended-usage', report.extendedKeyUsages, 'No Extended Key Usage extension.');

    const extensionsBody = element('extensions-body');
    extensionsBody.replaceChildren();
    report.extensions.forEach(extension => {
      const row = document.createElement('tr');
      row.className = 'align-top text-gray-700 dark:text-slate-200';
      const values = [extension.name, extension.oid, extension.critical ? 'Yes' : 'No', extension.summary || '—'];
      values.forEach((value, index) => {
        const cell = document.createElement('td');
        cell.className = `px-3 py-3 break-all ${index === 1 ? 'font-mono text-xs' : ''}`;
        cell.textContent = value;
        row.append(cell);
      });
      extensionsBody.append(row);
    });
    element('extension-count').textContent = `${report.extensions.length} extension${report.extensions.length === 1 ? '' : 's'}`;
    renderIdentity();
  }

  function renderIdentity(): void {
    const box = element('identity-result');
    const report = reports[selectedIndex];
    box.classList.toggle('hidden', !identityInput.value.trim() || !report);
    if (!report || !identityInput.value.trim()) return;
    let matches = false;
    try {
      const identity = normalizeCertificateIdentity(identityInput.value);
      const check = certificateMatchesIdentity(report, identity);
      matches = check.matches;
      box.textContent = check.matches ? `✓ ${identity} matches SAN ${check.matched}.` : `Name mismatch: ${identity} is not covered by this certificate’s DNS or IP SANs. Common Name is not used as a fallback.`;
    } catch (error) { box.textContent = error instanceof Error ? error.message : 'Enter a valid hostname or IP.'; }
    box.className = `mx-4 mt-4 p-3 rounded-lg text-sm border ${matches ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-200' : 'border-red-200 bg-red-50 text-red-800 dark:border-red-800 dark:bg-red-950/20 dark:text-red-200'}`;
  }

  function safeIdentity(): string {
    try { return normalizeCertificateIdentity(identityInput.value); } catch { return ''; }
  }

  function renderBundle(): void {
    element('bundle-summary-text').textContent = `${reports.length} certificate${reports.length === 1 ? '' : 's'} · dates checked ${new Date(inspectedAt).toLocaleString()} · supplied issuer signatures checked, not a trust-path validation`;
    const overview = element('chain-overview'); overview.replaceChildren();
    reports.forEach((report, index) => {
      const card = document.createElement('button'); card.type = 'button';
      card.className = 'text-left min-w-0 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-3 hover:border-indigo-400';
      const title = document.createElement('div'); title.className = 'text-sm font-semibold break-all'; title.textContent = `${index + 1}. ${commonName(report.subject)}`;
      const status = document.createElement('p'); status.className = `mt-1 text-xs ${report.status === 'valid' ? 'text-slate-600 dark:text-slate-300' : 'text-red-700 dark:text-red-300'}`; status.textContent = `${certificateRole(report)} · ${report.statusLabel}`;
      const signature = document.createElement('p'); signature.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
      const link = chainAnalysis?.links[index];
      signature.textContent = link?.status === 'verified' ? `Signature verified with certificate ${(link.issuerIndex ?? 0) + 1}` : link?.status === 'self-signed' ? 'Self-signature verified · not a trust decision' : link?.status === 'issuer-not-supplied' ? 'Issuer not supplied · signature unchecked' : link?.status === 'invalid' ? 'Signature did not verify' : 'Signature algorithm could not be checked';
      card.append(title, status, signature); card.addEventListener('click', () => { selectedIndex = index; renderSelected(); element('certificate-heading').scrollIntoView({ block: 'center', behavior: 'smooth' }); });
      overview.append(card);
    });
    const findings = element('bundle-findings'); findings.replaceChildren();
    chainAnalysis?.issues.forEach(issue => {
      const item = document.createElement('p');
      item.className = `text-xs rounded-lg border p-3 ${issue.severity === 'error' ? 'border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : issue.severity === 'warning' ? 'border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-200' : 'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300'}`;
      const title = document.createElement('strong'); title.textContent = issue.title;
      item.append(title, document.createElement('br'), document.createTextNode(issue.detail)); findings.append(item);
    });
  }

  function renderCertificateList(): void {
    const list = element('certificate-list');
    list.replaceChildren();
    reports.forEach((report, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.certificateIndex = String(index);
      button.className = 'min-w-0 max-w-full px-3 py-2 rounded-lg text-left text-sm transition-colors';
      const title = document.createElement('span');
      title.className = 'block font-semibold truncate';
      title.textContent = commonName(report.subject);
      const detail = document.createElement('span');
      detail.className = 'block text-[11px] opacity-75 truncate';
      detail.textContent = `Certificate ${index + 1} · ${certificateRole(report)}`;
      button.append(title, detail);
      button.addEventListener('click', () => {
        selectedIndex = index;
        renderSelected();
      });
      list.append(button);
    });
  }

  async function inspect(value: string | ArrayBuffer | Uint8Array = input.value, keepLive = false, token = keepLive ? revision : invalidate()): Promise<boolean> {
    window.clearTimeout(inspectTimer);
    clearError();
    if (!keepLive) {
      liveTlsResult = null;
      liveTlsAnalysis = null;
      element('live-tls-summary').classList.add('hidden');
    }
    if (typeof value === 'string' && !value.trim()) {
      parsedInput = null;
      reports = [];
      results.classList.add('hidden');
      element('certificate-progress').textContent = 'Local file processing · no upload needed';
      return false;
    }
    try {
      element('certificate-progress').textContent = 'Decoding and checking locally…';
      const tools = await loadCodec();
      if (token !== revision || !root?.isConnected) return false;
      const parsed = tools.parseCertificateInput(value);
      const inspected = await tools.inspectCertificates(parsed.certificates);
      const analysis = await analyzeCertificateChain(inspected);
      if (token !== revision || !root?.isConnected) return false;
      parsedInput = parsed; reports = inspected; chainAnalysis = analysis; inspectedAt = new Date().toISOString();
      selectedIndex = Math.max(0, reports.findIndex(report => !report.isCertificateAuthority));
      element('source-summary').textContent = `${parsedInput.sourceLabel} · parsed and fingerprinted locally`;
      element('chain-count').textContent = `${reports.length} certificate${reports.length === 1 ? '' : 's'}`;
      element('bundle-exports').classList.remove('hidden');
      renderBundle();
      renderCertificateList();
      renderSelected();
      results.classList.remove('hidden');
      element('certificate-progress').textContent = 'Report ready · public certificates only · share or export above';
      return true;
    } catch (error) {
      if (token !== revision || !root?.isConnected) return false;
      parsedInput = null;
      reports = [];
      results.classList.add('hidden');
      showError(error instanceof Error ? error.message : 'Could not inspect that certificate.');
      element('certificate-progress').textContent = 'Could not decode this input. Nothing from it will be shared.';
      return false;
    }
  }

  function download(data: BlobPart, name: string, type: string): void {
    track('export_used', { tool: 'certificate-inspector', format: name.split('.').pop() || 'file' });
    const url = URL.createObjectURL(new Blob([data], { type }));
    const link = document.createElement('a');
    link.href = url;
    link.download = name;
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  async function copy(value: string, message: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(value);
      track('export_used', { tool: 'certificate-inspector', format: 'clipboard' });
      showToast(message);
    } catch {
      showToast('Clipboard access was blocked by the browser.', true);
    }
  }

  async function openFile(file: File): Promise<void> {
    const token = invalidate(); clearError();
    if (file.size > 5 * 1024 * 1024) {
      showError('That file is larger than 5 MB.');
      return;
    }
    const bytes = new Uint8Array(await file.arrayBuffer());
    if (token !== revision || !root?.isConnected) return;
    const inspectedBytes = bytes.subarray(0, Math.min(bytes.length, 4096));
    const printableBytes = inspectedBytes.filter(byte => byte === 9 || byte === 10 || byte === 13 || (byte >= 32 && byte <= 126)).length;
    const isText = inspectedBytes.length > 0 && printableBytes / inspectedBytes.length > 0.95;
    if (isText) {
      input.value = new TextDecoder().decode(bytes);
      await inspect(input.value, false, token);
    } else {
      input.value = '';
      await inspect(bytes, false, token);
    }
    if (reports.length) { track('tool_used', { tool: 'certificate-inspector', action: 'open-file' }); results.scrollIntoView({ block: 'start', behavior: 'smooth' }); }
  }

  function normalizeLiveTarget(): { host: string; port: number; serverName: string } {
    const hostInput = document.getElementById('tls-host') as HTMLInputElement;
    const portInput = document.getElementById('tls-port') as HTMLInputElement;
    const serverNameInput = document.getElementById('tls-server-name') as HTMLInputElement;
    let host = hostInput.value.trim();
    let port = Number(portInput.value);
    if (/^[a-z][a-z0-9+.-]*:\/\//i.test(host)) {
      const url = new URL(host);
      host = url.hostname;
      if (url.port) port = Number(url.port);
      else if (url.protocol === 'https:') port = 443;
    }
    host = normalizeCertificateIdentity(host);
    if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Port must be between 1 and 65535.');
    const serverName = normalizeCertificateIdentity(serverNameInput.value.trim() || host);
    hostInput.value = host;
    portInput.value = String(port);
    return { host, port, serverName };
  }

  function certificatesToPem(result: TlsInspectResult): string {
    return result.certificates.map(item => {
      const lines = item.derBase64.match(/.{1,64}/g)?.join('\n') || item.derBase64;
      return `-----BEGIN CERTIFICATE-----\n${lines}\n-----END CERTIFICATE-----`;
    }).join('\n');
  }

  function liveReportObject() {
    if (!liveTlsResult || !liveTlsAnalysis) return null;
    return {
      endpoint: { host: liveTlsResult.host, port: liveTlsResult.port, serverName: liveTlsResult.serverName, peerAddress: liveTlsResult.peerAddress },
      connection: { tlsVersion: liveTlsResult.tlsVersion, cipherSuite: liveTlsResult.cipherSuite, alpn: liveTlsResult.alpn, connectedAt: new Date(liveTlsResult.connectedAt).toISOString(), elapsedMs: liveTlsResult.elapsedMs },
      validation: liveTlsResult.validation,
      checks: liveTlsAnalysis,
      inspectedAt, suppliedSignatures: chainAnalysis,
      certificates: reports.map(report => JSON.parse(codec!.reportToJson(report))),
    };
  }

  function renderLiveSummary(result: TlsInspectResult): void {
    liveTlsAnalysis = analyzeTlsConnection(result, reports);
    element('live-tls-summary').classList.remove('hidden');
    element('live-endpoint').textContent = `${result.host}:${result.port}`;
    const separateServerName = result.host.toLowerCase() !== result.serverName.toLowerCase();
    element('live-connection-meta').textContent = separateServerName
      ? `${sharedSnapshot ? 'Shared snapshot' : 'Connected'} · ${result.peerAddress} · SNI / checked name: ${result.serverName} · ${new Date(result.connectedAt).toLocaleString()}`
      : `${sharedSnapshot ? 'Shared snapshot · ' : ''}Checked name: ${result.serverName} · Connected to ${result.peerAddress} · ${new Date(result.connectedAt).toLocaleString()}`;
    const statusGrid = element('live-status-grid');
    statusGrid.replaceChildren();
    const leaf = reports[0];
    const statuses: Array<readonly [string, string, string, boolean]> = [
      [separateServerName ? 'SNI name match' : 'Name match', liveTlsAnalysis.identityMatches ? 'Pass' : 'Mismatch', liveTlsAnalysis.matchedIdentity || result.serverName, liveTlsAnalysis.identityMatches],
      ...(liveTlsAnalysis.connectionTargetMatches === undefined ? [] : [[
        parseIp(result.host) ? 'IP SAN match' : 'Target name match',
        liveTlsAnalysis.connectionTargetMatches ? 'Pass' : 'Mismatch',
        liveTlsAnalysis.matchedConnectionTarget || result.host,
        liveTlsAnalysis.connectionTargetMatches,
      ] as const]),
      ['Device trust at capture', result.validation.trusted ? 'Trusted' : 'Not trusted', result.validation.trusted ? 'Bridge result at connection time' : 'See finding below', result.validation.trusted],
      ['Leaf expiry', leaf?.statusLabel || 'Unknown', leaf ? leaf.notAfter.toLocaleDateString() : 'No leaf certificate', leaf?.status === 'valid' && leaf.daysRemaining > 30],
      ['Connection', result.tlsVersion || 'TLS', `${result.cipherSuite || 'Cipher unavailable'}${result.alpn ? ` · ${result.alpn}` : ''}`, true],
    ];
    statuses.forEach(([label, value, detail, pass]) => {
      const card = document.createElement('div');
      card.className = `p-3 rounded-lg border ${pass ? 'border-emerald-200 dark:border-emerald-800 bg-emerald-50/60 dark:bg-emerald-950/20' : 'border-red-200 dark:border-red-800 bg-red-50/60 dark:bg-red-950/20'}`;
      const labelNode = document.createElement('div'); labelNode.className = 'text-[10px] uppercase tracking-wide text-gray-500 dark:text-slate-400'; labelNode.textContent = label;
      const valueNode = document.createElement('div'); valueNode.className = 'mt-1 font-bold text-gray-800 dark:text-slate-100'; valueNode.textContent = value;
      const detailNode = document.createElement('div'); detailNode.className = 'mt-1 text-[11px] text-gray-500 dark:text-slate-400 break-words'; detailNode.textContent = detail;
      card.append(labelNode, valueNode, detailNode); statusGrid.append(card);
    });
    const issues = element('live-issues'); issues.replaceChildren();
    liveTlsAnalysis.issues.forEach(issue => {
      const item = document.createElement('article');
      const colors = issue.severity === 'pass' ? 'border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/20' : issue.severity === 'error' ? 'border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/20' : 'border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/20';
      item.className = `p-3 rounded-lg border ${colors}`;
      const title = document.createElement('h4'); title.className = 'text-xs font-bold text-gray-800 dark:text-slate-100'; title.textContent = `${issue.severity === 'pass' ? '✓' : issue.severity === 'error' ? '!' : '•'} ${issue.title}`;
      const detail = document.createElement('p'); detail.className = 'mt-1 text-[11px] leading-5 text-gray-600 dark:text-slate-300 break-words'; detail.textContent = issue.detail;
      item.append(title, detail); issues.append(item);
    });
  }

  async function restoreLiveResult(value: unknown): Promise<void> {
    try {
      const restored = validateTlsInspectResult(value);
      const pem = certificatesToPem(restored);
      input.value = pem;
      const token = invalidate();
      if (!await inspect(pem, true, token)) return;
      liveTlsResult = restored; sharedSnapshot = true;
      element('source-summary').textContent = `Shared snapshot from ${restored.host}:${restored.port} · ${reports.length} certificate${reports.length === 1 ? '' : 's'}`;
      renderLiveSummary(restored);
      results.scrollIntoView({ block: 'start' });
      showToast('Shared TLS certificate report restored.');
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Could not restore the shared TLS report.');
    }
  }

  async function inspectLiveService(): Promise<void> {
    const token = invalidate();
    const button = document.getElementById('tls-inspect-btn') as HTMLButtonElement;
    const liveError = element('tls-error-box');
    liveError.classList.add('hidden'); liveError.textContent = '';
    clearError();
    button.disabled = true; button.textContent = 'Connecting…';
    let request: ReturnType<typeof normalizeLiveTarget> | null = null;
    try {
      request = normalizeLiveTarget();
      const bridge = (document.getElementById('tls-bridge-url') as HTMLInputElement).value;
      if (!await confirmLocalBridgeAccess(bridge)) return;
      if (token !== revision || !root?.isConnected) return;
      liveController = new AbortController();
      element('tls-cancel').hidden = false;
      const response = await inspectTlsService(request.host, request.port, request.serverName, bridge, liveController.signal);
      if (token !== revision || !root?.isConnected) return;
      const pem = certificatesToPem(response);
      input.value = pem;
      if (!await inspect(pem, true, token)) return;
      liveTlsResult = response; sharedSnapshot = false;
      element('source-summary').textContent = `${response.host}:${response.port} · server-presented chain · inspected locally`;
      element('chain-count').textContent = `${reports.length} certificate${reports.length === 1 ? '' : 's'} in chain`;
      renderLiveSummary(response);
      track('tool_used', { tool: 'certificate-inspector', action: 'inspect-service' });
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      if (token !== revision || !root?.isConnected) return;
      liveTlsResult = null; liveTlsAnalysis = null;
      liveError.textContent = request
        ? tlsInspectionErrorMessage(error, request.host, request.serverName)
        : error instanceof Error ? error.message : 'Could not inspect that TLS service.';
      liveError.classList.remove('hidden');
    } finally {
      if (token === revision && root?.isConnected) { button.disabled = false; button.textContent = 'Inspect service ↗'; element('tls-cancel').hidden = true; }
    }
  }

  document.getElementById('tls-inspect-btn')?.addEventListener('click', inspectLiveService);
  element('tls-cancel').addEventListener('click', () => { invalidate(); element('certificate-progress').textContent = 'Inspection cancelled.'; });
  identityInput.addEventListener('input', renderIdentity);
  document.getElementById('tls-host')?.addEventListener('keydown', event => { if ((event as KeyboardEvent).key === 'Enter') inspectLiveService(); });
  document.getElementById('tls-server-name')?.addEventListener('keydown', event => { if ((event as KeyboardEvent).key === 'Enter') inspectLiveService(); });
  document.querySelectorAll<HTMLButtonElement>('[data-tls-port]').forEach(button => button.addEventListener('click', () => {
    (document.getElementById('tls-port') as HTMLInputElement).value = button.dataset.tlsPort || '443';
  }));
  document.getElementById('inspect-btn')?.addEventListener('click', async () => { if (await inspect()) results.scrollIntoView({ block: 'start', behavior: 'smooth' }); });
  input.addEventListener('input', () => {
    invalidate();
    if (!input.value.trim()) {
      results.classList.add('hidden');
      clearError();
      return;
    }
    const token = revision;
    inspectTimer = window.setTimeout(async () => { if (await inspect(input.value, false, token)) track('tool_used', { tool: 'certificate-inspector', action: 'auto-inspect' }); }, 350);
  });
  document.getElementById('sample-btn')?.addEventListener('click', () => {
    input.value = sample;
    inspect().then(success => { if (success) track('tool_used', { tool: 'certificate-inspector', action: 'sample' }); });
  });
  document.getElementById('clear-btn')?.addEventListener('click', () => {
    input.value = '';
    identityInput.value = '';
    inspect();
    input.focus();
  });
  document.getElementById('paste-btn')?.addEventListener('click', async () => {
    try {
      input.value = await navigator.clipboard.readText();
      inspect();
    } catch {
      showToast('Paste permission was blocked. Use Ctrl/Command+V in the input box.', true);
      input.focus();
    }
  });
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (file) await openFile(file);
    fileInput.value = '';
  });
  for (const eventName of ['dragenter', 'dragover']) {
    dropZone.addEventListener(eventName, event => {
      event.preventDefault();
      dropZone.classList.add('ring-4', 'ring-indigo-200');
    });
  }
  for (const eventName of ['dragleave', 'drop']) {
    dropZone.addEventListener(eventName, event => {
      event.preventDefault();
      dropZone.classList.remove('ring-4', 'ring-indigo-200');
    });
  }
  dropZone.addEventListener('drop', async event => {
    const file = event.dataTransfer?.files?.[0];
    if (file) await openFile(file);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach(button => {
    button.addEventListener('click', () => copy(element(button.dataset.copyTarget || '').textContent || '', 'Fingerprint copied.'));
  });
  element('copy-sans').addEventListener('click', () => {
    const report = reports[selectedIndex]; if (report) copy(report.subjectAlternativeNames.map(name => name.value).join('\n'), 'Alternative names copied.');
  });
  document.getElementById('copy-pem')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) copy(codec!.certificatePem(report.certificate), 'PEM certificate copied.');
  });
  document.getElementById('download-pem')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) download(codec!.certificatePem(report.certificate), `${filename(report)}.pem`, 'application/x-pem-file;charset=utf-8');
  });
  document.getElementById('download-der')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) download(codec!.certificateDer(report.certificate), `${filename(report)}.cer`, 'application/pkix-cert');
  });
  document.getElementById('copy-base64')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) copy(codec!.certificateBase64(report.certificate), 'Base64 DER copied.');
  });
  document.getElementById('copy-hex')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) copy(codec!.certificateHex(report.certificate), 'Hex DER copied.');
  });
  document.getElementById('download-json')?.addEventListener('click', () => {
    const report = reports[selectedIndex];
    if (report) download(codec!.reportToJson(report), `${filename(report)}.json`, 'application/json;charset=utf-8');
  });
  document.getElementById('download-chain')?.addEventListener('click', () => {
    if (parsedInput) download(codec!.certificateChainPem(parsedInput.certificates), 'certificate-chain.pem', 'application/x-pem-file;charset=utf-8');
  });
  document.getElementById('download-p7b')?.addEventListener('click', () => {
    if (parsedInput) download(codec!.certificateBundleDer(parsedInput.certificates), 'certificate-bundle.p7b', 'application/pkcs7-mime');
  });
  document.getElementById('download-p7b-pem')?.addEventListener('click', () => {
    if (parsedInput) download(codec!.certificateBundlePem(parsedInput.certificates), 'certificate-bundle.p7b.pem', 'application/x-pem-file;charset=utf-8');
  });

  document.getElementById('live-csv')?.addEventListener('click', () => {
    if (reports.length) download(tableToDelimited(certificateReportRows(reports, chainAnalysis), ','), `tls-chain-${filename(reports[0])}.csv`, 'text/csv;charset=utf-8');
  });
  document.getElementById('live-xlsx')?.addEventListener('click', () => {
    if (!reports.length) return;
    const blob = createXlsxBlob(certificateReportRows(reports, chainAnalysis), { sheetName: 'TLS certificate chain' });
    download(blob, `tls-chain-${filename(reports[0])}.xlsx`, blob.type);
  });
  document.getElementById('live-json')?.addEventListener('click', () => {
    const identity = safeIdentity();
    const report = liveReportObject() || (reports.length ? { inspectedAt, identity, selectedCertificate: selectedIndex + 1, ...(identity ? { identityCheck: certificateMatchesIdentity(reports[selectedIndex], identity) } : {}), suppliedSignatures: chainAnalysis, certificates: reports.map(item => JSON.parse(codec!.reportToJson(item))) } : null);
    if (report) download(JSON.stringify(report, null, 2), `tls-report-${filename(reports[0])}.json`, 'application/json;charset=utf-8');
  });
  document.getElementById('live-copy')?.addEventListener('click', () => {
    if (reports.length) copy(tableToDelimited(certificateReportRows(reports, chainAnalysis), '\t'), 'Certificate chain table copied.');
  });
  document.getElementById('live-print')?.addEventListener('click', () => { track('export_used', { tool: 'certificate-inspector', format: 'pdf' }); window.print(); });

  ShareManager.register({
    tool: 'certificate-inspector',
    customCollect: () => liveTlsResult
      ? { mode: 'live', liveResult: tlsShareSnapshot(liveTlsResult) }
      : parsedInput && codec ? { mode: 'file', certificate: codec.certificateChainPem(parsedInput.certificates), identity: safeIdentity(), selectedIndex } : {},
    customRestore: data => {
      if (data.mode === 'live' && data.liveResult) {
        restoreLiveResult(data.liveResult);
      } else if (typeof data.certificate === 'string') {
        input.value = data.certificate.slice(0, 5 * 1024 * 1024);
        identityInput.value = typeof data.identity === 'string' ? data.identity.slice(0, 253) : '';
        inspect().then(success => { if (!success) return; if (Number.isInteger(data.selectedIndex) && data.selectedIndex >= 0 && data.selectedIndex < reports.length) { selectedIndex = data.selectedIndex; renderSelected(); } results.scrollIntoView({ block: 'start' }); });
      }
    },
  });
  if (input.value.trim()) inspect();
  document.addEventListener('astro:before-swap', () => { invalidate(); window.clearTimeout(toastTimer); }, { once: true });
  }
  initCertificateInspector();
  document.addEventListener('astro:after-swap', initCertificateInspector);
</script>

<style is:global>
  #certificate-workspace button:focus-visible,#certificate-workspace input:focus-visible,#certificate-workspace textarea:focus-visible,#certificate-workspace a:focus-visible,#certificate-workspace summary:focus-visible{outline:2px solid #6366f1;outline-offset:3px}
  #certificate-workspace button:disabled{opacity:.5;cursor:not-allowed}
  #tls-cancel[hidden]{display:none}
  @media print{#certificate-workspace > :not(#results){display:none!important}#results button,#results a,#certificate-list{display:none!important}#certificate-workspace{max-width:none}#chain-overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}#chain-overview>button{display:block!important}#results{margin-top:0!important}#results>div>section:last-child{display:none!important}}
  .tls-port-chip,.certificate-export-button{padding:.38rem .6rem;border:1px solid rgb(203 213 225);border-radius:.45rem;background:white;color:rgb(71 85 105);font-size:.68rem;font-weight:600}.tls-port-chip:hover,.certificate-export-button:hover{border-color:rgb(129 140 248);color:rgb(79 70 229)}.dark .tls-port-chip,.dark .certificate-export-button{border-color:rgb(71 85 105);background:rgb(30 41 59);color:rgb(203 213 225)}@media print{#sidebar,body header,body footer,.share-trigger,#share-btn-floating,#feedback-btn,#tls-inspect-btn,.tls-port-chip,.certificate-export-button,#certificate-input,#file-drop,#paste-btn,#sample-btn,#clear-btn,#inspect-btn,#tls-error-box,#error-box{display:none!important}body>div{margin-left:0!important}main{padding:0!important}section{box-shadow:none!important;break-inside:avoid}.dark *{color:#111!important;background:white!important;border-color:#ddd!important}}
</style>

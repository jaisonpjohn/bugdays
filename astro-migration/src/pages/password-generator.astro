---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Password Generator - Strong & Secure"
  description="Generate strong, secure random passwords instantly. Customize length, include symbols, numbers, and mixed case. Free online password generator with entropy indicator."
  keywords="password generator, secure password, random password, strong password generator, generate password online, password creator, secure password generator"
  breadcrumb={[{ name: "Security Tools", href: "/security-tools" }, { name: "Password Generator" }]}
  toolId="password-generator"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">Password Generator</h1>

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Generated Password</label>
      <div class="flex gap-3">
        <input
          type="text"
          id="password-output"
          readonly
          class="flex-1 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-lg bg-gray-50 dark:bg-slate-900 focus:ring-2 focus:ring-indigo-500"
        />
        <button id="copy-btn" class="px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
        </button>
        <button id="regenerate-btn" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </button>
      </div>

      <!-- Strength Indicator -->
      <div class="mt-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm text-gray-600 dark:text-slate-300">Strength</span>
          <span id="strength-label" class="text-sm font-medium"></span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-slate-600 rounded-full h-2">
          <div id="strength-bar" class="h-2 rounded-full transition-all duration-300"></div>
        </div>
        <p id="entropy-text" class="text-xs text-gray-500 dark:text-slate-400 mt-1"></p>
      </div>
    </div>

    <!-- Options -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-3">Options</h3>

      <div class="space-y-4">
        <!-- Length -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm text-gray-600 dark:text-slate-300">Length</label>
            <span id="length-value" class="text-sm font-mono font-medium text-indigo-600">16</span>
          </div>
          <input
            type="range"
            id="length-slider"
            data-share-key="length"
            min="4"
            max="128"
            value="16"
            class="w-full h-2 bg-gray-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer"
          />
          <div class="flex justify-between text-xs text-gray-400 dark:text-slate-500 mt-1">
            <span>4</span>
            <span>128</span>
          </div>
        </div>

        <!-- Character Types -->
        <div class="grid md:grid-cols-2 gap-3">
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-uppercase" data-share-key="uppercase" checked class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-lowercase" data-share-key="lowercase" checked class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-numbers" data-share-key="numbers" checked class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-symbols" data-share-key="symbols" checked class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Symbols (!@#$%...)</span>
          </label>
        </div>

        <!-- Additional Options -->
        <div class="grid md:grid-cols-2 gap-3">
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-exclude-ambiguous" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Exclude ambiguous (0O1lI)</span>
          </label>
          <label class="flex items-center gap-2 p-2 bg-gray-50 dark:bg-slate-900 rounded-lg cursor-pointer hover:bg-gray-100 dark:bg-slate-700">
            <input type="checkbox" id="opt-exclude-similar" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm text-gray-700 dark:text-slate-200">Exclude similar ({}[]())</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Bulk Generator -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <h3 class="text-sm font-medium text-gray-700 dark:text-slate-200 mb-3">Bulk Generate</h3>
      <div class="flex gap-3 mb-3">
        <input
          type="number"
          id="bulk-count"
          min="1"
          max="100"
          value="5"
          class="w-24 p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm"
        />
        <button id="bulk-generate-btn" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors text-sm font-medium">
          Generate Multiple
        </button>
        <button id="copy-all-btn" class="px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors text-sm font-medium">
          Copy All
        </button>
      </div>
      <textarea
        id="bulk-output"
        readonly
        class="w-full h-32 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm bg-gray-50 dark:bg-slate-900 resize-none"
        placeholder="Bulk generated passwords will appear here..."
      ></textarea>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online Password Generator</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Generate strong, random passwords with customizable options. Uses cryptographically secure random number generation
        (Web Crypto API). Supports bulk generation and shows password strength/entropy. All processing happens in your browser.
      </p>
    </div>
  </div>
</Layout>

<style>
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    background: #4f46e5;
    border-radius: 50%;
    cursor: pointer;
  }
</style>

<script>
  import { ShareManager } from '../lib/share';

  const passwordOutput = document.getElementById('password-output') as HTMLInputElement;
  const lengthSlider = document.getElementById('length-slider') as HTMLInputElement;
  const lengthValue = document.getElementById('length-value');
  const strengthBar = document.getElementById('strength-bar');
  const strengthLabel = document.getElementById('strength-label');
  const entropyText = document.getElementById('entropy-text');
  const bulkOutput = document.getElementById('bulk-output') as HTMLTextAreaElement;
  const bulkCount = document.getElementById('bulk-count') as HTMLInputElement;

  ShareManager.register({
    tool: 'password-generator',
    afterLoad: () => {
      lengthValue!.textContent = lengthSlider.value;
      updatePassword();
    }
  });

  const charSets = {
    uppercase: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lowercase: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?'
  };

  const ambiguousChars = '0O1lI';
  const similarChars = '{}[]()';

  function getCharSet(): string {
    let chars = '';

    if ((document.getElementById('opt-uppercase') as HTMLInputElement).checked) {
      chars += charSets.uppercase;
    }
    if ((document.getElementById('opt-lowercase') as HTMLInputElement).checked) {
      chars += charSets.lowercase;
    }
    if ((document.getElementById('opt-numbers') as HTMLInputElement).checked) {
      chars += charSets.numbers;
    }
    if ((document.getElementById('opt-symbols') as HTMLInputElement).checked) {
      chars += charSets.symbols;
    }

    // Remove excluded characters
    if ((document.getElementById('opt-exclude-ambiguous') as HTMLInputElement).checked) {
      chars = chars.split('').filter(c => !ambiguousChars.includes(c)).join('');
    }
    if ((document.getElementById('opt-exclude-similar') as HTMLInputElement).checked) {
      chars = chars.split('').filter(c => !similarChars.includes(c)).join('');
    }

    return chars || charSets.lowercase; // Fallback to lowercase if nothing selected
  }

  function generatePassword(length: number): string {
    const chars = getCharSet();
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);

    let password = '';
    for (let i = 0; i < length; i++) {
      password += chars[array[i] % chars.length];
    }

    return password;
  }

  function calculateStrength(password: string): { score: number; label: string; color: string; entropy: number } {
    const charSet = getCharSet();
    const entropy = Math.log2(Math.pow(charSet.length, password.length));

    let score = 0;
    let label = '';
    let color = '';

    if (entropy < 28) {
      score = 20;
      label = 'Very Weak';
      color = '#ef4444';
    } else if (entropy < 36) {
      score = 40;
      label = 'Weak';
      color = '#f97316';
    } else if (entropy < 60) {
      score = 60;
      label = 'Fair';
      color = '#eab308';
    } else if (entropy < 128) {
      score = 80;
      label = 'Strong';
      color = '#22c55e';
    } else {
      score = 100;
      label = 'Very Strong';
      color = '#10b981';
    }

    return { score, label, color, entropy };
  }

  function updatePassword() {
    const length = parseInt(lengthSlider.value, 10);
    lengthValue.textContent = length.toString();

    const password = generatePassword(length);
    passwordOutput.value = password;

    const strength = calculateStrength(password);
    strengthBar.style.width = `${strength.score}%`;
    strengthBar.style.backgroundColor = strength.color;
    strengthLabel.textContent = strength.label;
    strengthLabel.style.color = strength.color;
    entropyText.textContent = `~${Math.round(strength.entropy)} bits of entropy`;
  }

  // Event listeners
  lengthSlider.addEventListener('input', () => {
    lengthValue.textContent = lengthSlider.value;
    updatePassword();
  });

  document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', updatePassword);
  });

  document.getElementById('regenerate-btn').addEventListener('click', updatePassword);

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(passwordOutput.value);
  });

  document.getElementById('bulk-generate-btn').addEventListener('click', () => {
    const count = Math.min(100, Math.max(1, parseInt(bulkCount.value, 10) || 5));
    const length = parseInt(lengthSlider.value, 10);
    const passwords: string[] = [];

    for (let i = 0; i < count; i++) {
      passwords.push(generatePassword(length));
    }

    bulkOutput.value = passwords.join('\n');
  });

  document.getElementById('copy-all-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(bulkOutput.value);
  });

  // Initialize
  updatePassword();
</script>

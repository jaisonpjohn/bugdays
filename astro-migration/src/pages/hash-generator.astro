---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Hash Generator - MD5, SHA-1, SHA-256, SHA-512"
  description="Generate cryptographic hashes instantly. Support for MD5, SHA-1, SHA-256, and SHA-512 algorithms. Free online hash generator for checksums and data integrity."
  keywords="hash generator, MD5 hash, SHA-256 hash, SHA-512, SHA-1, generate hash online, checksum calculator, cryptographic hash"
  breadcrumb={[{ name: "Security Tools", href: "/security-tools" }, { name: "Hash Generator" }]}
  toolId="hash-generator"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">Hash Generator</h1>

    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mb-4">
      <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Input Text</label>
      <textarea
        id="input"
        data-share-key="input"
        class="w-full h-32 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
        placeholder="Enter text to hash..."
      ></textarea>

      <div class="flex flex-wrap items-center gap-4 mt-3">
        <div class="flex items-center gap-2">
          <input type="checkbox" id="uppercase" data-share-key="uppercase" class="rounded border-gray-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500" />
          <label for="uppercase" class="text-sm text-gray-700 dark:text-slate-200">Uppercase</label>
        </div>
        <div class="flex items-center gap-2">
          <label class="text-sm text-gray-700 dark:text-slate-200">Encoding:</label>
          <select id="encoding" class="p-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            <option value="utf8">UTF-8</option>
            <option value="ascii">ASCII</option>
          </select>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mt-4">
        <button id="hash-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
          Generate Hashes
        </button>
        <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
          Clear
        </button>
      </div>
    </div>

    <div id="results" class="space-y-3">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">MD5</label>
          <button class="copy-btn text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded" data-target="md5-output">Copy</button>
        </div>
        <input id="md5-output" readonly class="w-full p-2 bg-gray-50 dark:bg-slate-900 rounded border border-gray-200 dark:border-slate-700 font-mono text-sm" />
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">SHA-1</label>
          <button class="copy-btn text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded" data-target="sha1-output">Copy</button>
        </div>
        <input id="sha1-output" readonly class="w-full p-2 bg-gray-50 dark:bg-slate-900 rounded border border-gray-200 dark:border-slate-700 font-mono text-sm" />
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">SHA-256</label>
          <button class="copy-btn text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded" data-target="sha256-output">Copy</button>
        </div>
        <input id="sha256-output" readonly class="w-full p-2 bg-gray-50 dark:bg-slate-900 rounded border border-gray-200 dark:border-slate-700 font-mono text-sm" />
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">SHA-384</label>
          <button class="copy-btn text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded" data-target="sha384-output">Copy</button>
        </div>
        <input id="sha384-output" readonly class="w-full p-2 bg-gray-50 dark:bg-slate-900 rounded border border-gray-200 dark:border-slate-700 font-mono text-sm break-all" />
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">SHA-512</label>
          <button class="copy-btn text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:bg-slate-600 rounded" data-target="sha512-output">Copy</button>
        </div>
        <input id="sha512-output" readonly class="w-full p-2 bg-gray-50 dark:bg-slate-900 rounded border border-gray-200 dark:border-slate-700 font-mono text-xs break-all" />
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online Hash Generator</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Generate cryptographic hashes using MD5, SHA-1, SHA-256, SHA-384, and SHA-512 algorithms.
        SHA algorithms use the native Web Crypto API for secure hashing. All processing happens in your browser.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { ShareManager } from '../lib/share';

  const input = document.getElementById('input') as HTMLTextAreaElement;
  const uppercaseCheck = document.getElementById('uppercase') as HTMLInputElement;

  ShareManager.register({
    tool: 'hash-generator',
    actions: {
      hash: () => document.getElementById('hash-btn')?.click(),
    },
    afterLoad: () => generateHashes()
  });

  // MD5 implementation (not in Web Crypto)
  function md5(string: string): string {
    function rotateLeft(value: number, shift: number): number {
      return (value << shift) | (value >>> (32 - shift));
    }

    function addUnsigned(x: number, y: number): number {
      const lsw = (x & 0xFFFF) + (y & 0xFFFF);
      const msw = (x >> 16) + (y >> 16) + (lsw >> 16);
      return (msw << 16) | (lsw & 0xFFFF);
    }

    function F(x: number, y: number, z: number): number { return (x & y) | (~x & z); }
    function G(x: number, y: number, z: number): number { return (x & z) | (y & ~z); }
    function H(x: number, y: number, z: number): number { return x ^ y ^ z; }
    function I(x: number, y: number, z: number): number { return y ^ (x | ~z); }

    function FF(a: number, b: number, c: number, d: number, x: number, s: number, t: number): number {
      return addUnsigned(rotateLeft(addUnsigned(addUnsigned(a, F(b, c, d)), addUnsigned(x, t)), s), b);
    }
    function GG(a: number, b: number, c: number, d: number, x: number, s: number, t: number): number {
      return addUnsigned(rotateLeft(addUnsigned(addUnsigned(a, G(b, c, d)), addUnsigned(x, t)), s), b);
    }
    function HH(a: number, b: number, c: number, d: number, x: number, s: number, t: number): number {
      return addUnsigned(rotateLeft(addUnsigned(addUnsigned(a, H(b, c, d)), addUnsigned(x, t)), s), b);
    }
    function II(a: number, b: number, c: number, d: number, x: number, s: number, t: number): number {
      return addUnsigned(rotateLeft(addUnsigned(addUnsigned(a, I(b, c, d)), addUnsigned(x, t)), s), b);
    }

    const bytes = new TextEncoder().encode(string);
    const bitLen = bytes.length * 8;

    // Padding
    const padLen = ((bytes.length + 8) >>> 6 << 6) + 64;
    const padded = new Uint8Array(padLen);
    padded.set(bytes);
    padded[bytes.length] = 0x80;

    // Length in bits (little-endian)
    const view = new DataView(padded.buffer);
    view.setUint32(padLen - 8, bitLen, true);

    let a = 0x67452301;
    let b = 0xEFCDAB89;
    let c = 0x98BADCFE;
    let d = 0x10325476;

    for (let i = 0; i < padLen; i += 64) {
      const w: number[] = [];
      for (let j = 0; j < 16; j++) {
        w[j] = view.getUint32(i + j * 4, true);
      }

      let aa = a, bb = b, cc = c, dd = d;

      a = FF(a, b, c, d, w[0], 7, 0xD76AA478); d = FF(d, a, b, c, w[1], 12, 0xE8C7B756);
      c = FF(c, d, a, b, w[2], 17, 0x242070DB); b = FF(b, c, d, a, w[3], 22, 0xC1BDCEEE);
      a = FF(a, b, c, d, w[4], 7, 0xF57C0FAF); d = FF(d, a, b, c, w[5], 12, 0x4787C62A);
      c = FF(c, d, a, b, w[6], 17, 0xA8304613); b = FF(b, c, d, a, w[7], 22, 0xFD469501);
      a = FF(a, b, c, d, w[8], 7, 0x698098D8); d = FF(d, a, b, c, w[9], 12, 0x8B44F7AF);
      c = FF(c, d, a, b, w[10], 17, 0xFFFF5BB1); b = FF(b, c, d, a, w[11], 22, 0x895CD7BE);
      a = FF(a, b, c, d, w[12], 7, 0x6B901122); d = FF(d, a, b, c, w[13], 12, 0xFD987193);
      c = FF(c, d, a, b, w[14], 17, 0xA679438E); b = FF(b, c, d, a, w[15], 22, 0x49B40821);

      a = GG(a, b, c, d, w[1], 5, 0xF61E2562); d = GG(d, a, b, c, w[6], 9, 0xC040B340);
      c = GG(c, d, a, b, w[11], 14, 0x265E5A51); b = GG(b, c, d, a, w[0], 20, 0xE9B6C7AA);
      a = GG(a, b, c, d, w[5], 5, 0xD62F105D); d = GG(d, a, b, c, w[10], 9, 0x02441453);
      c = GG(c, d, a, b, w[15], 14, 0xD8A1E681); b = GG(b, c, d, a, w[4], 20, 0xE7D3FBC8);
      a = GG(a, b, c, d, w[9], 5, 0x21E1CDE6); d = GG(d, a, b, c, w[14], 9, 0xC33707D6);
      c = GG(c, d, a, b, w[3], 14, 0xF4D50D87); b = GG(b, c, d, a, w[8], 20, 0x455A14ED);
      a = GG(a, b, c, d, w[13], 5, 0xA9E3E905); d = GG(d, a, b, c, w[2], 9, 0xFCEFA3F8);
      c = GG(c, d, a, b, w[7], 14, 0x676F02D9); b = GG(b, c, d, a, w[12], 20, 0x8D2A4C8A);

      a = HH(a, b, c, d, w[5], 4, 0xFFFA3942); d = HH(d, a, b, c, w[8], 11, 0x8771F681);
      c = HH(c, d, a, b, w[11], 16, 0x6D9D6122); b = HH(b, c, d, a, w[14], 23, 0xFDE5380C);
      a = HH(a, b, c, d, w[1], 4, 0xA4BEEA44); d = HH(d, a, b, c, w[4], 11, 0x4BDECFA9);
      c = HH(c, d, a, b, w[7], 16, 0xF6BB4B60); b = HH(b, c, d, a, w[10], 23, 0xBEBFBC70);
      a = HH(a, b, c, d, w[13], 4, 0x289B7EC6); d = HH(d, a, b, c, w[0], 11, 0xEAA127FA);
      c = HH(c, d, a, b, w[3], 16, 0xD4EF3085); b = HH(b, c, d, a, w[6], 23, 0x04881D05);
      a = HH(a, b, c, d, w[9], 4, 0xD9D4D039); d = HH(d, a, b, c, w[12], 11, 0xE6DB99E5);
      c = HH(c, d, a, b, w[15], 16, 0x1FA27CF8); b = HH(b, c, d, a, w[2], 23, 0xC4AC5665);

      a = II(a, b, c, d, w[0], 6, 0xF4292244); d = II(d, a, b, c, w[7], 10, 0x432AFF97);
      c = II(c, d, a, b, w[14], 15, 0xAB9423A7); b = II(b, c, d, a, w[5], 21, 0xFC93A039);
      a = II(a, b, c, d, w[12], 6, 0x655B59C3); d = II(d, a, b, c, w[3], 10, 0x8F0CCC92);
      c = II(c, d, a, b, w[10], 15, 0xFFEFF47D); b = II(b, c, d, a, w[1], 21, 0x85845DD1);
      a = II(a, b, c, d, w[8], 6, 0x6FA87E4F); d = II(d, a, b, c, w[15], 10, 0xFE2CE6E0);
      c = II(c, d, a, b, w[6], 15, 0xA3014314); b = II(b, c, d, a, w[13], 21, 0x4E0811A1);
      a = II(a, b, c, d, w[4], 6, 0xF7537E82); d = II(d, a, b, c, w[11], 10, 0xBD3AF235);
      c = II(c, d, a, b, w[2], 15, 0x2AD7D2BB); b = II(b, c, d, a, w[9], 21, 0xEB86D391);

      a = addUnsigned(a, aa); b = addUnsigned(b, bb);
      c = addUnsigned(c, cc); d = addUnsigned(d, dd);
    }

    function toHex(n: number): string {
      let hex = '';
      for (let i = 0; i < 4; i++) {
        hex += ((n >> (i * 8)) & 0xFF).toString(16).padStart(2, '0');
      }
      return hex;
    }

    return toHex(a) + toHex(b) + toHex(c) + toHex(d);
  }

  async function sha(algorithm: string, text: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(text);
    const hashBuffer = await crypto.subtle.digest(algorithm, data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function formatHash(hash: string): string {
    return uppercaseCheck.checked ? hash.toUpperCase() : hash.toLowerCase();
  }

  async function generateHashes() {
    const text = input.value;

    const md5Hash = formatHash(md5(text));
    const sha1Hash = formatHash(await sha('SHA-1', text));
    const sha256Hash = formatHash(await sha('SHA-256', text));
    const sha384Hash = formatHash(await sha('SHA-384', text));
    const sha512Hash = formatHash(await sha('SHA-512', text));

    (document.getElementById('md5-output') as HTMLInputElement).value = md5Hash;
    (document.getElementById('sha1-output') as HTMLInputElement).value = sha1Hash;
    (document.getElementById('sha256-output') as HTMLInputElement).value = sha256Hash;
    (document.getElementById('sha384-output') as HTMLInputElement).value = sha384Hash;
    (document.getElementById('sha512-output') as HTMLInputElement).value = sha512Hash;
  }

  document.getElementById('hash-btn').addEventListener('click', generateHashes);

  input.addEventListener('input', generateHashes);
  uppercaseCheck.addEventListener('change', generateHashes);

  document.getElementById('clear-btn').addEventListener('click', () => {
    input.value = '';
    (document.getElementById('md5-output') as HTMLInputElement).value = '';
    (document.getElementById('sha1-output') as HTMLInputElement).value = '';
    (document.getElementById('sha256-output') as HTMLInputElement).value = '';
    (document.getElementById('sha384-output') as HTMLInputElement).value = '';
    (document.getElementById('sha512-output') as HTMLInputElement).value = '';
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      const target = document.getElementById(targetId) as HTMLInputElement;
      navigator.clipboard.writeText(target.value);
    });
  });

  // Generate initial hashes for empty string
  generateHashes();
</script>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Image to Base64 Converter"
  description="Convert images to Base64 data URIs and Base64 strings back to images. Free online tool supporting PNG, JPG, GIF, and SVG formats. Perfect for embedding images in CSS and HTML."
  keywords="image to Base64, Base64 to image, image encoder, data URI generator, embed image in CSS, PNG to Base64, JPG to Base64, image Base64 converter"
  breadcrumb={[{ name: "Encoding Tools", href: "/encoding-tools" }, { name: "Image ↔ Base64" }]}
  toolId="image-base64"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-slate-100 mb-4">Image ↔ Base64 Converter</h1>

    <div class="grid md:grid-cols-2 gap-4">
      <!-- Image Upload Section -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Upload Image</label>
        <div
          id="drop-zone"
          class="border-2 border-dashed border-gray-300 dark:border-slate-600 rounded-lg p-8 text-center hover:border-indigo-400 transition-colors cursor-pointer"
        >
          <svg class="w-12 h-12 mx-auto text-gray-400 dark:text-slate-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
          <p class="text-gray-600 dark:text-slate-300 mb-2">Drag & drop image here or click to browse</p>
          <p class="text-sm text-gray-400 dark:text-slate-500">Supports PNG, JPG, GIF, SVG, WebP</p>
          <input type="file" id="file-input" accept="image/*" class="hidden" />
        </div>
        <div id="image-preview-container" class="hidden mt-4">
          <img id="image-preview" class="max-w-full h-auto rounded-lg border border-gray-200 dark:border-slate-700" />
          <p id="image-info" class="text-sm text-gray-500 dark:text-slate-400 mt-2"></p>
        </div>
      </div>

      <!-- Base64 Input Section -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200 mb-2">Base64 String</label>
        <textarea
          id="base64-input"
          data-share-key="base64"
          class="w-full h-48 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-xs focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
          placeholder="Paste Base64 string here to preview image..."
        ></textarea>
        <div id="base64-preview-container" class="hidden mt-4">
          <img id="base64-preview" class="max-w-full h-auto rounded-lg border border-gray-200 dark:border-slate-700" />
        </div>
      </div>
    </div>

    <div id="error-box" class="hidden mt-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>

    <!-- Output Section -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4 mt-4">
      <div class="flex items-center justify-between mb-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-200">Output</label>
        <div class="flex gap-2">
          <label class="inline-flex items-center">
            <input type="radio" name="output-format" value="dataurl" checked class="text-indigo-600 focus:ring-indigo-500" />
            <span class="ml-1 text-sm text-gray-700 dark:text-slate-200">Data URL</span>
          </label>
          <label class="inline-flex items-center">
            <input type="radio" name="output-format" value="raw" class="text-indigo-600 focus:ring-indigo-500" />
            <span class="ml-1 text-sm text-gray-700 dark:text-slate-200">Raw Base64</span>
          </label>
        </div>
      </div>
      <textarea
        id="output"
        readonly
        class="w-full h-32 p-3 border border-gray-300 dark:border-slate-600 rounded-lg font-mono text-xs bg-gray-50 dark:bg-slate-900 resize-none"
        placeholder="Base64 output will appear here..."
      ></textarea>
    </div>

    <div class="flex flex-wrap gap-3 mt-4">
      <button id="copy-dataurl-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Copy Data URL
      </button>
      <button id="copy-raw-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Copy Raw Base64
      </button>
      <button id="copy-img-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
        Copy as &lt;img&gt; tag
      </button>
      <button id="preview-base64-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Preview Base64
      </button>
      <button id="clear-btn" class="px-6 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-200 rounded-lg hover:bg-gray-300 transition-colors font-medium">
        Clear
      </button>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-slate-100 mb-2">Free Online Image to Base64 Converter</h2>
      <p class="text-gray-600 dark:text-slate-300">
        Convert images to Base64 encoded strings and vice versa. Upload an image file or drag and drop to encode it as Base64.
        Paste a Base64 string to preview the image. Supports PNG, JPG, GIF, SVG, and WebP formats.
        Copy the result as a data URL, raw Base64, or HTML img tag.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { ShareManager } from '../lib/share';

  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone');
  const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
  const imagePreviewContainer = document.getElementById('image-preview-container');
  const imageInfo = document.getElementById('image-info');
  const base64Input = document.getElementById('base64-input') as HTMLTextAreaElement;
  const base64Preview = document.getElementById('base64-preview') as HTMLImageElement;
  const base64PreviewContainer = document.getElementById('base64-preview-container');
  const output = document.getElementById('output') as HTMLTextAreaElement;
  const errorBox = document.getElementById('error-box');

  let currentDataUrl = '';
  let currentMimeType = '';

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function hideError() {
    errorBox.classList.add('hidden');
  }

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function updateOutput() {
    if (!currentDataUrl) return;
    const format = (document.querySelector('input[name="output-format"]:checked') as HTMLInputElement).value;
    if (format === 'dataurl') {
      output.value = currentDataUrl;
    } else {
      // Extract raw base64 from data URL
      const base64 = currentDataUrl.split(',')[1] || '';
      output.value = base64;
    }
  }

  function processFile(file: File) {
    if (!file.type.startsWith('image/')) {
      showError('Please select an image file');
      return;
    }

    hideError();
    currentMimeType = file.type;

    const reader = new FileReader();
    reader.onload = (e) => {
      const result = e.target?.result as string;
      currentDataUrl = result;

      // Show preview
      imagePreview.src = result;
      imagePreviewContainer.classList.remove('hidden');
      imageInfo.textContent = `${file.name} - ${formatBytes(file.size)} - ${file.type}`;

      updateOutput();
    };
    reader.onerror = () => {
      showError('Error reading file');
    };
    reader.readAsDataURL(file);
  }

  // File input change
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) processFile(file);
  });

  // Click on drop zone
  dropZone.addEventListener('click', () => {
    fileInput.click();
  });

  // Drag and drop
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-indigo-500', 'bg-indigo-50');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-indigo-500', 'bg-indigo-50');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-indigo-500', 'bg-indigo-50');
    const file = e.dataTransfer?.files[0];
    if (file) processFile(file);
  });

  // Output format change
  document.querySelectorAll('input[name="output-format"]').forEach(radio => {
    radio.addEventListener('change', updateOutput);
  });

  // Preview Base64 input
  document.getElementById('preview-base64-btn').addEventListener('click', () => {
    let base64 = base64Input.value.trim();
    if (!base64) {
      showError('Please enter a Base64 string');
      return;
    }

    hideError();

    // Check if it's already a data URL
    if (!base64.startsWith('data:')) {
      // Try to detect image type or default to PNG
      let mimeType = 'image/png';
      if (base64.startsWith('/9j/')) mimeType = 'image/jpeg';
      else if (base64.startsWith('R0lGOD')) mimeType = 'image/gif';
      else if (base64.startsWith('UklGR')) mimeType = 'image/webp';
      else if (base64.startsWith('PHN2Zw')) mimeType = 'image/svg+xml';
      base64 = `data:${mimeType};base64,${base64}`;
    }

    base64Preview.src = base64;
    base64Preview.onload = () => {
      base64PreviewContainer.classList.remove('hidden');
    };
    base64Preview.onerror = () => {
      showError('Invalid Base64 image data');
      base64PreviewContainer.classList.add('hidden');
    };
  });

  // Copy buttons
  document.getElementById('copy-dataurl-btn').addEventListener('click', () => {
    if (currentDataUrl) {
      navigator.clipboard.writeText(currentDataUrl);
    }
  });

  document.getElementById('copy-raw-btn').addEventListener('click', () => {
    if (currentDataUrl) {
      const base64 = currentDataUrl.split(',')[1] || '';
      navigator.clipboard.writeText(base64);
    }
  });

  document.getElementById('copy-img-btn').addEventListener('click', () => {
    if (currentDataUrl) {
      const imgTag = `<img src="${currentDataUrl}" alt="Base64 encoded image" />`;
      navigator.clipboard.writeText(imgTag);
    }
  });

  // Clear
  document.getElementById('clear-btn').addEventListener('click', () => {
    fileInput.value = '';
    imagePreviewContainer.classList.add('hidden');
    base64Input.value = '';
    base64PreviewContainer.classList.add('hidden');
    output.value = '';
    currentDataUrl = '';
    currentMimeType = '';
    hideError();
  });

  ShareManager.register({
    tool: 'image-base64',
    afterLoad: () => {
      if (base64Input.value.trim()) {
        document.getElementById('preview-base64-btn')!.click();
      }
    }
  });
</script>

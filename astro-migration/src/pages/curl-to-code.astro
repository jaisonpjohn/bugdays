---
import Layout from '../layouts/Layout.astro';

const faqs = [
  ['Which cURL options are supported?', 'The converter handles common request method, URL, header, data, basic-auth, and GET-query options. It ignores display and transport flags such as --silent or --location.'],
  ['Does this execute the cURL command?', 'No. It only parses the text in your browser and generates equivalent code. It never sends the request or connects to the target URL.'],
  ['Can I use generated code with an API client?', 'Yes. Copy a scrubbed URL, headers, and body into the REST API Client when you want to run a request. The converter itself remains offline.'],
  ['Can I share a cURL command?', 'Only share a small scrubbed example. Headers, query strings, and bodies often contain credentials or private data, and anyone with the link can read included text.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'cURL to JavaScript Fetch and Python Requests Converter', url: 'https://bugdays.com/curl-to-code/', description: 'Convert common cURL commands to JavaScript fetch, Python requests, or normalized cURL locally in the browser without executing a network request.', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['cURL to JavaScript fetch', 'cURL to Python requests', 'Normalized cURL output', 'Headers, method, body, and basic auth parsing', 'Copy and download', 'Shareable scrubbed examples'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---

<Layout title="cURL to JavaScript Fetch & Python Requests Converter" description="Convert common cURL commands to JavaScript fetch, Python requests, or normalized cURL locally in your browser. Parse method, headers, body, and basic auth without running the request; copy, download, or share a safe example." keywords="cURL to JavaScript, cURL to fetch, cURL to Python requests, cURL converter, convert cURL command, cURL code generator, cURL to code online" breadcrumb={[{ name: 'Network Tools', href: '/network-tools/' }, { name: 'cURL to Code' }]} toolId="curl-to-code" jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-1">cURL to JavaScript Fetch &amp; Python Requests</h1>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Convert a common cURL command into code locally—without sending the request. Copy, download, or share a scrubbed reproducer.</p>
    <div class="grid gap-4 lg:grid-cols-2"><section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800"><label for="curl-input" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">cURL command</label><textarea id="curl-input" data-share-key="curl" class="h-80 w-full resize-none rounded-lg border border-slate-300 p-3 font-mono text-sm text-slate-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="curl -X POST 'https://api.example.test/orders' \\\n  -H 'Content-Type: application/json' \\\n  --data-raw '{\"status\":\"paid\"}'" spellcheck="false"></textarea><p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Parsing happens in this browser. The command is not executed.</p></section><section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="mb-2 flex items-center justify-between gap-3"><label for="code-output" class="text-sm font-semibold text-slate-700 dark:text-slate-200">Generated <span id="target-label">JavaScript Fetch</span></label><button id="copy-btn" type="button" class="text-xs font-semibold text-indigo-600 hover:underline dark:text-indigo-300">Copy output</button></div><textarea id="code-output" readonly class="h-80 w-full resize-none rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" placeholder="Generated code appears here…" spellcheck="false"></textarea><p id="request-summary" class="mt-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p></section></div>
    <div class="mt-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="flex flex-wrap items-end gap-4"><label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Target<select id="target" data-share-key="target" class="mt-1 block rounded-lg border border-slate-300 bg-white p-2 text-sm dark:border-slate-600 dark:bg-slate-900"><option value="fetch">JavaScript Fetch</option><option value="python">Python requests</option><option value="curl">Normalized cURL</option></select></label><button id="convert-btn" data-share-action="convert" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Convert command</button><button id="download-btn" type="button" class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-100 dark:hover:bg-slate-600">Download</button><button id="share-curl-btn" type="button" class="rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700">Share example ↗</button><button id="sample-btn" type="button" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Load sample</button></div></div>
    <div id="error-box" role="alert" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200"></div>
    <div class="mt-7 grid gap-4 md:grid-cols-3 text-sm"><a href="/api-client/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Run an HTTP request</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Use the REST API Client when you are ready to send a request.</span></a><a href="/json-formatter/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Inspect a JSON response</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Format, validate, search, and share a response body.</span></a><a href="/soap-client/" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><strong class="text-slate-900 dark:text-white">Test a SOAP service</strong><span class="mt-1 block text-slate-600 dark:text-slate-300">Generate a request from a WSDL and inspect its XML response.</span></a></div>
    <section class="mt-8 max-w-4xl space-y-5 text-sm leading-7 text-slate-600 dark:text-slate-300"><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Convert a cURL command without running it</h2><p class="mt-2">Copy a cURL command from terminal output, browser developer tools, documentation, or a ticket. This page parses its common request pieces locally: URL, method, headers, request body, and basic authentication. It deliberately does not execute the request, so converting code never triggers a mutation or sends credentials to an endpoint.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Use generated code as a reviewed starting point</h2><p class="mt-2">Choose JavaScript Fetch for browser or Node-style code, Python requests for a Python service or script, or normalized cURL to make a command easier to read. Generated code preserves the raw request body. Add retries, timeouts, response parsing, typed validation, and application-specific error handling before using it in production. Follow the <a href="/guides/convert-curl-to-javascript-fetch-python-requests/" class="text-indigo-600 underline dark:text-indigo-400">cURL conversion guide</a> for a worked request and safe review checklist.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">Share only scrubbed commands</h2><p class="mt-2">The Share example action is intentionally obvious because a reproducible command helps support and code review. cURL commands commonly embed Bearer tokens, cookies, private hosts, user names, passwords, and customer values. Anybody with the link can read included text, so replace secrets with placeholders before sharing.</p></div><div><h2 class="text-xl font-bold text-slate-900 dark:text-white">cURL converter questions</h2><div class="mt-3 space-y-2">{faqs.map(([question, answer]) => <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><summary class="cursor-pointer font-semibold text-slate-800 dark:text-slate-100">{question}</summary><p class="mt-2">{answer}</p></details>)}</div></div></section>
  </div>
</Layout>

<script>
  import { track } from '../lib/analytics.ts';
  import { generateCurlCode, parseCurl, type CurlTarget } from '../lib/curl-to-code.ts';
  import { ShareManager } from '../lib/share.ts';
  const input = document.getElementById('curl-input') as HTMLTextAreaElement;
  const output = document.getElementById('code-output') as HTMLTextAreaElement;
  const target = document.getElementById('target') as HTMLSelectElement;
  const errorBox = document.getElementById('error-box')!;
  const targetLabel = document.getElementById('target-label')!;
  const summary = document.getElementById('request-summary')!;
  const sample = "curl -X POST 'https://api.example.test/orders' \\\n  -H 'Content-Type: application/json' \\\n  -H 'X-Request-Id: demo-123' \\\n  --data-raw '{\"status\":\"paid\"}'";
  ShareManager.register({ tool: 'curl-to-code', actions: { convert: () => document.getElementById('convert-btn')?.click() } });
  document.getElementById('share-curl-btn')!.addEventListener('click', () => document.getElementById('share-btn')?.click());
  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function hideError() { errorBox.classList.add('hidden'); }
  function updateTargetLabel() { targetLabel.textContent = target.options[target.selectedIndex].text; }
  function convert() { if (!input.value.trim()) return showError('Paste a cURL command first.'); try { const request = parseCurl(input.value); output.value = generateCurlCode(request, target.value as CurlTarget); summary.textContent = `${request.method} · ${request.headers.length} header${request.headers.length === 1 ? '' : 's'} · ${request.body === undefined ? 'no request body' : `${request.body.length} body characters`} · not executed`; hideError(); updateTargetLabel(); } catch (error) { showError(error instanceof Error ? error.message : 'Could not parse that cURL command.'); } }
  document.getElementById('convert-btn')!.addEventListener('click', convert);
  target.addEventListener('change', () => { updateTargetLabel(); if (input.value.trim()) convert(); });
  document.getElementById('sample-btn')!.addEventListener('click', () => { input.value = sample; convert(); });
  document.getElementById('copy-btn')!.addEventListener('click', () => { if (output.value) navigator.clipboard?.writeText(output.value).catch(() => showError('Your browser blocked clipboard access. Select the output and copy it manually.')); });
  document.getElementById('download-btn')!.addEventListener('click', () => { if (!output.value) return; const extension = target.value === 'python' ? 'py' : target.value === 'fetch' ? 'js' : 'sh'; track('export_used', { tool: 'curl-to-code', format: extension }); const href = URL.createObjectURL(new Blob([output.value], { type: 'text/plain;charset=utf-8' })); const link = document.createElement('a'); link.href = href; link.download = `converted-request.${extension}`; link.click(); URL.revokeObjectURL(href); });
  updateTargetLabel();
</script>
